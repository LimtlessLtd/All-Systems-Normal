<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    The station console shared by both runtimes: the Blazor Server host
    (Ollama minds) and the static WebAssembly build published to GitHub Pages.
    Pages talk to the abstract StationSession, so neither host keeps its own
    copy of the UI.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Overseer.Domain/Overseer.Domain.csproj" />
    <ProjectReference Include="../Overseer.Simulation/Overseer.Simulation.csproj" />
    <ProjectReference Include="../Overseer.Persistence/Overseer.Persistence.csproj" />
  </ItemGroup>

</Project>
