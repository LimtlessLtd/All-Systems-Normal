@page "/debug"
@inject StationSession Session

<PageTitle>All Systems Normal · Debug Telemetry</PageTitle>

<div class="debug-shell">
    <header class="debug-header">
        <div>
            <span class="overline">DEVELOPER DIAGNOSTICS // NON-GAMEPLAY</span>
            <h1>COGNITION TELEMETRY</h1>
            <p>This screen is intentionally separate from the station workspace and contains no player-critical controls.</p>
        </div>
        <a class="debug-return" href="">RETURN TO STATION</a>
    </header>

    @if (!DebugTelemetrySystem.UiEnabled)
    {
        <section class="debug-panel">
            <h2>DEBUG UI DISABLED</h2>
            <p>Telemetry capture does not affect simulation state.</p>
        </section>
    }
    else
    {
        var snapshot = DebugTelemetrySystem.Capture(Session.State);
        var runtime = Session.AiRuntimeDiagnostics;
        var ollamaTraces = snapshot.Cognition
            .Where(trace => trace.Source.Equals("Ollama", StringComparison.OrdinalIgnoreCase))
            .Take(50)
            .ToList();

        <section class="debug-summary">
            <div><span>AI RUNTIME</span><strong>@runtime.Mode</strong></div>
            <div><span>PROVIDER REQUESTS</span><strong>@runtime.ProviderRequestsStarted</strong></div>
            <div><span>NPC MODEL REQUESTS</span><strong>@runtime.NpcDecisionRequestsStarted</strong></div>
            <div><span>MIND TRACES</span><strong>@snapshot.Cognition.Count</strong></div>
            <div><span>OLLAMA DECISION TRACES</span><strong>@ollamaTraces.Count</strong></div>
            <div><span>EVENTS</span><strong>@snapshot.Events.Count</strong></div>
            <div><span>MISSION</span><strong>T+@Session.State.Elapsed.ToString(@"hh\:mm")</strong></div>
            <div><span>MODE</span><strong>@(DebugTelemetrySystem.IsGameplayCritical ? "GAMEPLAY" : "DEBUG ONLY")</strong></div>
        </section>

        <section class="debug-panel ollama-io-panel">
            <div class="ollama-io-heading">
                <div>
                    <span class="overline">LOCAL MODEL DIAGNOSTICS</span>
                    <h2>OLLAMA LLM INPUT / OUTPUT</h2>
                </div>
                <span class="ollama-io-count">@ollamaTraces.Count captured</span>
            </div>
            <p class="ollama-io-help">
                Shows the exact request trace sent through <code>IChatClient</code> (options + prompt)
                beside the raw provider response. Newest completed Ollama decision first.
            </p>

            @if (runtime.Mode == "Ollama server")
            {
                <article class="debug-entry ollama-runtime-status" data-ollama-runtime="server">
                    <header>
                        <strong>OLLAMA PROVIDER STATUS</strong>
                        <span>@runtime.ProviderResponsesReceived response(s) · @runtime.ProviderFailures failure(s)</span>
                    </header>
                    <p>
                        <strong>Endpoint:</strong> @(runtime.Endpoint ?? "unknown")
                        · <strong>Model:</strong> @(runtime.Model ?? "unknown")
                        · <strong>Last operation:</strong> @(runtime.LastOperation ?? "none")
                    </p>
                    @if (!string.IsNullOrWhiteSpace(runtime.LastError))
                    {
                        <p class="debug-note">
                            <strong>LAST PROVIDER ERROR:</strong> @runtime.LastError
                        </p>
                    }
                    @if (runtime.NpcDecisionRequestsStarted > 0 && ollamaTraces.Count == 0)
                    {
                        <p class="debug-note">
                            The server has entered the Ollama NPC-decision boundary
                            @runtime.NpcDecisionRequestsStarted time(s), but this station session has no completed
                            Ollama decision trace. Provider counters are process-wide so this remains visible even
                            after a debug-page reload/new circuit; exact prompts and responses remain private to
                            the station session that produced them.
                        </p>
                    }
                    else if (runtime.NpcDecisionRequestsStarted == 0
                             && Session.State.Elapsed >= TimeSpan.FromMinutes(4))
                    {
                        <p class="debug-note">
                            <strong>COGNITION DISPATCH FAILURE:</strong> this server session has passed T+00:04
                            without entering the Ollama NPC-decision boundary.
                        </p>
                    }
                </article>
            }

            @if (ollamaTraces.Count == 0)
            {
                <p class="debug-empty ollama-empty">
                    No Ollama calls are recorded in this session. The static Pages build uses the
                    deterministic browser mind and therefore has no Ollama traffic; run the server
                    with Ollama configured and open DEBUG from that same station session.
                </p>
            }
            else
            {
                @foreach (var trace in ollamaTraces)
                {
                    <article class="debug-entry ollama-io-entry" data-ollama-sequence="@trace.Sequence">
                        <header>
                            <strong>#@trace.Sequence · T+@trace.CreatedAt.ToString(@"hh\:mm") · @trace.NpcName</strong>
                            <span>@(trace.Action?.ToString() ?? "REJECTED/FALLBACK")</span>
                        </header>
                        <div class="ollama-io-grid">
                            <section>
                                <h3>INPUT // EXACT REQUEST SENT TO OLLAMA</h3>
                                <pre>@(trace.Prompt ?? "No request payload was captured for this call.")</pre>
                            </section>
                            <section>
                                <h3>OUTPUT // RAW OLLAMA RESPONSE</h3>
                                <pre>@(trace.RawResponse ?? "No raw response was returned before this call failed or fell back.")</pre>
                            </section>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(trace.Note))
                        {
                            <p class="debug-note">@trace.Note</p>
                        }
                    </article>
                }
            }
        </section>

        <div class="debug-grid">
            <section class="debug-panel">
                <h2>VALIDATED COGNITION</h2>
                @if (snapshot.Cognition.Count == 0)
                {
                    <p class="debug-empty">No cognition calls recorded yet.</p>
                }
                else
                {
                    @foreach (var trace in snapshot.Cognition.Take(100))
                    {
                        <article class="debug-entry" data-cognition-sequence="@trace.Sequence">
                            <header>
                                <strong>#@trace.Sequence · T+@trace.CreatedAt.ToString(@"hh\:mm") · @trace.NpcName</strong>
                                <span>@trace.Source</span>
                            </header>
                            <p>
                                <b>@(trace.Action?.ToString() ?? "REJECTED")</b>
                                @if (!string.IsNullOrWhiteSpace(trace.TargetId))
                                {
                                    <text> → @trace.TargetId</text>
                                }
                                @if (trace.Urgency is { } urgency)
                                {
                                    <text> · urgency @urgency/100</text>
                                }
                            </p>
                            @if (!string.IsNullOrWhiteSpace(trace.Goal))
                            {
                                <p><strong>Goal:</strong> @trace.Goal</p>
                            }
                            @if (!string.IsNullOrWhiteSpace(trace.Reason))
                            {
                                <p><strong>Reason:</strong> @trace.Reason</p>
                            }
                            @if (!string.IsNullOrWhiteSpace(trace.Note))
                            {
                                <p class="debug-note">@trace.Note</p>
                            }
                            @if (!string.IsNullOrWhiteSpace(trace.Prompt))
                            {
                                <details>
                                    <summary>LLM REQUEST // EXACT PROMPT + OPTIONS</summary>
                                    <pre>@trace.Prompt</pre>
                                </details>
                            }
                            @if (!string.IsNullOrWhiteSpace(trace.RawResponse))
                            {
                                <details>
                                    <summary>LLM RESPONSE // RAW PROVIDER OUTPUT</summary>
                                    <pre>@trace.RawResponse</pre>
                                </details>
                            }
                        </article>
                    }
                }
            </section>

            <aside>
                <section class="debug-panel">
                    <h2>GENERATOR DIAGNOSTICS</h2>
                    @if (snapshot.GenerationDiagnostics.Count == 0)
                    {
                        <p class="debug-empty">No generator diagnostics.</p>
                    }
                    else
                    {
                        @foreach (var diagnostic in snapshot.GenerationDiagnostics)
                        {
                            <p class="debug-log">@diagnostic</p>
                        }
                    }
                </section>

                <section class="debug-panel">
                    <h2>SIMULATION EVENTS</h2>
                    @foreach (var entry in snapshot.Events.Take(160))
                    {
                        <p class="debug-log">@entry</p>
                    }
                </section>
            </aside>
        </div>
    }
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        await Session.InitializeAsync();
    }
}
