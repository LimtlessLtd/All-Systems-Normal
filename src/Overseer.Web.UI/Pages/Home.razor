    // Authored as Razor markup, not RenderTreeBuilder calls: only markup gets
    // the component's scoped-CSS attribute, so hand-built elements silently
    // ignored every .metric rule in Home.razor.css.
    private static RenderFragment Metric(string label, double value)
    {
        var safeValue = Math.Clamp(value, 0, 100);

        return @<div class="metric">
            <div>
                <span>@label</span>
                <strong>@safeValue.ToString("0")</strong>
            </div>
            <progress max="100" value="@safeValue"></progress>
        </div>;
    }

    private static string RoomHealthClass(Room room) =>
        !room.IsPowered
        || room.HasHullBreach
        || room.HullIntegrityPercent < 25
        || room.ReportedOxygenPercent < 17
        || room.CarbonDioxidePercent > 3
        || room.PressureKpa < 80
        || room.ReportedTemperatureC is < 5 or > 38
            ? "critical"
        : !room.CameraOnline
          || room.HullIntegrityPercent < 70
          || room.ReportedOxygenPercent < 19.5
          || room.CarbonDioxidePercent > 1
          || room.PressureKpa < 90
          || room.ReportedTemperatureC is < 16 or > 28
            ? "warning"
        : "healthy";

    private static string PowerStatusClass(Room room) =>
        room.IsPowered ? "good" : "bad";

    private static string TemperatureStatusClass(Room room) =>
        room.ReportedTemperatureC is < 8 or > 35
            ? "bad"
            : room.ReportedTemperatureC is < 16 or > 28
                ? "warn"
                : "good";

    private static string OxygenStatusClass(Room room) =>
        room.ReportedOxygenPercent < 17
            ? "bad"
            : room.ReportedOxygenPercent < 19.5
                ? "warn"
                : "good";

    private string RoomClass(Room room)
    {
        var classes = new List<string>
        {
            "room-node",
            $"room-type-{room.Type.ToString().ToLowerInvariant()}",
            StationPresentationSystem.RoomScaleClass(room)
        };

        if (room.HasExteriorHatch)
            classes.Add("exterior-module");

        if (room.Type == RoomType.Corridor)
        {
            if (room.Id.Equals("corridor", StringComparison.OrdinalIgnoreCase))
            {
                classes.Add("main-corridor");
            }
            else
            {
                classes.Add("hallway");
                var vertical = IsConnectorHallway(room)
                    ? IsVerticalHallway(room)
                    : room.MapHeight > room.MapWidth;
                classes.Add(vertical ? "hallway-vertical" : "hallway-horizontal");
            }
        }

        if (SelectedRoom?.Id == room.Id)
            classes.Add("selected");

        if (room.HasExteriorHatch && room.ExteriorHatchOpen)
            classes.Add("vacuum-open");

        if (!room.IsPowered)
            classes.Add("no-power");
        else if (!room.CameraOnline)
            classes.Add("camera-off");

        if (!room.LightsOn)
            classes.Add("lights-off");

        // Owner idea #23: flames are drawn only where a camera sees them; a
        // blind room keeps a marker for the fire it was last seen with.
        if (room.FireIntensity > 0 && room.HasVisualFeed)
        {
            classes.Add("has-fire");
            classes.Add(room.FireIntensity switch
            {
                >= 75 => "fire-inferno",
                >= 50 => "fire-severe",
                >= 25 => "fire-growing",
                _ => "fire-minor"
            });
        }

        else if (OverseerSightSystem.Fire(room) is { IsBurning: true, IsLive: false })
        {
            classes.Add("fire-last-seen");
        }

        if (room.SmokePercent >= 5)
        {
            classes.Add("has-smoke");
            classes.Add(room.SmokePercent switch
            {
                >= 80 => "smoke-blackout",
                >= 55 => "smoke-heavy",
                >= 25 => "smoke-building",
                _ => "smoke-light"
            });
        }

        return string.Join(' ', classes);
    }

