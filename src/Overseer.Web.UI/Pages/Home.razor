    /// <summary>
    /// Owner idea #82: animated machinery only moves and glows while it is
    /// actually running. Presentation reads authoritative state: a fixture
    /// wired to a device needs that device enabled and not failed, and
    /// anything that draws power also needs its compartment powered (load
    /// shedding clears <see cref="Room.IsPowered"/> too). Generators and the
    /// reactor are sources, so their own room's feed does not stop them.
    /// </summary>
    /// <summary>
    /// Owner idea #65: the room's authoritative machinery noise, graded so a
    /// level that disturbs sleep is called out.
    /// </summary>
    private string RoomNoiseLabel(Room room)
    {
        var level = StationNoiseSystem.RoomLevel(Session.State, room.Id);
        return StationNoiseSystem.IsDisturbing(level)
            ? $"LOUD {level:0}"
            : level > 0 ? $"{level:0}" : "QUIET";
