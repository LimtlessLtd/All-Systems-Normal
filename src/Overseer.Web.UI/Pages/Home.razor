    private string MachineFixtureClass(Room room, RoomFixture fixture)
    {
        var classes = FixtureIsRunning(room, fixture)
            ? FixtureClass(fixture)
            : $"{FixtureClass(fixture)} fixture-inert";

        if (fixture.Type == FixtureType.Bed && !BedIsLandscape(room, fixture))
            classes += " bed-portrait";

        return SeatFacingClass(room, fixture) is { } facing
            ? $"{classes} {facing}"
            : classes;
    }

    // The pillow end is the bed's left end when it lies across the map and its
    // top end otherwise; the bed art and the sleeper's body angle share this.
    private static bool BedIsLandscape(Room room, RoomFixture bed) =>
        bed.Width * room.MapWidth >= bed.Height * room.MapHeight;

    // Owner idea #105: seats are drawn with the backrest on the far side.
    private static string? SeatFacingClass(Room room, RoomFixture seat) =>
        SeatFacingRules.Facing(room, seat) is { } facing
            ? $"seat-faces-{facing.ToString().ToLowerInvariant()}"
            : null;

    private bool FixtureIsRunning(Room room, RoomFixture fixture)
    {
        if (fixture.DeviceId is { } deviceId
            && Session.State.Devices.TryGetValue(deviceId, out var device))
        {
            if (!device.IsOperational)
                return false;

            if (device.Kind is StationSystemKind.Reactor or StationSystemKind.PowerGenerator)
                return true;
        }

        return room.IsPowered;
    }

    private static string FixtureClass(RoomFixture fixture)
    {
        var classes = new List<string>
        {
            "fixture",
            $"fixture-{fixture.Type.ToString().ToLowerInvariant()}",
            $"fixture-use-{fixture.UsePose.ToString().ToLowerInvariant()}"
        };

        if (fixture.Label.StartsWith("Generated ", StringComparison.Ordinal))
            classes.Add("fixture-generated");

        if (fixture.Label.Contains("Security", StringComparison.OrdinalIgnoreCase)
            || fixture.Label.Contains("Hardline", StringComparison.OrdinalIgnoreCase))
            classes.Add("fixture-security");

        if (fixture.DeviceId is { Length: > 0 } deviceId)
        {
            classes.Add("fixture-interactive");
            var separator = deviceId.IndexOf(':');
            var family = separator > 0 ? deviceId[..separator] : deviceId;
            classes.Add($"fixture-system-{family.Replace('_', '-')}");
        }

        return string.Join(' ', classes);
    }

