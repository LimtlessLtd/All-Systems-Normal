    // Owner idea #96: a sleeper who is authoritatively asleep in their
    // assigned bed (BedUseRules) is drawn lying on that bed, not standing at
    // the bedside point they walked to.
    private double CrewMapX(Npc npc)
    {
        var room = Session.State.Facility.Rooms[npc.CurrentRoomId];
        var x = BedUseRules.BedAsleepIn(Session.State, npc)?.X ?? npc.PositionX;
        return room.MapX + (((x - 50) / 100) * room.MapWidth);
    }

    private double CrewMapY(Npc npc)
    {
        var room = Session.State.Facility.Rooms[npc.CurrentRoomId];
        var y = BedUseRules.BedAsleepIn(Session.State, npc)?.Y ?? npc.PositionY;
        return room.MapY + (((y - 50) / 100) * room.MapHeight);
    }

    /// <summary>
    /// Body angle for a sleeper lying in a bed: along the bed's long side,
    /// with the head at the pillow end (the bed art's left or top end).
    /// </summary>
    private double SleeperBedAngle(Npc npc, RoomFixture bed)
    {
        var room = Session.State.Facility.Rooms[npc.CurrentRoomId];
        return BedIsLandscape(room, bed) ? -90 : 0;
    }

    private static RoutePoint LocalRoutePoint(
        Room room,
        (double X, double Y) local) =>
        new(
            room.MapX + (((local.X - 50) / 100) * room.MapWidth),
            room.MapY + (((local.Y - 50) / 100) * room.MapHeight));

    private RoutePoint CrewNextMapPoint(Npc npc)
    {
        var room = Session.State.Facility.Rooms[npc.CurrentRoomId];
        var preview = LocalMovementSystem.PreviewDoorRoute(
            Session.State,
            npc,
            TimeSpan.FromMinutes(1),
            maxSteps: 1);
        var local = preview.Count > 0
            ? preview[0]
            : (npc.PositionX, npc.PositionY);

        return LocalRoutePoint(room, local);
    }

    /// <summary>
    /// Owner idea #86: the human body always stands upright (the pose
    /// animations' <c>--crew-facing</c> stays 0deg) and faces left or right
    /// by mirroring (<c>--crew-flip</c>); the exact authoritative heading is
    /// shown by a separate ground cue (<c>--crew-heading</c>).
    /// </summary>
    private string CrewStyle(Npc npc)
    {
        var heading = CrewFacingAngle(npc);
        var flip = Math.Cos(npc.FacingDegrees * Math.PI / 180) < -0.01 ? -1 : 1;
        var bedAngle = BedUseRules.BedAsleepIn(Session.State, npc) is { } bed
            ? FormattableString.Invariant($"--crew-bed-angle:{SleeperBedAngle(npc, bed):0.##}deg;")
            : string.Empty;

        return FormattableString.Invariant(
            $"left:{CrewMapX(npc)}%;top:{CrewMapY(npc)}%;--crew-facing:0deg;--crew-flip:{flip};--crew-heading:{heading:0.##}deg;{bedAngle}");
    }

