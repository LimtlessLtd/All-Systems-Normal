        CropBedForFixture(room, fixture)?.Lifecycle switch
        {
            CropLifecycleState.Empty => "empty",
            CropLifecycleState.Planting => "planting",
            CropLifecycleState.Seedling => "seedling",
            CropLifecycleState.Maturing => "maturing",
            CropLifecycleState.ReadyToHarvest => "harvest-ready",
            CropLifecycleState.Harvesting => "harvesting",
            CropLifecycleState.Dead => "dead",
            _ => string.Empty
        };

