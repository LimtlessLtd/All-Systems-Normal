    private CropBed? CropBedForFixture(Room room, RoomFixture fixture)
    {
        if (fixture.Type != FixtureType.GrowBed)
            return null;

        return Session.State.CropBeds.FirstOrDefault(candidate =>
            candidate.RoomId.Equals(room.Id, StringComparison.OrdinalIgnoreCase)
            && candidate.FixtureLabel.Equals(fixture.Label, StringComparison.OrdinalIgnoreCase));
    }

    private bool CropBedIsActive(CropBed bed, Room room)
    {
        var growSystem = Session.State.Devices.Values.FirstOrDefault(device =>
            device.Kind == StationSystemKind.GrowBeds
            && device.RoomId.Equals(room.Id, StringComparison.OrdinalIgnoreCase));

        return bed.IsEnabled
            && room.IsPowered
            && room.LightsOn
            && growSystem is { IsEnabled: true, IsFailed: false };
    }

    private string CropFixtureLabel(Room room, RoomFixture fixture) =>
        CropBedForFixture(room, fixture) is { } bed && bed.Lifecycle != CropLifecycleState.Empty
            ? bed.Crop.ToString().ToUpperInvariant()
            : string.Empty;

