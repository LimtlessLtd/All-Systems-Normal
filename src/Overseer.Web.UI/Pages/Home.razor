    protected override async Task OnInitializedAsync()
    {
        Session.ProcessingStatusChanged += OnProcessingStatusChanged;
        await Session.InitializeAsync();
    }

    // Owner idea #102: the reset acknowledgement wins while a reset runs;
    // otherwise show whatever model call the session is awaiting.
    private string? StationProcessingLabel =>
        _resetInProgress ? "PROCESSING — RESETTING RUN" : Session.ProcessingStatus;

    // Rendered mid-await so the label is visible while the model call holds
    // the turn, not only after it returns.
    private void OnProcessingStatusChanged() =>
        _ = InvokeAsync(StateHasChanged);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("overseerLayout.init", "#overseer-workspace");
            _selfReference = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("overseerLayout.registerPauseHandler", _selfReference);

            await RestorePersistedCampaignAsync();

            // Sound defaults to on: skip any cues already queued during
            // startup/restore so the player isn't hit with a burst of every
            // historical cue at once the moment audio actually starts.
            _lastAudioSequence = Session.State.AudioCues.LastOrDefault()?.Sequence ?? 0;

            StartAutoClock();
            StateHasChanged();
        }

        await PlayPendingAudioAsync();
    }

    private async Task PersistCampaignAsync()
    {
        if (Session.Campaign.MissionHistory.Count == 0 && Session.Campaign.Ending is null)
        {
            await BrowserInterop.TryInvokeVoidAsync(JS, "localStorage.removeItem", CampaignStorageKey);
            return;
        }

        var json = CampaignStateSerializer.Serialize(Session.Campaign);
        await BrowserInterop.TryInvokeVoidAsync(JS, "localStorage.setItem", CampaignStorageKey, json);
    }

    private async Task RestorePersistedCampaignAsync()
    {
        var json = await BrowserInterop.TryInvokeAsync<string?>(
            JS,
            "localStorage.getItem",
            CampaignStorageKey);
        var campaign = CampaignStateSerializer.Deserialize(json);

        if (campaign is null
            || (campaign.MissionHistory.Count == 0 && campaign.Ending is null))
        {
            return;
        }

        StopClock();
        await Session.RestoreCampaignAsync(campaign);
        _runEndDismissed = false;
        _selection = null;
        _lastAudioSequence = 0;
    }

    private void StartAutoClock()
    {
        if (_paused
            || Session.IsRunning
            || !Session.State.IsSimulationLive)
        {
            return;
        }

        var (started, generation) = Session.StartClock();

        if (!started)
        {
            return;
        }

        _clockCts?.Cancel();
        _clockCts?.Dispose();
        _clockCts = new CancellationTokenSource();
        _clockTask = RunClockAsync(generation, _clockCts.Token);
    }

    private async Task ToggleSoundAsync()
    {
        var next = !_soundEnabled;

        if (next)
        {
            _lastAudioSequence = Session.State.AudioCues.LastOrDefault()?.Sequence ?? 0;
        }

        var enabled = await JS.InvokeAsync<bool>(
            "overseerAudio.setEnabled",
            next);

        _soundEnabled = next && enabled;
    }

    private async Task ToggleMusicAsync()
    {
        var next = !_musicEnabled;
        var enabled = await JS.InvokeAsync<bool>(
            "overseerAudio.setMusicEnabled",
            next);

        _musicEnabled = next && enabled;
    }

    private async Task PlayPendingAudioAsync()
    {
        if (!_soundEnabled)
        {
            return;
        }

        var pending = Session.State.AudioCues
            .Where(cue => cue.Sequence > _lastAudioSequence)
            .OrderBy(cue => cue.Sequence)
            .Take(8)
            .ToList();

        foreach (var cue in pending)
        {
            // Skipped, not retried, if the browser is unavailable: a cue
            // replayed later would be out of date.
            await BrowserInterop.TryInvokeVoidAsync(
                JS,
                "overseerAudio.play",
                cue.Kind.ToString(),
                cue.SourceId);

            _lastAudioSequence = cue.Sequence;
        }
    }

    private async Task RunClockAsync(long generation, CancellationToken cancellationToken)
    {
        try
        {
            while (!cancellationToken.IsCancellationRequested)
            {
                await Task.Delay(_delayMs, cancellationToken);

                var outcomeWasOpen = Session.State.ScenarioStatus == ScenarioStatus.Running;
                var keepRunning = await Session.TryAdvanceRunningAsync(
                    generation,
                    cancellationToken);
                var outcomeResolved = outcomeWasOpen
                    && Session.State.ScenarioStatus != ScenarioStatus.Running;

                if (outcomeResolved)
                {
                    _runEndDismissed = false;
                }

                // A won run keeps ticking (#103); its result is recorded and
                // persisted on the turn it resolves, not when the clock stops.
                if (!keepRunning || outcomeResolved)
                {
                    Session.CaptureCampaignProgress();
                    await PersistCampaignAsync();
                }

                // Always render the resolved turn, including the terminal turn
                // and the campaign consequences captured from it.
                await InvokeAsync(StateHasChanged);

                if (!keepRunning)
                {
                    break;
                }
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            // Normal pause/dispose path.
        }
        catch (Exception)
        {
            // A turn failed without a pause being asked for. Leaving the loop
            // with the clock still marked running froze the station until the
            // player happened to toggle pause; show it paused so Play resumes.
            _paused = true;
            Session.PauseClock();
            await InvokeAsync(StateHasChanged);
        }
    }

    private void StopClock()
    {
        // Invalidate the active turn generation before cancelling the UI loop
        // so a stale loop can never advance simulation state.
        Session.PauseClock();
        _clockCts?.Cancel();
        _clockCts?.Dispose();
        _clockCts = null;
        _clockTask = null;
    }

    private bool CanSee(Npc npc) =>
        npc.IsPresent
        && Session.State.Facility.Rooms[npc.CurrentRoomId].HasVisualFeed;

    private bool CanSee(StationRobot robot) =>
        !robot.IsDestroyed
        && Session.State.Facility.Rooms[robot.CurrentRoomId].HasVisualFeed;

    private bool CanSee(SecurityTurret turret) =>
        !turret.IsDestroyed
        && Session.State.Facility.Rooms[turret.RoomId].HasVisualFeed;

    private string TurretTokenClass(SecurityTurret turret)
    {
        var classes = new List<string> { "robot-token", "turret-token" };

        if (!turret.IsArmed || !TurretSystem.HasPower(Session.State, turret))
            classes.Add("shutdown");
        else
            classes.Add(turret.Policy == TurretPolicy.SuppressCrew ? "hostile" : "neutral");

        if (turret.IsArmed)
            classes.Add("armed");

        if (turret.TrackedNpcId is not null)
            classes.Add("tracking");
        if (SelectedTurret?.Id == turret.Id)
            classes.Add("selected");

        return string.Join(' ', classes);
    }

    private string RobotTokenClass(StationRobot robot)
    {
        var classes = new List<string>
        {
            "robot-token",
            robot.IsDestroyed ? "destroyed"
                : !robot.IsOperational ? "shutdown"
                : robot.Policy.ToString().ToLowerInvariant()
        };

        if (robot.Movement is not null || robot.IsLocallyMoving)
            classes.Add("is-moving");
        if (robot.ActionCompletesAt is not null
            || robot.CurrentTask.Contains("repair", StringComparison.OrdinalIgnoreCase)
            || robot.CurrentTask.Contains("inspection", StringComparison.OrdinalIgnoreCase))
            classes.Add("is-working");
        if (robot.CurrentTask.Contains("charging", StringComparison.OrdinalIgnoreCase))
            classes.Add("is-charging");
        if (SelectedRobot?.Id == robot.Id)
            classes.Add("selected");

        return string.Join(' ', classes);
    }

    private static string Initials(string name) =>
        string.Concat(
            name.Split(' ', StringSplitOptions.RemoveEmptyEntries)
                .Take(2)
                .Select(part => char.ToUpperInvariant(part[0])));

    private string CrewTokenClass(Npc npc)
    {
        var classes = new List<string>
        {
            "crew-token",
            $"role-{npc.Role.ToString().ToLowerInvariant()}"
        };

        if (SelectedCrew?.Id == npc.Id)
            classes.Add("selected");

        // Owner idea #86: heading mostly up-screen shows the upright figure's back.
        if (Math.Sin(npc.FacingDegrees * Math.PI / 180) < -0.5)
            classes.Add("facing-away");

        if (npc.IsAlive && (npc.Fear >= 65 || npc.Stress >= 75))
            classes.Add("is-panicked");

        if (npc.IsContainmentBreachInProgress)
            classes.Add("containment-breach");
        else if (npc.HasEscapedContainment)
            classes.Add("containment-at-large");

        if (IsRecaptureActive(npc))
            classes.Add("containment-recapture");

        if (!npc.IsAlive)
            classes.Add("deceased");
        else if (npc.Movement is not null || npc.IsLocallyMoving)
            classes.Add("is-walking");
        else if (npc.CurrentAction.Kind is ActionKind.Talk
                 or ActionKind.Socialize
                 or ActionKind.Argue
                 or ActionKind.RequestHelp)
            classes.Add("is-social");
        else if (npc.CurrentAction.Kind is ActionKind.Sleep or ActionKind.Rest)
        {
            classes.Add("is-resting");
            if (BedUseRules.BedAsleepIn(Session.State, npc) is not null)
                classes.Add("is-asleep-in-bed");
        }
        else if (npc.CurrentAction.Kind is not ActionKind.Idle)
            classes.Add("is-busy");
        else
            classes.Add("is-idle");

        if (npc.CurrentAction.Kind is
            ActionKind.Work
            or ActionKind.Repair
            or ActionKind.InspectEquipment
            or ActionKind.TendCrops
            or ActionKind.Harvest
            or ActionKind.Cook
            or ActionKind.MedicalCheckup
            or ActionKind.TreatInjury
            or ActionKind.AdministerMedication
            or ActionKind.CleanBlood
            or ActionKind.ResurrectCrew
            or ActionKind.OpenDoor
            or ActionKind.CloseDoor
            or ActionKind.LockDoor
            or ActionKind.UnlockDoor)
        {
            classes.Add("hands-active");
        }

        classes.Add($"activity-{npc.CurrentAction.Kind.ToString().ToLowerInvariant()}");
        return string.Join(' ', classes);
    }

    private static string CrewActivityLabel(Npc npc)
    {
        if (!npc.IsAlive) return "DECEASED";
        if (npc.IsContainmentBreachInProgress) return "BREACH";
        if (npc.HasEscapedContainment) return "AT LARGE";
        if (IsRecaptureActive(npc)) return "RECAPTURE";
        if (npc.Movement is not null || npc.IsLocallyMoving) return "WALK";
        return npc.CurrentAction.Kind switch
        {
            ActionKind.Idle => "IDLE",
            ActionKind.TreatInjury => "TREAT",
            ActionKind.AdministerMedication => "MEDS",
            ActionKind.MedicalCheckup => "CHECK",
            ActionKind.ResurrectCrew => "REVIVE",
            ActionKind.CleanBlood => "CLEAN",
            ActionKind.Repair => "REPAIR",
            ActionKind.Work => "WORK",
            ActionKind.Talk or ActionKind.Socialize or ActionKind.Argue => "TALK",
            ActionKind.Sleep or ActionKind.Rest => "REST",
            _ => npc.CurrentAction.Kind.ToString().ToUpperInvariant()
