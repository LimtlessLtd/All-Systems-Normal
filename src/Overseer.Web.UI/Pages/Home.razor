    private readonly record struct RoutePoint(double X, double Y);

    private IReadOnlyList<RoutePoint> SelectedRoutePoints()
    {
        IReadOnlyList<string> path;
        IStationMobileEntity? selectedMover = null;
        var points = new List<RoutePoint>();

        if (SelectedCrew is { IsAlive: true, PlannedDestinationRoomId: { } crewDestination } crew
            && Session.State.Facility.Rooms.ContainsKey(crewDestination))
        {
            path = _routeNavigation.FindPathForCrew(
                Session.State,
                crew,
                crew.CurrentRoomId,
                crewDestination);
            if (path.Count < 2)
                return [];

            selectedMover = crew;
            points.Add(new(CrewMapX(crew), CrewMapY(crew)));
        }
        else if (SelectedRobot is { TargetRoomId: { } robotDestination } robot
                 && Session.State.Facility.Rooms.ContainsKey(robotDestination))
        {
            path = _routeNavigation.FindPath(
                Session.State.Facility,
                robot.CurrentRoomId,
                robotDestination);
            if (path.Count < 2)
                return [];

            selectedMover = robot;
            points.Add(new(RobotMapX(robot), RobotMapY(robot)));
        }
        else
        {
            return [];
        }

        if (selectedMover is not null
            && Session.State.Facility.Rooms.TryGetValue(
                selectedMover.CurrentRoomId,
                out var currentRoom))
        {
            foreach (var local in LocalMovementSystem.PreviewDoorRoute(
                         Session.State,
                         selectedMover,
                         TimeSpan.FromMinutes(1),
                         maxSteps: 24))
            {
                points.Add(LocalRoutePoint(currentRoom, local));
            }
        }

        for (var index = 0; index < path.Count - 1; index++)
        {
            var first = Session.State.Facility.Rooms[path[index]];
            var second = Session.State.Facility.Rooms[path[index + 1]];
            try
            {
                var portal = StationGeometry.FindSharedPortal(first, second);
                points.Add(new(portal.X, portal.Y));
            }
            catch (InvalidOperationException)
            {
                points.Add(new(second.MapX, second.MapY));
            }
        }

        var destinationRoom = Session.State.Facility.Rooms[path[^1]];
        points.Add(new(destinationRoom.MapX, destinationRoom.MapY));
        return points;
    }

