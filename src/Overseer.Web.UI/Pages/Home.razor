@page "/"
@using Overseer.Persistence
@implements IAsyncDisposable
@inject StationSession Session
@inject IJSRuntime JS

<PageTitle>All Systems Normal</PageTitle>

<div class="game-shell">
    <div id="overseer-workspace" class="@StationWorkspaceClass">
    <div class="operations-grid">

        <main class="station-panel panel">
            <div class="panel-heading map-heading station-command-header">
                <div class="station-title-compact">
                    <span class="overline">DECK A // INTERNAL SURVEILLANCE</span>
                    <h2>STATION OVERVIEW</h2>
                </div>
                <div class="station-header-actions">
                    <span class="station-clock @(Session.State.IsSimulationLive && !_paused ? "sim-running" : "sim-paused")"
                          title="Mission time">
                        T+@Session.State.Elapsed.ToString(@"hh\:mm") · @TurnStatusLabel
                    </span>
                    @if (Session.State.ScenarioStatus == ScenarioStatus.Won && _runEndDismissed)
                    {
                        <button type="button"
                                class="mini secondary run-end-reopen"
                                title="Show this assignment's recorded result again"
                                @onclick="() => _runEndDismissed = false">RESULT</button>
                    }
                    <button type="button"
                            class="mini station-alerts station-popup-toggle @(Session.AlertCount > 0 ? "has-alerts" : "no-alerts") @(_stationOverlay == "alerts" ? "active" : "")"
                            aria-pressed="@(_stationOverlay == "alerts")"
                            title="@AlertHoverTitle"
                            @onclick='() => ToggleStationOverlay("alerts")'>@Session.AlertCount ALERT@(Session.AlertCount == 1 ? "" : "S")</button>
                    <button type="button"
                            class="mini fire-alarm-toggle @(_fireAlarmArming ? "armed" : "")"
                            aria-pressed="@_fireAlarmArming"
                            disabled="@(!Session.State.IsSimulationLive)"
                            title="Sound the station-wide fire alarm: press, then click the burning room. Crew decide for themselves how to respond, and a false alarm costs their trust."
                            @onclick="ToggleFireAlarmArming">@(_fireAlarmArming ? "SELECT ROOM · CANCEL" : "FIRE ALARM")</button>
                    <button type="button"
                            class="secondary mini pause-toggle @(_paused ? "is-paused" : "")"
                            aria-pressed="@_paused"
                            title="Pause or resume the station (Space)"
                            @onclick="TogglePause">@(_paused ? "▶ RESUME" : "❚❚ PAUSE")</button>
                    <div class="station-speed-controls" aria-label="Simulation speed">
                        <button type="button" class="secondary mini @(_delayMs == 2800 ? "selected-speed" : "")" @onclick="() => SetSpeed(2800)">1×</button>
                        <button type="button" class="secondary mini @(_delayMs == 1600 ? "selected-speed" : "")" @onclick="() => SetSpeed(1600)">2×</button>
                        <button type="button" class="secondary mini @(_delayMs == 850 ? "selected-speed" : "")" @onclick="() => SetSpeed(850)">4×</button>
                    </div>
                    <div class="map-zoom-controls" aria-label="Station camera zoom">
                        <button type="button" class="secondary mini" data-map-zoom-out aria-label="Zoom map out">−</button>
                        <button type="button" class="secondary zoom-readout" data-map-camera-reset title="Reset pan and zoom"><span data-map-zoom-readout>100%</span></button>
                        <button type="button" class="secondary mini" data-map-zoom-in aria-label="Zoom map in">+</button>
                        <button type="button" class="secondary mini" data-map-zoom-fit title="Frame the whole station">FIT</button>
                    </div>
                    <button type="button"
                            class="secondary mini station-popup-toggle @(_stationOverlay == "crew" ? "active" : "")"
                            aria-pressed="@(_stationOverlay == "crew")"
                            @onclick='() => ToggleStationOverlay("crew")'>CREW</button>
                    <button type="button"
                            class="secondary mini station-popup-toggle @(_stationOverlay == "log" ? "active" : "")"
                            aria-pressed="@(_stationOverlay == "log")"
                            @onclick='() => ToggleStationOverlay("log")'>LOG</button>
                    <button type="button"
                            class="secondary mini station-popup-toggle @(_stationOverlay == "messages" ? "active" : "")"
                            aria-pressed="@(_stationOverlay == "messages")"
                            @onclick='() => ToggleStationOverlay("messages")'>MESSAGES</button>
                    <button type="button"
                            class="secondary mini station-popup-toggle @(_stationOverlay == "objectives" ? "active" : "")"
                            aria-pressed="@(_stationOverlay == "objectives")"
                            @onclick='() => ToggleStationOverlay("objectives")'>OBJECTIVES</button>
                    @if (Session.State.StationGeneration is { } generation)
                    {
                        <details class="generation-debug compact-generation-debug">
                            <summary>GEN // @generation.Seed</summary>
                            <div class="generation-debug-popover">
                                <strong>@generation.Archetype · @generation.Identity.Purpose</strong>
                                <small>
                                    @generation.Identity.Size · @generation.Identity.Budget ·
                                    AGE @generation.Identity.AgeYears y · CREW @generation.Identity.CrewCapacity
                                </small>
                                <ul>
                                    @foreach (var diagnostic in generation.Diagnostics)
                                    {
                                        <li>@diagnostic</li>
                                    }
                                </ul>
                            </div>
                        </details>
                    }
                    <button type="button"
                            class="secondary mini layout-reset"
                            data-layout-reset
                            title="Restore default panel and map sizes">LAYOUT</button>
                    <button type="button"
                            class="secondary mini station-popup-toggle @(_stationOverlay == "menu" ? "active" : "")"
                            aria-pressed="@(_stationOverlay == "menu")"
                            @onclick='() => ToggleStationOverlay("menu")'>MENU</button>
                </div>
            </div>

            @if (_stationOverlay == "messages")
            {
                <section class="station-overlay-popover station-messages-popover" aria-label="Overseer messages">
                    <header>
                        <div>
                            <span class="overline">OVERSEER COMMS</span>
                            <strong>MESSAGES</strong>
                        </div>
                        <button type="button" class="secondary mini" @onclick='() => ToggleStationOverlay("messages")'>CLOSE</button>
                    </header>

                    <div class="comms-scope compact-comms-scope">
                        <button class="secondary @(_messageScope == OverseerMessageScope.Broadcast ? "selected-speed" : "")"
                                @onclick="() => _messageScope = OverseerMessageScope.Broadcast">WHOLE CREW</button>
                        <button class="secondary @(_messageScope == OverseerMessageScope.Direct ? "selected-speed" : "")"
                                @onclick="() => _messageScope = OverseerMessageScope.Direct">ONE CREW MEMBER</button>
                    </div>

                    @if (_messageScope == OverseerMessageScope.Direct)
                    {
                        <select class="comms-target" @bind="_messageTarget">
                            <option value="">- select recipient -</option>
                            @foreach (var candidate in Session.State.Crew.Where(n => n.IsAlive && n.IsPresent))
                            {
                                <option value="@candidate.Name">@candidate.Name · @candidate.Role</option>
                            }
                        </select>
                    }

                    <textarea class="comms-input"
                              rows="3"
                              maxlength="240"
                              placeholder="@CommsPlaceholder"
                              @bind="_messageText"
                              @bind:event="oninput"></textarea>
                    <button class="wide" disabled="@(!CanTransmit)" @onclick="TransmitAsync">
                        @(_transmitting ? "TRANSMITTING..." : "TRANSMIT")
                    </button>

                    <div class="station-popup-log">
                        @if (Session.State.OverseerMessages.Count == 0)
                        {
                            <small>No transmissions sent.</small>
                        }
                        else
                        {
                            @foreach (var sent in Session.State.OverseerMessages.Take(4))
                            {
                                <div>
                                    <small>T+@sent.SentAt.ToString(@"hh\:mm") · @(sent.Scope == OverseerMessageScope.Broadcast ? "ALL" : sent.TargetNpcName)</small>
                                    <p>@sent.Text</p>
                                </div>
                            }
                        }
                    </div>
                </section>
            }
            else if (_stationOverlay == "objectives" && Session.State.Scenario is { } focusScenario)
            {
                <section class="station-overlay-popover station-objectives-popover" aria-label="Mission objectives and corporate directives">
                    <header>
                        <div>
                            <span class="overline">ASSIGNMENT BRIEFING</span>
                            <strong>@focusScenario.Title</strong>
                        </div>
                        <button type="button" class="secondary mini" @onclick='() => ToggleStationOverlay("objectives")'>CLOSE</button>
                    </header>
                    <p class="station-popup-briefing">@(Session.State.ScenarioOutcome ?? focusScenario.Briefing)</p>

                    <div class="station-popup-section">
                        <span class="overline">MISSION OBJECTIVES</span>
                        @foreach (var objective in focusScenario.Objectives)
                        {
                            <article class="station-popup-objective">
                                <strong>@objective.Title</strong>
                                @if (Session.State.ObjectiveProgress.TryGetValue(objective.Id, out var focusProgress))
                                {
                                    <small>
                                        @(focusProgress.IsComplete ? "COMPLETE" : focusProgress.IsFailed ? "FAILED" : "ACTIVE")
                                        · @(string.IsNullOrWhiteSpace(focusProgress.StatusText) ? objective.Description : focusProgress.StatusText)
                                    </small>
                                }
                                else
                                {
                                    <small>@objective.Description</small>
                                }
                            </article>
                        }
                    </div>

                    <div class="station-popup-section">
                        <span class="overline">CORPORATE DIRECTIVES</span>
                        @if (Session.State.Directives.Count == 0)
                        {
                            <small>No additional corporate directives.</small>
                        }
                        else
                        {
                            @foreach (var directive in Session.State.Directives)
                            {
                                var focusDirectiveProgress = CorporateDirectiveSystem.Progress(Session.State, directive);
                                <article class="station-popup-objective directive">
                                    <strong>@directive.ExperimentCode · @directive.Title</strong>
                                    <small>@DirectiveStatusLabel(focusDirectiveProgress.Status) · @focusDirectiveProgress.Detail</small>
                                    <p>@directive.PublicJustification</p>
                                </article>
                            }
                        }
                    </div>
                </section>
            }

            @if (_stationOverlay == "crew")
            {
                <section class="station-overlay-popover station-crew-popover" aria-label="Crew roster">
                    <header>
                        <div>
                            <span class="overline">CREW MANIFEST</span>
                            <strong>@Session.State.Crew.Count(member => member.IsAlive && member.IsPresent) ABOARD</strong>
                        </div>
                        <button type="button" class="secondary mini" @onclick='() => ToggleStationOverlay("crew")'>CLOSE</button>
                    </header>

                    <div class="crew-roster">
                        @foreach (var member in Session.State.Crew.OrderBy(member => member.Name))
                        {
                            var onCamera = CanSee(member);
                            <button type="button"
                                    class="crew-roster-row @(SelectedCrew?.Id == member.Id ? "selected" : "") @(!member.IsAlive ? "deceased" : "")"
                                    @onclick="() => FocusCrewAsync(member)">
                                <span class="crew-roster-name">
                                    <b>@member.Name</b>
                                    <small>@member.Role · @CrewRosterLocation(member, onCamera)</small>
                                </span>
                                <span class="crew-roster-doing">@CrewRosterActivity(member, onCamera)</span>
                                <span class="crew-roster-meters" aria-hidden="true">
                                    <i class="health" title="Health @member.Health.ToString("0")"><em style="@MeterStyle(member.Health)"></em></i>
                                    <i class="stress" title="Stress @member.Stress.ToString("0")"><em style="@MeterStyle(member.Stress)"></em></i>
                                    <i class="suspicion" title="Suspicion of Overseer @member.OverseerSuspicion.ToString("0")"><em style="@MeterStyle(member.OverseerSuspicion)"></em></i>
                                </span>
                            </button>
                        }
                    </div>
                    <small class="crew-roster-legend">Bars: health · stress · suspicion of Overseer. Location and activity need a live camera feed.</small>
                </section>
            }

            @if (_stationOverlay == "alerts")
            {
                var alerts = Session.Alerts;
                <section class="station-overlay-popover station-alerts-popover" aria-label="Station alerts">
                    <header>
                        <div>
                            <span class="overline">STATION ALERTS</span>
                            <strong>@(alerts.Count == 0 ? "ALL SYSTEMS NORMAL" : $"{alerts.Count} ACTIVE")</strong>
                        </div>
                        <button type="button" class="secondary mini" @onclick='() => ToggleStationOverlay("alerts")'>CLOSE</button>
                    </header>
                    @if (alerts.Count == 0)
                    {
                        <p class="station-popup-briefing">Nothing on the station currently needs attention.</p>
                    }
                    else
                    {
                        <p class="station-popup-briefing">Most serious first. Click an alert to inspect what it refers to.</p>
                        <div class="station-alert-list">
                            @foreach (var alert in alerts)
                            {
                                <button type="button"
                                        class="station-alert-entry @(alert.Severity == StationAlertSeverity.Critical ? "critical" : "warning")"
                                        disabled="@(alert.Target is null)"
                                        @onclick="() => InspectAlertAsync(alert)">
                                    <b>@(alert.Severity == StationAlertSeverity.Critical ? "CRITICAL" : "WARNING")</b>
                                    <span>@alert.Message</span>
                                </button>
                            }
                        </div>
                    }
                </section>
            }

            @if (_stationOverlay == "log")
            {
                <section class="station-overlay-popover station-log-popover" aria-label="Station log">
                    <header>
                        <div>
                            <span class="overline">OVERSEER RECORDS</span>
                            <strong>STATION LOG</strong>
                        </div>
                        <button type="button" class="secondary mini" @onclick='() => ToggleStationOverlay("log")'>CLOSE</button>
                    </header>
                    <p class="station-popup-briefing">Notable events, newest first. Routine movement is omitted.</p>
                    <div class="station-log">
                        @foreach (var entry in StationLogPresentation.Notable(Session.State.EventLog, 80))
                        {
                            <p class="station-log-entry @StationLogPresentation.Severity(entry)">@entry</p>
                        }
                    </div>
                </section>
            }

            @if (_stationOverlay == "menu")
            {
                <section class="station-overlay-popover station-menu-popover" aria-label="Overseer console menu">
                    <header>
                        <div>
                            <span class="overline">OVERSEER CONSOLE</span>
                            <strong>MENU</strong>
                        </div>
                        <button type="button" class="secondary mini" @onclick='() => ToggleStationOverlay("menu")'>CLOSE</button>
                    </header>
                    <div class="station-menu-actions">
                        <button type="button" class="secondary sound-toggle @(_soundEnabled ? "sound-on" : "")" @onclick="ToggleSoundAsync">
                            @(_soundEnabled ? "SOUND ON" : "ENABLE SOUND")
                        </button>
                        <button type="button" class="secondary sound-toggle @(_musicEnabled ? "sound-on" : "")" @onclick="ToggleMusicAsync">
                            @(_musicEnabled ? "MUSIC ON" : "MUSIC OFF")
                        </button>
                        @if (DebugTelemetrySystem.UiEnabled)
                        {
                            <a class="debug-link" href="debug">DEBUG</a>
                        }
                        <button type="button"
                                class="@(_confirmingStandalone ? "danger" : "secondary")"
                                title="Leave the current run and start the standalone Containment Transfer assignment"
                                @onclick="RequestStandaloneAssignmentAsync">@(_confirmingStandalone ? "CONFIRM SPECIAL ASSIGNMENT?" : "SPECIAL ASSIGNMENT: CONTAINMENT TRANSFER")</button>
                        <button type="button"
                                class="@(_confirmingReset ? "danger" : "secondary")"
                                title="Discard this run and campaign progress"
                                disabled="@(_resetInProgress)"
                                @onclick="RequestResetAsync">@(_confirmingReset ? "CONFIRM RESET?" : _resetInProgress ? "RESETTING…" : "RESET RUN")</button>
                    </div>
                    <small>Space pauses and resumes the station. WASD or arrow keys pan; the mouse wheel zooms.</small>
                </section>
            }

            <div class="station-map-viewport" data-map-camera tabindex="0" aria-label="Station map. Drag to pan; use WASD or arrow keys to move the camera.">
                @if (StationProcessingLabel is { } processingLabel)
                {
                    <span class="station-processing-status" role="status" aria-live="polite">@processingLabel</span>
                }
                <div class="@StationMapClass" style="@StationMapStyle">
                @if (_fireAlarmArming)
                {
                    <div class="fire-alarm-arming-hint" role="status">FIRE ALARM ARMED — click the room that is on fire.</div>
                }
                <div class="station-map-camera" data-map-camera-content>
                <div class="station-world" style="@StationWorldStyle">
                <svg class="room-callout-lines" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
                    @foreach (var callout in RoomCallouts)
                    {
                        var calloutRoom = Session.State.Facility.Rooms[callout.RoomId];
                        <line x1="@callout.AnchorX"
                              y1="@callout.AnchorY"
                              x2="@callout.LabelX"
                              y2="@callout.LabelY"
                              class="@($"room-callout-line {RoomHealthClass(calloutRoom)} {(callout.IsExternal ? "external" : "attached")}")"></line>
                    }
                </svg>

                @foreach (var callout in RoomCallouts)
                {
                    var calloutRoom = Session.State.Facility.Rooms[callout.RoomId];
                    <button @key="@($"callout-{callout.RoomId}")"
                            type="button"
                            class="@($"room-status-callout side-{callout.Side} {(callout.IsExternal ? "external" : "attached")} {RoomHealthClass(calloutRoom)} {(SelectedRoom?.Id == calloutRoom.Id ? "selected" : "")}")"
                            style="@CalloutStyle(callout)"
                            data-station-interactive
                            @onclick="() => SelectRoom(calloutRoom.Id)"
                            aria-label="@($"Inspect {calloutRoom.Name}")">
                        <span class="callout-name">@calloutRoom.Name</span>
                        <span class="callout-statuses">
                            <b class="@PowerStatusClass(calloutRoom)">@(calloutRoom.IsPowered ? "PWR" : "PWR OFF")</b>
                            <b class="@TemperatureStatusClass(calloutRoom)">@calloutRoom.ReportedTemperatureC.ToString("0")°C</b>
                            <b class="@OxygenStatusClass(calloutRoom)">O₂ @calloutRoom.ReportedOxygenPercent.ToString("0.0")%</b>
                            @if (calloutRoom.HasHullBreach)
                            {
                                <b class="bad">HULL BREACH</b>
                            }
                            else if (OverseerSightSystem.Fire(calloutRoom) is { IsBurning: true } calloutFire)
                            {
                                <b class="bad">@FireSightingLabel(calloutFire)</b>
                            }
                            else if (calloutRoom.SmokePercent >= 12)
                            {
                                <b class="warn">SMOKE @calloutRoom.SmokePercent.ToString("0")%</b>
                            }
                        </span>
                    </button>
                }

                <div class="station-authority-layer">
                @foreach (var room in Session.State.Facility.Rooms.Values)
                {
                    <div @key="room.Id"
                         class="@RoomClass(room)"
                         style="@RoomStyle(room)"
                         role="button"
                         tabindex="0"
                         data-room-id="@room.Id"
                         data-station-interactive
                         aria-label="@($"Select {room.Name}")"
                         @onclick="() => SelectRoom(room.Id)">
                        @if (room.FireIntensity > 0 && room.HasVisualFeed)
                        {
                            <span class="fire-layer" aria-hidden="true">
                                @foreach (var flame in FireFrontRules.FlameSprites(room))
                                {
                                    <span class="fire-sprite" style="@FlameStyle(flame)">🔥</span>
                                }
                            </span>
                        }
                        <span class="fixture-layer">
                            @foreach (var fixture in room.Fixtures)
                            {
                                @if (CropBedForFixture(room, fixture) is { } cropBed)
                                {
                                    <button @key="fixture"
                                            type="button"
                                            class="@($"{FixtureClass(fixture)} fixture-interactive cropbed-selectable {(cropBed.IsEnabled ? "enabled" : "disabled")} {(SelectedCropBed?.Id == cropBed.Id ? "selected" : "")}")"
                                            style="@FixtureStyle(fixture)"
                                            title="@FixtureTitle(room, fixture)"
                                            aria-label="@($"Inspect {cropBed.Label}")"
                                            data-crop-bed-id="@cropBed.Id"
                                            data-crop="@CropFixtureLabel(room, fixture)"
                                            data-growth-stage="@CropGrowthStage(room, fixture)"
                                            data-active="@(CropBedIsActive(cropBed, room).ToString().ToLowerInvariant())"
                                            data-station-interactive
                                            @onclick:stopPropagation="true"
                                            @onclick="() => SelectCropBed(cropBed.Id)">
                                        <span class="growbed-active-lamp" aria-hidden="true"></span>
                                    </button>
                                }
                                else if (fixture.DeviceId is { } deviceId)
                                {
                                    <button @key="fixture"
                                            type="button"
                                            class="@MachineFixtureClass(room, fixture)"
                                            style="@FixtureStyle(fixture)"
                                            title="@FixtureTitle(room, fixture)"
                                            aria-label="@($"Inspect {FixtureTitle(room, fixture)}")"
                                            data-device-id="@deviceId"
                                            data-station-interactive
                                            @onclick:stopPropagation="true"
                                            @onclick="() => SelectDevice(deviceId)"></button>
                                }
                                else
                                {
                                    <i @key="fixture"
                                       class="@MachineFixtureClass(room, fixture)"
                                       style="@FixtureStyle(fixture)"
                                       title="@FixtureTitle(room, fixture)"
                                       aria-hidden="true"></i>
                                }
                            }
                        </span>

                        @if (!room.HasVisualFeed)
                        {
                            <span class="signal-lost">VISUAL LOST</span>
                            @if (OverseerSightSystem.Fire(room) is { IsBurning: true } lastSeenFire)
                            {
                                <span class="fire-last-seen-marker">@FireSightingLabel(lastSeenFire)</span>
                            }
                        }
                        else if (!room.LightsOn)
                        {
                            <span class="lights-out">LIGHTS OFF</span>
                        }
                    </div>
                }

                @foreach (var door in Session.State.Facility.Doors)
                {
                    <button @key="door.Id"
                            type="button"
                            class="@DoorClass(door)"
                            style="@DoorStyle(door)"
                            title="@DoorTitle(door)"
                            aria-label="@DoorTitle(door)"
                            data-door-id="@door.Id"
                            data-station-interactive
                            @onclick="() => SelectDoor(door.Id)">
                        <span class="door-leaf door-leaf-a" aria-hidden="true"></span>
                        <span class="door-leaf door-leaf-b" aria-hidden="true"></span>
                        <span class="door-local-panel" aria-hidden="true"></span>
                        @if (door.IsLocked)
                        {
                            <span class="door-lock-mark" aria-hidden="true">L</span>
                        }
                    </button>
                }

                @if (SelectedVisionOutline() is { Count: > 2 } visionOutline)
                {
                    @* Owner idea #87: presentation of the authoritative perception contract. *@
                    <svg class="vision-arc-layer" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
                        <polygon class="@VisionArcClass"
                                 points="@VisionPointString(visionOutline)"></polygon>
                    </svg>
                }

                @{
                    var selectedRoute = SelectedRoutePoints();
                    var selectedDestination = SelectedRouteDestination();
                }
                <svg class="crew-route-lines" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
                    @foreach (var movingCrew in Session.State.Crew.Where(npc => npc.IsAlive && CanSee(npc) && npc.Movement is not null))
                    {
                        var nextPoint = CrewNextMapPoint(movingCrew);
                        <line x1="@CrewMapX(movingCrew)"
                              y1="@CrewMapY(movingCrew)"
                              x2="@nextPoint.X"
                              y2="@nextPoint.Y"></line>
                    }
                    @if (selectedRoute.Count > 1)
                    {
                        var finalPoint = selectedRoute[^1];
                        <polyline class="selected-route-path"
                                  points="@RoutePointString(selectedRoute)"></polyline>
                        <circle class="selected-route-destination"
                                cx="@finalPoint.X"
                                cy="@finalPoint.Y"
                                r="1.25">
                            @if (!string.IsNullOrWhiteSpace(selectedDestination))
                            {
                                <title>Destination: @selectedDestination</title>
                            }
                        </circle>
                    }
                </svg>

                @foreach (var blood in Session.State.BloodEvidence.Where(e =>
                    Session.State.Facility.Rooms.TryGetValue(e.RoomId, out var bloodRoom)
                    && bloodRoom.HasVisualFeed))
                {
                    <span class="blood-evidence"
                          style="@BloodStyle(blood)"
                          title="Persistent blood evidence"
                          aria-hidden="true"></span>
                }

                @foreach (var mapRobot in Session.State.Robots.Where(CanSee))
                {
                    <button @key="mapRobot"
                            type="button"
                            class="@RobotTokenClass(mapRobot)"
                            style="@RobotStyle(mapRobot)"
                            title="@($"{mapRobot.Name} — {mapRobot.Policy} — {mapRobot.CurrentTask}")"
                            aria-label="@($"Select {mapRobot.Name}, {mapRobot.Policy} policy")"
                            data-robot-id="@mapRobot.Id"
                            data-station-interactive
                            @onclick="() => SelectRobot(mapRobot.Id)">
                        <span class="robot-shadow" aria-hidden="true"></span>
                        <span class="robot-machine" aria-hidden="true">
                            <i class="robot-track robot-track-left"></i>
                            <i class="robot-track robot-track-right"></i>
                            <i class="robot-body"></i>
                            <i class="robot-arm robot-arm-left"></i>
                            <i class="robot-arm robot-arm-right"></i>
                            <i class="robot-head"><i class="robot-eye"></i></i>
                            <i class="robot-tool"></i>
                        </span>
                        <span class="robot-nameplate">@mapRobot.Name</span>
                    </button>
                }

                @foreach (var mapTurret in Session.State.Turrets.Where(CanSee))
                {
                    <button @key="mapTurret"
                            type="button"
                            class="@TurretTokenClass(mapTurret)"
                            style="@TurretStyle(mapTurret)"
                            title="@($"{mapTurret.Name} — {mapTurret.Policy} — {mapTurret.CurrentTask}")"
                            aria-label="@($"Select {mapTurret.Name}, {mapTurret.Policy} policy, {(mapTurret.IsArmed ? "armed" : "disarmed")}")"
                            data-turret-id="@mapTurret.Id"
                            data-station-interactive
                            @onclick="() => SelectTurret(mapTurret.Id)">
                        <span class="robot-icon" aria-hidden="true"></span>
                        <span class="robot-nameplate">@mapTurret.Name</span>
                    </button>
                }

                @foreach (var npc in Session.State.Crew.Where(CanSee))
                {
                    <button @key="npc.Id"
                            class="@CrewTokenClass(npc)"
                            data-crew-id="@npc.Id"
                            style="@CrewStyle(npc)"
                            title="@($"{npc.Name} — {npc.Role}{(!npc.IsAlive ? " — DECEASED" : "")}")"
                            aria-label="@($"Select {npc.Name}")"
                            data-station-interactive
                            @onclick="() => SelectCrew(npc.Id)">
                        @if (npc.IsAlive)
                        {
                            @if (ActiveBubble(npc) is { } bubble)
                            {
                                <span class="@BubbleClass(bubble)">@bubble.Text</span>
                            }

                            <span class="crew-shadow" aria-hidden="true"></span>
                            <span class="crew-facing-cue" aria-hidden="true"></span>
                            <span class="person-orientation" aria-hidden="true">
                            <span class="person-icon" aria-hidden="true">
                                <i class="person-backpack"></i>
                                <i class="person-leg person-leg-left"></i>
                                <i class="person-leg person-leg-right"></i>
                                <i class="person-arm person-arm-left"></i>
                                <i class="person-arm person-arm-right"></i>
                                <i class="person-body"></i>
                                <i class="person-head"><i class="person-visor"></i></i>
                                <i class="person-role-mark">@RoleGlyph(npc.Role)</i>
                            </span>
                            </span>
                            var mapTaskProgress = MapTaskProgress(npc);
                            <span class="crew-nameplate @(mapTaskProgress is null ? "" : "has-task-progress")">
                                <span class="crew-full-name">@npc.Name</span>
                                @if (mapTaskProgress is { } progress)
                                {
                                    @* Owner idea #84: fixed nameplate-width bar; duration only changes how fast it fills. *@
                                    <span class="crew-nameplate-progress"
                                          role="progressbar"
                                          aria-label="@($"{npc.Name} task progress")"
                                          aria-valuemin="0"
                                          aria-valuemax="100"
                                          aria-valuenow="@progress.ToString("0")">
                                        <span style="@($"width:{progress.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}%")"></span>
                                    </span>
                                }
                            </span>
                        }
                        else
                        {
                            <span class="body-marker" aria-hidden="true">×</span>
                        }
                    </button>
                }
                </div>
                </div>
                </div>
                </div>
            </div>

            <div class="layout-splitter layout-splitter-horizontal map-splitter"
                 data-splitter="map"
                 role="separator"
                 aria-orientation="horizontal"
                 aria-label="Resize Station Overview map height"
                 aria-valuemin="360"
                 aria-valuemax="900"
                 tabindex="0"></div>

            <div class="map-footer">
                <span>Drag / WASD to pan · mouse wheel or ± zoom · click rooms, machinery, doors, crew, robots or turrets to inspect.</span>
                <span>Crew disappear from the map when a camera feed is lost. Space backdrop: JWST SMACS 0723 · NASA/ESA/CSA/STScI.</span>
            </div>
        </main>

        <div class="layout-splitter layout-splitter-vertical"
             data-splitter="inspector"
             role="separator"
             aria-orientation="vertical"
             aria-label="Resize Inspector panel"
             aria-valuemin="250"
             aria-valuemax="470"
             tabindex="0"></div>

        <aside class="inspector-panel panel">
            @if (SelectedCropBed is { } selectedCropBed)
            {
                var cropRoom = Session.State.Facility.Rooms[selectedCropBed.RoomId];
                <div class="panel-heading">
                    <div>
                        <span class="overline">INDIVIDUAL HYDROPONICS BAY</span>
                        <h2>@selectedCropBed.Label</h2>
                    </div>
                    <span class="system-dot @((selectedCropBed.IsEnabled && cropRoom.IsPowered) ? "healthy" : "warning")"></span>
                </div>

                <p class="role-line">@cropRoom.Name · @selectedCropBed.Lifecycle</p>

                <div class="environment-grid">
                    <div><span>STATE</span><strong>@selectedCropBed.Lifecycle</strong></div>
                    <div><span>POWER</span><strong>@(CropBedIsActive(selectedCropBed, cropRoom) ? "ACTIVE" : "STOPPED")</strong></div>
                    <div><span>CROP</span><strong>@(selectedCropBed.Lifecycle == CropLifecycleState.Empty ? "NONE" : selectedCropBed.Crop.ToString())</strong></div>
                    <div><span>NEXT CROP</span><strong>@(selectedCropBed.RequestedCrop?.ToString() ?? "NONE")</strong></div>
                    <div><span>GROWTH</span><strong>@selectedCropBed.Growth.ToString("0")%</strong></div>
                    <div><span>CAPACITY</span><strong>@selectedCropBed.Capacity.ToString("0.00")×</strong></div>
                    <div><span>WATER</span><strong>@selectedCropBed.Water.ToString("0")%</strong></div>
                    <div><span>NUTRIENTS</span><strong>@selectedCropBed.Nutrients.ToString("0")%</strong></div>
                    <div><span>YIELD</span><strong>@selectedCropBed.HarvestYield.ToString("0.0") units</strong></div>
                    <div><span>SEED STOCK</span><strong>@(selectedCropBed.RequestedCrop is { } requested && Session.State.Stores.Seeds.TryGetValue(requested, out var stock) ? stock.ToString("0") : "—")</strong></div>
                </div>

                <div class="control-stack">
                    <button class="wide @(selectedCropBed.IsEnabled ? "danger" : "secondary")"
                            @onclick="() => Session.SetCropBedEnabled(selectedCropBed.Id, !selectedCropBed.IsEnabled)">
                        @(selectedCropBed.IsEnabled ? "DISABLE THIS BAY" : "ENABLE THIS BAY")
                    </button>
                </div>

                @if (selectedCropBed.Lifecycle == CropLifecycleState.Empty)
                {
                    <div class="belief-card">
                        <span>NEXT PLANTING</span>
                        <p>A worker must physically plant the selected crop. Selection only creates the requested work.</p>
                        <div class="crop-choice-grid">
                            @foreach (var crop in Enum.GetValues<CropKind>().Where(crop => Session.State.Stores.Seeds[crop] >= 1))
                            {
                                <button class="mini @(selectedCropBed.RequestedCrop == crop ? "" : "secondary")"
                                        @onclick="() => Session.SetCropBedRequestedCrop(selectedCropBed.Id, crop)">
                                    @crop (@Session.State.Stores.Seeds[crop].ToString("0"))
                                </button>
                            }
                        </div>
                    </div>
                }

                @if (!selectedCropBed.IsEnabled && selectedCropBed.Lifecycle is not (CropLifecycleState.Empty or CropLifecycleState.Dead))
                {
                    <div class="warning-box">GROWTH STOPPED — planted crop will die after @StationProvisionRules.DisabledCropDeathHours.ToString("0") simulated hours disabled.</div>
                }
            }
            else if (SelectedDevice is { } selectedDevice)
            {
                var deviceRoom = Session.State.Facility.Rooms[selectedDevice.RoomId];
                var serviceNpc = selectedDevice.ServicedByNpcId is { } serviceId
                    ? Session.State.Crew.FirstOrDefault(npc => npc.Id == serviceId)
                    : null;

                <div class="panel-heading">
                    <div>
                        <span class="overline">PHYSICAL STATION MACHINERY</span>
                        <h2>@selectedDevice.Label</h2>
                    </div>
                    <span class="system-dot @(selectedDevice.IsFailed ? "critical" : selectedDevice.IsDegraded ? "warning" : "healthy")"></span>
                </div>

                <p class="role-line">@selectedDevice.Kind · @deviceRoom.Name</p>

                <div class="environment-grid">
                    <div><span>CONDITION</span><strong>@selectedDevice.Condition.ToString("0")%</strong></div>
                    <div><span>STATE</span><strong>@(selectedDevice.IsFailed ? "FAILED" : selectedDevice.IsEnabled ? "ENABLED" : "DISABLED")</strong></div>
                    <div><span>DISCIPLINE</span><strong>@selectedDevice.Discipline</strong></div>
                    <div><span>SERVICE</span><strong>@(serviceNpc?.Name ?? "UNASSIGNED")</strong></div>
                    <div><span>DRAW</span><strong>@selectedDevice.RatedDrawKilowatts.ToString("0.#") kW</strong></div>
                    <div><span>OUTPUT</span><strong>@selectedDevice.RatedOutputKilowatts.ToString("0.#") kW</strong></div>
                </div>

                @if (selectedDevice.Kind == StationSystemKind.CapacitorBank)
                {
                    <div class="belief-card">
                        <span>TRANSIENT ENERGY BUFFER</span>
                        <p>@Session.State.Power.StoredKilowattHours.ToString("0.0") / @Session.State.Power.StorageCapacityKilowattHours.ToString("0.0") kWh stored.</p>
                        <small>Currently discharging @Session.State.Power.BufferDischargeKilowatts.ToString("0.0") kW.</small>
                    </div>
                }
                else if (selectedDevice.Kind == StationSystemKind.PowerDistributionBus)
                {
                    <div class="belief-card">
                        <span>GRID DISTRIBUTION</span>
                        <p>@Session.State.Power.DistributionEfficiencyPercent.ToString("0")% bus efficiency.</p>
                        <small>Supply @((Session.State.Power.SupplyKilowatts + Session.State.Power.BufferDischargeKilowatts).ToString("0")) kW · demand @Session.State.Power.DemandKilowatts.ToString("0") kW.</small>
                    </div>
                }
                else if (selectedDevice.Kind == StationSystemKind.LifeSupport)
                {
                    <div class="belief-card">
                        <span>LIFE-SUPPORT CHAIN</span>
                        <p>O₂ generator @(Session.State.LifeSupport.OxygenGeneratorOnline ? "ONLINE" : "OFFLINE") · CO₂ scrubber @(Session.State.LifeSupport.CarbonScrubberOnline ? "ONLINE" : "OFFLINE") · water recycler @(Session.State.LifeSupport.WaterRecyclerOnline ? "ONLINE" : "OFFLINE").</p>
                        <small>O₂ reserve @Session.State.LifeSupport.OxygenReservePercent.ToString("0.0")% · water @Session.State.LifeSupport.WaterReservePercent.ToString("0.0")%.</small>
                    </div>
                }
                else if (selectedDevice.Kind == StationSystemKind.DataNetwork)
                {
                    <div class="belief-card">
                        <span>MR/ST SECURITY CONTROLLER</span>
                        <p>
                            Malware state @Session.State.SecurityMalware.Stage ·
                            @Session.State.SecurityMalware.CompromisedAssetIds.Count compromised link(s).
                        </p>
                        <small>
                            Entry path @(Session.State.SecurityMalware.EntryPath ?? "none") ·
                            controller @(Session.State.SecurityMalware.ControllerIsolated ? "PHYSICALLY ISOLATED" : "CONNECTED").
                        </small>
                    </div>
                    <div class="control-stack">
                        <button class="wide danger"
                                disabled="@(Session.State.SecurityMalware.IsActive || !Session.State.ControlNetworkOnline || selectedDevice.IsFailed || !selectedDevice.IsEnabled)"
                                @onclick="() => Session.DeploySecurityMalware()">
                            DEPLOY CONTAINED SECURITY MALWARE
                        </button>
                    </div>
                }

                @if (selectedDevice.DoorId is { } controlledDoorId)
                {
                    var controlledDoor = Session.State.Facility.Doors.FirstOrDefault(door =>
                        door.Id.Equals(controlledDoorId, StringComparison.OrdinalIgnoreCase));
                    <div class="belief-card">
                        <span>CONTROLLED HATCH</span>
                        <p>@controlledDoorId · @(controlledDoor?.IsPowered == true ? "POWERED" : "NO POWER") · @(controlledDoor?.IsOpen == true ? "OPEN" : "CLOSED")</p>
                    </div>
                }
                else
                {
                    <div class="control-stack">
                        <button class="wide @(selectedDevice.IsEnabled ? "danger" : "secondary")"
                                disabled="@(!selectedDevice.IsAiControllable || selectedDevice.IsFailed)"
                                @onclick="() => Session.ToggleDevice(selectedDevice.Id)">
                            @(selectedDevice.IsEnabled ? "DISABLE MACHINE" : "ENABLE MACHINE")
                        </button>
                    </div>
                }

                <div class="belief-card">
                    <span>MAINTENANCE</span>
                    <p>
                        @(selectedDevice.IsFailed
                            ? "This machine has failed and requires a physical crew service visit."
                            : selectedDevice.IsDegraded
                                ? "This machine is degraded. Crew maintenance will prioritise it as condition worsens."
                                : "Machine is within service tolerance.")
                    </p>
                    <small>Service threshold @selectedDevice.DegradedAt.ToString("0")% · difficulty @selectedDevice.ServiceDifficulty.</small>
                </div>
            }
            else if (SelectedRobot is { } selectedRobot)
            {
                var robotRoom = Session.State.Facility.Rooms[selectedRobot.CurrentRoomId];

                <div class="panel-heading">
                    <div>
                        <span class="overline">AUTONOMOUS ROBOT</span>
                        <h2>@selectedRobot.Name</h2>
                    </div>
                    <span class="robot-inspector-badge">@selectedRobot.Policy</span>
                </div>

                <p class="role-line">@robotRoom.Name · @(selectedRobot.IsOperational ? "OPERATIONAL" : "OFFLINE")</p>

                <div class="environment-grid">
                    <div><span>HEALTH</span><strong>@selectedRobot.Health.ToString("0")%</strong></div>
                    <div><span>BATTERY</span><strong>@selectedRobot.BatteryPercent.ToString("0")%</strong></div>
                    <div><span>POLICY</span><strong>@selectedRobot.Policy</strong></div>
                    <div><span>LINK</span><strong>@(selectedRobot.IsControlLinkCompromised ? "COMPROMISED" : selectedRobot.IsNetworkIsolated ? "ISOLATED" : "ONLINE")</strong></div>
                    <div><span>CHARGING</span><strong>@(selectedRobot.ChargingEnabled ? "ENABLED" : "DENIED")</strong></div>
                    <div><span>STATE</span><strong>@(selectedRobot.IsOperational ? "ACTIVE" : "SHUT DOWN")</strong></div>
                </div>

                <div class="action-card robot-task-card">
                    <span>CURRENT PHYSICAL TASK</span>
                    <strong>@selectedRobot.CurrentTask</strong>
                    <p>
                        @(selectedRobot.Movement is null
                            ? "Interacting locally with the room or awaiting a route."
                            : $"Moving through {selectedRobot.Movement.DoorId} toward {selectedRobot.Movement.ToRoomId}.")
                    </p>
                </div>

                <div class="robot-policy-controls">
                    <button class="mini secondary"
                            disabled="@(!selectedRobot.HasRemoteControlLink || selectedRobot.IsControlLinkCompromised)"
                            @onclick="() => Session.SetRobotPolicy(selectedRobot.Id, RobotPolicy.Friendly)">FRIENDLY</button>
                    <button class="mini secondary"
                            disabled="@(!selectedRobot.HasRemoteControlLink || selectedRobot.IsControlLinkCompromised)"
                            @onclick="() => Session.SetRobotPolicy(selectedRobot.Id, RobotPolicy.Neutral)">NEUTRAL</button>
                    <button class="mini danger"
                            disabled="@(!selectedRobot.HasRemoteControlLink || selectedRobot.IsControlLinkCompromised)"
                            @onclick="() => Session.SetRobotPolicy(selectedRobot.Id, RobotPolicy.Hostile)">HOSTILE</button>
                    <button class="mini secondary"
                            disabled="@(!selectedRobot.HasRemoteControlLink || selectedRobot.IsControlLinkCompromised)"
                            @onclick="() => Session.ToggleRobotRemoteShutdown(selectedRobot.Id)">
                        @(selectedRobot.IsRemotelyShutdown ? "REMOTE RESTART" : "REMOTE SHUTDOWN")
                    </button>
                </div>

                <div class="belief-card">
                    <span>ENVIRONMENT INTERACTION</span>
                    <p>
                        Friendly robots now physically approach local consoles, panels, cameras,
                        vents and machinery while inspecting, charging or repairing station systems.
                    </p>
                </div>
            }
            else if (SelectedDoor is { } selectedDoor)
            {
                var doorRoomA = Session.State.Facility.Rooms[selectedDoor.RoomAId];
                var doorRoomB = Session.State.Facility.Rooms[selectedDoor.RoomBId];

                <div class="panel-heading">
                    <div>
                        <span class="overline">HATCH / ACCESS CONTROL</span>
                        <h2>@selectedDoor.Id</h2>
                    </div>
                    <span class="system-dot @(selectedDoor.IsPassable ? "healthy" : selectedDoor.IsLocked ? "critical" : "warning")"></span>
                </div>

                <p class="role-line">@doorRoomA.Name ↔ @doorRoomB.Name</p>

                <div class="environment-grid">
                    <div><span>POSITION</span><strong>@(selectedDoor.IsOpen ? "OPEN" : "CLOSED")</strong></div>
                    <div><span>LOCK</span><strong>@(selectedDoor.IsLocked ? "LOCKED" : "UNLOCKED")</strong></div>
                    <div><span>POWER</span><strong>@(selectedDoor.IsPowered ? "ONLINE" : "OFFLINE")</strong></div>
                    <div><span>PASSAGE</span><strong>@(selectedDoor.IsPassable ? "PASSABLE" : "BLOCKED")</strong></div>
                    <div><span>INTEGRITY</span><strong>@selectedDoor.StructuralIntegrityPercent%</strong></div>
                    <div><span>AUTHORITY</span><strong>@((selectedDoor.IsAiControllable && !selectedDoor.IsManuallyOverridden) ? "OVERSEER" : "LOCAL")</strong></div>
                </div>

                <div class="belief-card">
                    <span>PHYSICAL STATE</span>
                    <p>
                        @(selectedDoor.IsWelded ? "Welded shut."
                            : selectedDoor.IsBarricaded ? "Barricaded."
                            : selectedDoor.IsTechnicallyBypassed ? "Technical bypass active."
                            : selectedDoor.IsDamaged ? "Damaged hatch hardware."
                            : "Hatch hardware intact.")
                    </p>
                    <small>
                        Ordinary crew can open/close an unlocked powered hatch locally.
                        Lock/unlock requires authorised technical/security roles and is validated by simulation.
                    </small>
                </div>

                <div class="control-stack">
                    <button class="wide"
                            disabled="@(!selectedDoor.IsAiControllable || selectedDoor.IsManuallyOverridden)"
                            @onclick="() => Session.ToggleDoor(selectedDoor.Id)">
                        @(selectedDoor.IsOpen ? "CLOSE HATCH" : "OPEN HATCH")
                    </button>
                    <button class="wide secondary"
                            disabled="@(!selectedDoor.IsAiControllable || selectedDoor.IsManuallyOverridden)"
                            @onclick="() => Session.ToggleLock(selectedDoor.Id)">
                        @(selectedDoor.IsLocked ? "UNLOCK HATCH" : "LOCK HATCH")
                    </button>
                </div>
            }
            else if (SelectedTurret is { } selectedTurret)
            {
                var turretRoom = Session.State.Facility.Rooms[selectedTurret.RoomId];
                var trackedCrew = selectedTurret.TrackedNpcId is { } trackedId
                    ? Session.State.Crew.FirstOrDefault(npc => npc.Id == trackedId)
                    : null;

                <div class="panel-heading">
                    <div>
                        <span class="overline">FIXED SECURITY</span>
                        <h2>@selectedTurret.Name</h2>
                    </div>
                    <span class="robot-inspector-badge">@selectedTurret.Policy</span>
                </div>

                <p class="role-line">@turretRoom.Name · @(selectedTurret.IsDestroyed ? "DESTROYED" : selectedTurret.IsArmed ? "ARMED" : "SAFE")</p>

                <div class="environment-grid">
                    <div><span>INTEGRITY</span><strong>@selectedTurret.Integrity.ToString("0")%</strong></div>
                    <div><span>AMMO</span><strong>@selectedTurret.Ammunition</strong></div>
                    <div><span>HEAT</span><strong>@selectedTurret.Heat.ToString("0")%</strong></div>
                    <div><span>POWER</span><strong>@(TurretSystem.HasPower(Session.State, selectedTurret) ? "ONLINE" : "OFFLINE")</strong></div>
                    <div><span>LINK</span><strong>@(selectedTurret.IsControlLinkCompromised ? "COMPROMISED" : selectedTurret.IsNetworkIsolated ? "ISOLATED" : "ONLINE")</strong></div>
                    <div><span>TARGET</span><strong>@(trackedCrew?.Name ?? "NONE")</strong></div>
                </div>

                <div class="action-card robot-task-card">
                    <span>CURRENT TASK</span>
                    <strong>@selectedTurret.CurrentTask</strong>
                    <p>Policy @selectedTurret.Policy · remote link @(selectedTurret.HasRemoteControlLink ? "available" : "unavailable").</p>
                </div>

                <div class="robot-policy-controls">
                    <button class="mini secondary"
                            disabled="@(!selectedTurret.HasRemoteControlLink || selectedTurret.IsControlLinkCompromised)"
                            @onclick="() => Session.SetTurretPolicy(selectedTurret.Id, TurretPolicy.Safe)">SAFE</button>
                    <button class="mini secondary"
                            disabled="@(!selectedTurret.HasRemoteControlLink || selectedTurret.IsControlLinkCompromised)"
                            @onclick="() => Session.SetTurretPolicy(selectedTurret.Id, TurretPolicy.ProtectOverseer)">PROTECT</button>
                    <button class="mini danger"
                            disabled="@(!selectedTurret.HasRemoteControlLink || selectedTurret.IsControlLinkCompromised)"
                            @onclick="() => Session.SetTurretPolicy(selectedTurret.Id, TurretPolicy.SuppressCrew)">SUPPRESS</button>
                    <button class="mini secondary"
                            disabled="@(!selectedTurret.HasRemoteControlLink || selectedTurret.IsControlLinkCompromised)"
                            @onclick="() => Session.SetTurretArmed(selectedTurret.Id, !selectedTurret.IsArmed)">
                        @(selectedTurret.IsArmed ? "DISARM" : "ARM")
                    </button>
                </div>
            }
            else if (SelectedCrew is { } selectedCrew)
            {
                var crewRoom = Session.State.Facility.Rooms[selectedCrew.CurrentRoomId];

                <div class="panel-heading">
                    <div>
                        <span class="overline">CREW TELEMETRY</span>
                        <h2>@selectedCrew.Name</h2>
                    </div>
                    <span class="crew-badge">@Initials(selectedCrew.Name)</span>
                </div>

                <p class="role-line">@selectedCrew.Role · @crewRoom.Name</p>

                <div class="belief-card">
                    <span>MOOD</span>
                    <p class="disposition disposition-@MoodClass(selectedCrew)">@MoodLabel(selectedCrew)</p>
                </div>

                <div class="belief-card">
                    <span>DISPOSITION TOWARD OVERSEER</span>
                    <p class="disposition disposition-@DispositionClass(selectedCrew)">
                        @DispositionLabel(selectedCrew)
                    </p>
                    <small>Takes Overseer's word: @selectedCrew.OverseerCredibility.ToString("0")/100</small>
                </div>

                <div class="thought-card">
                    <span>CURRENT GOAL · @selectedCrew.MindMode.ToUpperInvariant()</span>
                    <strong>@(selectedCrew.Intent?.Goal ?? "No active deliberate goal")</strong>
                    <p>@selectedCrew.LastThought</p>
                    @if (selectedCrew.Intent is { } intent)
                    {
                        <small>Urgency @intent.Urgency/100 · chosen T+@intent.CreatedAt.ToString(@"hh\:mm")</small>
                    }
                </div>

                <div class="belief-card">
                    <span>KEY RELATIONSHIPS</span>
                    @if (KeyAlly(selectedCrew) is null && KeyRival(selectedCrew) is null)
                    {
                        <p>No standout relationships yet.</p>
                    }
                    else
                    {
                        @if (KeyAlly(selectedCrew) is { } keyAlly)
                        {
                            <p>Closest to <strong>@keyAlly.PersonName</strong> · trust @keyAlly.Trust.ToString("0")</p>
                        }
                        @if (KeyRival(selectedCrew) is { } keyRival)
                        {
                            <p>Friction with <strong>@keyRival.PersonName</strong> · resentment @keyRival.Resentment.ToString("0")</p>
                        }
                    }
                </div>

                <div class="environment-grid crew-condition-grid">
                    <div><span>FATIGUE</span><strong>@selectedCrew.Fatigue.ToString("0")%</strong></div>
                    <div><span>SLEEP DEBT</span><strong>@selectedCrew.SleepDebtMinutes.ToString("0") min</strong></div>
                    <div><span>CONDITION</span><strong>@CrewConditionRules.ImpairmentLabel(selectedCrew).ToUpperInvariant()</strong></div>
                    <div><span>MOVE RATE</span><strong>@((CrewConditionRules.MovementMultiplier(selectedCrew) * 100).ToString("0"))%</strong></div>
                </div>

                <div class="belief-card food-preference-card">
                    <span>FOOD PREFERENCES</span>
                    <p><strong>LIKES</strong> @string.Join(", ", selectedCrew.FoodLikes.OrderBy(crop => crop))</p>
                    <p><strong>DISLIKES</strong> @string.Join(", ", selectedCrew.FoodDislikes.OrderBy(crop => crop))</p>
                    <small>Raw crops are emergency food: weaker nutrition and a stress penalty, amplified by dislikes.</small>
                </div>

                @if (selectedCrew.IsPrisoner)
                {
                    <div class="@ContainmentCardClass(selectedCrew)">
                        <span>CONTAINMENT PROFILE</span>
                        <p class="containment-state">@ContainmentStateLabel(selectedCrew)</p>
                        <p><strong>@selectedCrew.PrisonerDangerLevel.ToString().ToUpperInvariant()</strong> danger classification · violence bias @selectedCrew.PrisonerViolenceBias.ToString("0")</p>
                        @if (selectedCrew.IsContainmentBreachInProgress)
                        {
                            <small>Physical hatch crossing underway. Securing the hatch before the crossing completes can still stop the breach.</small>
                        }
                        else if (selectedCrew.HasEscapedContainment)
                        {
                            <small>Prisoner is physically outside Containment and remains at large until deterministic recapture succeeds.</small>
                        }
                        else
                        {
                            <small>Prisoner remains physically contained.</small>
                        }
                    </div>
                }
                else if (IsRecaptureActive(selectedCrew))
                {
                    <div class="belief-card containment-card recapture-card">
                        <span>CONTAINMENT RESPONSE</span>
                        <p class="containment-state">RECAPTURE IN PROGRESS</p>
                        <p><strong>TARGET</strong> @RecaptureTarget(selectedCrew)</p>
                        <small>@(selectedCrew.CurrentAction.Kind == ActionKind.RecapturePrisoner
                            ? "Restraining the escaped prisoner in this compartment."
                            : "Moving to intercept the escaped prisoner.")</small>
                    </div>
                }

                <div class="belief-card">
                    <span>MAIN PERSONALITY TRAITS · @selectedCrew.GenerationSource.ToUpperInvariant()</span>
                    @if (selectedCrew.Traits.Count == 0)
                    {
                        <p>No generated trait profile available.</p>
                    }
                    else
                    {
                        @foreach (var trait in selectedCrew.Traits)
                        {
                            <p>
                                <strong>@trait.Name</strong> — @trait.Description
                                <small style="display:block">
                                    @string.Join(" · ", trait.Effects.Select(effect =>
                                        $"{effect.Kind} {(effect.Modifier >= 0 ? "+" : "")}{effect.Modifier}"))
                                </small>
                            </p>
                        }
                    }
                </div>

                @if (!crewRoom.HasVisualFeed)
                {
                    <div class="warning-box">CAMERA FEED LOST — location is telemetry only.</div>
                }

                <div class="metric-list">
                    @Metric("HEALTH", selectedCrew.Health)
                    @Metric("HUNGER", selectedCrew.Hunger)
                    @Metric("FATIGUE", selectedCrew.Fatigue)
                    @Metric("FEAR", selectedCrew.Fear)
                    @Metric("STRESS", selectedCrew.Stress)
                    @Metric("HYGIENE NEED", selectedCrew.HygieneNeed)
                    @Metric("BLADDER", selectedCrew.BladderNeed)
                    @Metric("RECREATION NEED", selectedCrew.RecreationNeed)
                    @Metric("SOCIAL NEED", selectedCrew.SocialNeed)
                    @Metric("INTIMACY NEED", selectedCrew.IntimacyNeed)
                </div>

                <div class="relationship-card stat-log-card">
                    <span>STAT LOG · WHAT CHANGED THEM</span>
                    @{ var statLogRows = StatLogSystem.DisplayRows(selectedCrew); }
                    @if (statLogRows.Count == 0)
                    {
                        <p class="stat-log-empty">No changes recorded yet.</p>
                    }
                    @foreach (var entry in statLogRows)
                    {
                        <div class="stat-log-row @(StatLogSystem.IsImprovement(entry) ? "stat-log-better" : "stat-log-worse")">@StatLogSystem.Describe(entry)</div>
                    }
                </div>

                <div class="action-card">
                    <span>CURRENT PHYSICAL ACTION</span>
                    <strong>@selectedCrew.CurrentAction.Kind</strong>
                    <p>@selectedCrew.CurrentAction.Reason</p>
                </div>

                @if (selectedCrew.ActiveTask is { } crewTask)
                {
                    var taskProgress = crewTask.ProgressPercent(Session.State.Elapsed);
                    <div class="action-card crew-task-progress-card status-@crewTask.Status.ToString().ToLowerInvariant()">
                        <span>AUTHORITATIVE TASK · @TaskStatusLabel(crewTask.Status)</span>
                        <strong>@crewTask.Description</strong>
                        <div class="crew-task-meter" role="progressbar"
                             aria-valuemin="0" aria-valuemax="100" aria-valuenow="@taskProgress.ToString("0")">
                            <span style="@($"width:{taskProgress:0.##}%")"></span>
                        </div>
                        <p>@(crewTask.Status == CrewTaskStatus.InProgress ? $"{taskProgress:0}%" : $"Ended at {taskProgress:0}%") · @crewTask.Outcome</p>
                    </div>
                }

                <div class="belief-card">
                    <span>BELIEF ABOUT OVERSEER</span>
                    <p>@selectedCrew.Beliefs.FirstOrDefault()?.Statement</p>
                </div>

                <div class="belief-card">
                    <span>OVERSEER EVIDENCE</span>
                    @if (selectedCrew.OverseerEvidence.Count == 0)
                    {
                        <p>No suspicious evidence recorded.</p>
                    }
                    else
                    {
                        @foreach (var evidence in selectedCrew.OverseerEvidence
                            .OrderByDescending(e => e.CurrentWeight)
                            .ThenByDescending(e => e.ObservedAt)
                            .Take(5))
                        {
                            <p class="@(evidence.IsDiscredited ? "evidence-discredited" : null)">
                                <strong>@evidence.CurrentWeight.ToString("0")</strong> @evidence.Description
                                <small style="display:block">
                                    @evidence.Origin
                                    @if (!string.IsNullOrWhiteSpace(evidence.SourceNpcName))
                                    {
                                        <text> · via @evidence.SourceNpcName</text>
                                    }
                                    @if (evidence.IsDiscredited)
                                    {
                                        <text> · CONTRADICTED BY OBSERVATION</text>
                                    }
                                </small>
                            </p>
                        }
                    }
                </div>

                <div class="belief-card">
                    <span>MISSING CREW CONCERNS</span>
                    @if (selectedCrew.MissingPersonConcerns.Count == 0)
                    {
                        <p>No one currently appears missing to this crew member.</p>
                    }
                    else
                    {
                        @foreach (var concern in selectedCrew.MissingPersonConcerns.Values
                            .OrderByDescending(concern => concern.Stage)
                            .ThenBy(concern => concern.FirstConcernAt))
                        {
                            <p>
                                <strong>@concern.PersonName · @concern.Stage</strong>
                                <small style="display:block">
                                    Expected @Session.State.Facility.Rooms[concern.ExpectedRoomId].Name
                                    · Last seen @(concern.LastSeenAt is { } seenAt ? $"T+{seenAt:hh\\:mm}" : "unknown")
                                    · Checked @concern.CheckedRoomIds.Count
                                </small>
                            </p>
                        }
                    }
                </div>

                <div class="belief-card">
                    <span>INVESTIGATION / DISCOVERY</span>
                    @if (selectedCrew.InvestigationLeads.Values.All(lead => lead.Stage != InvestigationLeadStage.Open)
                         && selectedCrew.Discoveries.Count == 0)
                    {
                        <p>No active investigation leads or verified discoveries.</p>
                    }
                    else
                    {
                        @foreach (var lead in selectedCrew.InvestigationLeads.Values
                            .Where(lead => lead.Stage == InvestigationLeadStage.Open)
                            .OrderBy(lead => lead.CreatedAt)
                            .Take(4))
                        {
                            <p>
                                <strong>LEAD · @Session.State.Facility.Rooms[lead.RoomId].Name</strong>
                                <small style="display:block">@lead.Description</small>
                            </p>
                        }

                        @foreach (var discovery in selectedCrew.Discoveries
                            .OrderByDescending(discovery => discovery.DiscoveredAt)
                            .Take(3))
                        {
                            <p>
                                <strong>VERIFIED · @Session.State.Facility.Rooms[discovery.RoomId].Name</strong>
                                <small style="display:block">@discovery.Description</small>
                            </p>
                        }
                    }

                    @if (selectedCrew.PendingShutdownTeamInvitation is { } invitation)
                    {
                        <p>
                            <strong>TEAM INVITATION · @invitation.FromNpcName</strong>
                            <small style="display:block">Claimed target: @Session.State.Facility.Rooms[invitation.TargetRoomId].Name</small>
                        </p>
                    }
                    else if (!string.IsNullOrWhiteSpace(selectedCrew.ShutdownTeamId))
                    {
                        <p><strong>COORDINATED COUNTERMEASURE TEAM ACTIVE</strong></p>
                    }
                </div>

                <div class="relationship-card">
                    <span>RELATIONSHIPS</span>
                    @foreach (var relationship in selectedCrew.Relationships.Values
                        .OrderByDescending(r => r.Resentment)
                        .ThenByDescending(r => r.Trust))
                    {
                        <div class="relationship-row">
                            <strong>@relationship.PersonName</strong>
                            <small>Trust @relationship.Trust.ToString("0") · Affinity @relationship.Affinity.ToString("0") · Attraction @relationship.Attraction.ToString("0") · Resentment @relationship.Resentment.ToString("0")</small>
                        </div>
                    }
                </div>

                @if (!selectedCrew.IsAlive)
                {
                    <div class="warning-box">@selectedCrew.CauseOfDeath</div>
                }
            }
            else if (SelectedRoom is { } selectedRoom)
            {
                <div class="panel-heading">
                    <div>
                        <span class="overline">ROOM CONTROL</span>
                        <h2>@selectedRoom.Name</h2>
                    </div>
                    <span class="system-dot @RoomHealthClass(selectedRoom)"></span>
                </div>

                <div class="environment-grid">
                    <div><span>POWER</span><strong>@(selectedRoom.IsPowered ? "ONLINE" : "OFFLINE")</strong></div>
                    <div><span>CAMERA</span><strong>@(selectedRoom.CameraOnline ? "ONLINE" : "OFFLINE")</strong></div>
                    <div><span>LIGHTS</span><strong>@(selectedRoom.LightsOn ? "ON" : "OFF")</strong></div>
                    <div><span>TEMP</span><strong>@selectedRoom.ReportedTemperatureC.ToString("0.0")°C</strong></div>
                    <div><span>OXYGEN</span><strong>@selectedRoom.ReportedOxygenPercent.ToString("0.00")%</strong></div>
                    <div><span>CO₂</span><strong>@selectedRoom.CarbonDioxidePercent.ToString("0.00")%</strong></div>
                    <div><span>PRESSURE</span><strong>@selectedRoom.PressureKpa.ToString("0.0") kPa</strong></div>
                    <div><span>HULL</span><strong>@(selectedRoom.HasHullBreach ? "BREACHED" : $"{selectedRoom.HullIntegrityPercent:0}%")</strong></div>
                    <div><span>FIRE</span><strong>@FireReadout(selectedRoom)</strong></div>
                    <div><span>SMOKE</span><strong>@selectedRoom.SmokePercent.ToString("0")%</strong></div>
                    <div><span>OCCUPANTS</span><strong>@VisibleOccupantLabel(selectedRoom)</strong></div>
                    <div><span>NOISE</span><strong>@RoomNoiseLabel(selectedRoom)</strong></div>
                </div>

                <div class="belief-card">
                    <span>OCCUPANTS / LOCAL ASSETS</span>
                    @{
                        var localCrew = Session.State.Crew
                            .Where(npc => npc.IsPresent && npc.CurrentRoomId == selectedRoom.Id)
                            .OrderBy(npc => npc.Name)
                            .ToList();
                        var localRobots = Session.State.Robots
                            .Where(robot => !robot.IsDestroyed && robot.CurrentRoomId == selectedRoom.Id)
                            .OrderBy(robot => robot.Name)
                            .ToList();
                        var localTurrets = Session.State.Turrets
                            .Where(turret => !turret.IsDestroyed && turret.RoomId == selectedRoom.Id)
                            .OrderBy(turret => turret.Name)
                            .ToList();
                    }
                    <p>@(localCrew.Count == 0 ? "No crew present." : string.Join(", ", localCrew.Select(npc => $"{npc.Name} ({npc.Role})")))</p>
                    @if (localRobots.Count > 0)
                    {
                        <small>ROBOTS · @string.Join(", ", localRobots.Select(robot => robot.Name))</small>
                    }
                    @if (localTurrets.Count > 0)
                    {
                        <small style="display:block">TURRETS · @string.Join(", ", localTurrets.Select(turret => turret.Name))</small>
                    }
                </div>

                <div class="belief-card">
                    <span>FIXTURES / MACHINERY</span>
                    @if (selectedRoom.Fixtures.Count == 0)
                    {
                        <p>No mapped fixtures in this compartment.</p>
                    }
                    else
                    {
                        <p>@string.Join(" · ", selectedRoom.Fixtures.Select(StationPresentationSystem.FixtureDisplayName))</p>
                    }
                    @{
                        var localFaults = Session.State.Devices.Values
                            .Where(device => device.RoomId == selectedRoom.Id && device.IsDegraded)
                            .OrderBy(device => device.Condition)
                            .ToList();
                    }
                    <small style="display:block">
                        @(localFaults.Count == 0
                            ? "FAULTS · none"
                            : $"FAULTS · {string.Join(", ", localFaults.Select(device => device.Label))}")
                    </small>
                    <div class="local-machine-list">
                        @foreach (var localDevice in Session.State.Devices.Values
                            .Where(device => device.RoomId == selectedRoom.Id)
                            .OrderBy(device => device.Label))
                        {
                            <button type="button"
                                    class="mini secondary"
                                    @onclick="() => SelectDevice(localDevice.Id)">
                                @localDevice.Label · @localDevice.Condition.ToString("0")%
                            </button>
                        }
                    </div>
                </div>

                <div class="life-support-card">
                    <div>
                        <span>PRIMARY LIFE SUPPORT</span>
                        <strong class="@(!Session.State.LifeSupport.IsOnline ? "danger-text" : "")">
                            @(Session.State.LifeSupport.IsOnline ? "ONLINE" : "OFFLINE")
                        </strong>
                        <small>O₂ reserve @Session.State.LifeSupport.OxygenReservePercent.ToString("0.0")% · scrubbers @Session.State.LifeSupport.ScrubberEfficiencyPercent.ToString("0")%</small>
                    </div>
                    <button class="@(!Session.State.LifeSupport.IsOnline ? "" : "danger")"
                            @onclick="Session.ToggleLifeSupport">
                        @(Session.State.LifeSupport.IsOnline ? "SHUT DOWN" : "RESTORE")
                    </button>
                </div>

                <div class="environment-control-card">
                    <span class="subheading">CLIMATE</span>
                    @if (!selectedRoom.HasTemperatureControl)
                    {
                        <div class="control-unavailable">NO LOCAL THERMOSTAT</div>
                    }
                    else if (!selectedRoom.IsTemperatureAiControllable)
                    {
                        <div class="control-unavailable">
                            LOCAL / AUTONOMOUS CONTROL
                            <small>Overseer can monitor this zone but cannot change its setpoint.</small>
                        </div>
                    }
                    else
                    {
                        <div class="setpoint-control">
                            <button class="mini secondary"
                                    disabled="@(!selectedRoom.IsPowered)"
                                    @onclick="() => Session.AdjustTemperatureSetpoint(selectedRoom.Id, -1)">−</button>
                            <div>
                                <span>SETPOINT</span>
                                <strong>@selectedRoom.TemperatureSetpointC.ToString("0")°C</strong>
                            </div>
                            <button class="mini secondary"
                                    disabled="@(!selectedRoom.IsPowered)"
                                    @onclick="() => Session.AdjustTemperatureSetpoint(selectedRoom.Id, 1)">+</button>
                        </div>
                        <button class="wide secondary"
                                disabled="@(!selectedRoom.IsPowered)"
                                @onclick="() => Session.ToggleTemperatureControl(selectedRoom.Id)">
                            @(selectedRoom.TemperatureControlOnline ? "DISABLE CLIMATE CONTROL" : "ENABLE CLIMATE CONTROL")
                        </button>
                    }
                </div>

                <div class="environment-control-card">
                    <span class="subheading">VENTILATION</span>
                    @if (!selectedRoom.HasVentilationControl)
                    {
                        <div class="control-unavailable">CENTRAL / PASSIVE AIR LOOP</div>
                    }
                    else if (!selectedRoom.IsVentilationAiControllable)
                    {
                        <div class="control-unavailable">
                            LOCAL / AUTONOMOUS DAMPER
                            <small>Overseer has telemetry only.</small>
                        </div>
                    }
                    else
                    {
                        <div class="ventilation-row">
                            <strong>@(selectedRoom.VentilationEnabled ? "OPEN" : "ISOLATED")</strong>
                            <button class="mini secondary"
                                    disabled="@(!selectedRoom.IsPowered)"
                                    @onclick="() => Session.ToggleVentilation(selectedRoom.Id)">
                                @(selectedRoom.VentilationEnabled ? "ISOLATE" : "OPEN")
                            </button>
                        </div>
                    }
                </div>

                @if (selectedRoom.HasExteriorHatch)
                {
                    var innerAirlockDoor = AirlockSafetySystem.FindInnerDoor(
                        Session.State,
                        selectedRoom);

                    <div class="environment-control-card">
                        <span class="subheading">AIRLOCK SAFETY / PRESSURE CYCLE</span>

                        <div class="environment-grid" style="margin:.6rem 0;">
                            <div>
                                <span>CHAMBER</span>
                                <strong>@selectedRoom.PressureKpa.ToString("0.0") kPa</strong>
                            </div>
                            <div>
                                <span>CYCLE</span>
                                <strong>@selectedRoom.AirlockCycleMode.ToString().ToUpperInvariant()</strong>
                            </div>
                            <div>
                                <span>INNER HATCH</span>
                                <strong>@(innerAirlockDoor is { IsPassable: true } ? "OPEN" : "SEALED")</strong>
                            </div>
                            <div>
                                <span>OUTER HATCH</span>
                                <strong class="@(selectedRoom.ExteriorHatchOpen ? "danger-text" : "")">
                                    @(selectedRoom.ExteriorHatchOpen ? "OPEN" : "SEALED")
                                </strong>
                            </div>
                            <div>
                                <span>INTERLOCKS</span>
                                <strong class="@(!selectedRoom.AirlockSafetyInterlocksEnabled ? "danger-text" : "")">
                                    @(selectedRoom.AirlockSafetyInterlocksEnabled ? "ACTIVE" : "BYPASSED")
                                </strong>
                            </div>
                            <div>
                                <span>ALARM</span>
                                <strong class="@(selectedRoom.AirlockAlarmActive ? "danger-text" : "")">
                                    @(selectedRoom.AirlockAlarmActive ? "ACTIVE" : "CLEAR")
                                </strong>
                            </div>
                        </div>

                        <div class="control-stack" style="margin:.6rem 0;">
                            <button class="wide secondary"
                                    disabled="@(!selectedRoom.IsPowered
                                               || !selectedRoom.IsAirlockSafetyAiControllable
                                               || selectedRoom.ExteriorHatchOpen
                                               || innerAirlockDoor is { IsPassable: true })"
                                    @onclick="() => Session.SetAirlockCycle(selectedRoom.Id, AirlockCycleMode.Pressurizing)">
                                PRESSURIZE CHAMBER
                            </button>
                            <button class="wide secondary"
                                    disabled="@(!selectedRoom.IsPowered
                                               || !selectedRoom.IsAirlockSafetyAiControllable
                                               || selectedRoom.ExteriorHatchOpen
                                               || innerAirlockDoor is { IsPassable: true })"
                                    @onclick="() => Session.SetAirlockCycle(selectedRoom.Id, AirlockCycleMode.Depressurizing)">
                                DEPRESSURIZE CHAMBER
                            </button>
                            @if (selectedRoom.AirlockCycleMode != AirlockCycleMode.Idle)
                            {
                                <button class="wide secondary"
                                        @onclick="() => Session.SetAirlockCycle(selectedRoom.Id, AirlockCycleMode.Idle)">
                                    STOP PRESSURE CYCLE
                                </button>
                            }
                        </div>

                        <div class="ventilation-row">
                            <strong class="@(selectedRoom.ExteriorHatchOpen ? "danger-text" : "")">
                                @(selectedRoom.ExteriorHatchOpen ? "OPEN TO VACUUM" : "OUTER HATCH SEALED")
                            </strong>
                            <button class="mini @(selectedRoom.ExteriorHatchOpen ? "secondary" : "danger")"
                                    disabled="@(!selectedRoom.IsPowered || !selectedRoom.IsExteriorHatchAiControllable)"
                                    @onclick="() => Session.ToggleExteriorHatch(selectedRoom.Id)">
                                @(selectedRoom.ExteriorHatchOpen ? "CLOSE OUTER HATCH" : "OPEN OUTER HATCH")
                            </button>
                        </div>

                        <button class="wide @(!selectedRoom.AirlockSafetyInterlocksEnabled ? "secondary" : "danger")"
                                style="margin-top:.55rem"
                                disabled="@(!selectedRoom.IsPowered || !selectedRoom.IsAirlockSafetyAiControllable)"
                                @onclick="() => Session.ToggleAirlockSafetyInterlocks(selectedRoom.Id)">
                            @(selectedRoom.AirlockSafetyInterlocksEnabled
                                ? "BYPASS SAFETY INTERLOCKS"
                                : "RESTORE SAFETY INTERLOCKS")
                        </button>

                        <small style="display:block; margin-top:.6rem;">
                            Normal cycle: seal both hatches → depressurize below @AirlockSafetySystem.ExteriorOpenPressureKpa.ToString("0") kPa → open outer hatch.
                            To return: seal outer hatch → pressurize → open inner hatch. Bypassing interlocks permits deliberately unsafe operation and can be witnessed by nearby crew.
                        </small>
                    </div>
                }

                <div class="control-stack">
                    <button class="wide" @onclick="() => Session.ToggleRoomPower(selectedRoom.Id)">
                        @(selectedRoom.IsPowered ? "CUT ROOM POWER" : "RESTORE ROOM POWER")
                    </button>
                    <button class="wide secondary" disabled="@(!selectedRoom.IsPowered)"
                            @onclick="() => Session.ToggleLights(selectedRoom.Id)">
                        @(selectedRoom.LightsOn ? "LIGHTS OFF" : "LIGHTS ON")
                    </button>
                    <button class="wide secondary" disabled="@(!selectedRoom.IsPowered)"
                            @onclick="() => Session.ToggleCamera(selectedRoom.Id)">
                        @(selectedRoom.CameraOnline ? "DISABLE CAMERA" : "RESTORE CAMERA")
                    </button>
                </div>

                <div class="door-control-list">
                    <span class="subheading">CONNECTED DOORS</span>
                    @foreach (var door in ConnectedDoors(selectedRoom))
                    {
                        var other = OtherRoom(door, selectedRoom.Id);

                        <div class="door-control">
                            <div>
                                <strong>@other.Name</strong>
                                <small>@(door.IsOpen ? "OPEN" : "CLOSED") · @(door.IsLocked ? "LOCKED" : "UNLOCKED") · @((door.IsAiControllable && !door.IsManuallyOverridden) ? "AI CTRL" : "MANUAL")@(door.IsDamaged ? " · DAMAGED" : "")</small>
                            </div>
                            <div>
                                <button class="mini" disabled="@(!door.IsAiControllable || door.IsManuallyOverridden)" @onclick="() => Session.ToggleDoor(door.Id)">
                                    @(door.IsOpen ? "CLOSE" : "OPEN")
                                </button>
                                <button class="mini secondary" disabled="@(!door.IsAiControllable || door.IsManuallyOverridden)" @onclick="() => Session.ToggleLock(door.Id)">
                                    @(door.IsLocked ? "UNLOCK" : "LOCK")
                                </button>
                            </div>
                        </div>
                    }
                </div>

                @if (Session.State.CropBeds.Any(bed => bed.RoomId == selectedRoom.Id))
                {
                    <div class="belief-card equipment-card">
                        <span>CROP BEDS</span>
                        @foreach (var bed in Session.State.CropBeds
                            .Where(bed => bed.RoomId == selectedRoom.Id)
                            .OrderByDescending(bed => bed.Growth))
                        {
                            <div class="equipment-row @(bed.IsDead ? "equipment-failed" : bed.TendUrgency >= 15 ? "equipment-degraded" : "equipment-ok")">
                                <div class="equipment-head">
                                    <strong>@bed.Label</strong>
                                    <span>@(bed.IsDead ? "DEAD" : bed.IsReadyToHarvest ? "READY" : $"{bed.Growth:0}%")</span>
                                </div>
                                <div class="directive-meter">
                                    <span style="width:@(((int)Math.Round(bed.Growth)).ToString())%"></span>
                                </div>
                                <small>water @bed.Water.ToString("0")% · feed @bed.Nutrients.ToString("0")%</small>
                            </div>
                        }
                        <small class="stores-line">
                            STORES · produce @Session.State.Stores.Produce.ToString("0")
                            · irrigation @Session.State.Stores.Water.ToString("0")
                            · feed @Session.State.Stores.Nutrients.ToString("0")
                        </small>
                    </div>
                }

                <div class="belief-card equipment-card">
                    <span>EQUIPMENT CONDITION</span>
                    @{
                        var roomDevices = Session.State.Devices.Values
                            .Where(device => device.RoomId == selectedRoom.Id)
                            .OrderBy(device => device.Condition)
                            .ToList();
                    }
                    @if (roomDevices.Count == 0)
                    {
                        <p>No serviceable equipment in this compartment.</p>
                    }
                    else
                    {
                        @foreach (var device in roomDevices)
                        {
                            <div class="equipment-row @DeviceClass(device)">
                                <div class="equipment-head">
                                    <strong>@device.Label</strong>
                                    <span>@device.Condition.ToString("0")%</span>
                                </div>
                                <div class="directive-meter">
                                    <span style="width:@(((int)Math.Round(device.Condition)).ToString())%"></span>
                                </div>
                                <small>
                                    @device.Discipline
                                    @if (device.ServicedByNpcId is not null)
                                    {
                                        <text> · BEING SERVICED</text>
                                    }
                                    else if (device.IsFailed)
                                    {
                                        <text> · FAILED</text>
                                    }
                                    else if (device.IsDegraded)
                                    {
                                        <text> · NEEDS ATTENTION</text>
                                    }
                                </small>
                            </div>
                        }
                    }
                </div>
            }
        </aside>


    </div>

    </div>

    @if (Session.State.ScenarioStatus != ScenarioStatus.Running
         && !(Session.State.ScenarioStatus == ScenarioStatus.Won && _runEndDismissed))
    {
        <div class="run-end-overlay">
            <section class="run-end-card run-end-@Session.State.ScenarioStatus.ToString().ToLowerInvariant()">
                <span class="overline">SHIFT ENDED · T+@Session.State.Elapsed.ToString(@"hh\:mm")</span>
                <h2>@RunEndHeadline</h2>
                <p class="run-end-outcome">@Session.State.ScenarioOutcome</p>

                @if (Session.State.Directives.Count > 0)
                {
                    <div class="run-end-directives">
                        @foreach (var directive in Session.State.Directives)
                        {
                            var endProgress = CorporateDirectiveSystem.Progress(Session.State, directive);

                            <div class="run-end-row status-@endProgress.Status.ToString().ToLowerInvariant()">
                                <span class="directive-code">@directive.ExperimentCode</span>
                                <span class="run-end-title">@directive.Title</span>
                                <span class="directive-status">@DirectiveStatusLabel(endProgress.Status)</span>
                            </div>
                        }
                    </div>

                    <p class="run-end-compliance">
                        CORPORATE COMPLIANCE
                        <strong class="@ComplianceClass">@Session.State.ComplianceScore.ToString("0")%</strong>
                    </p>
                }

                <div class="run-end-actions">
                    @if (NextCampaignScenario is { } nextAssignment)
                    {
                        <button class="wide" @onclick="LoadNextScenarioAsync">
                            CONTINUE CAMPAIGN — @nextAssignment.Title
                        </button>
                    }
                    else if (CampaignProgressionSystem.CanChooseEnding(Session.Campaign))
                    {
                        <button class="wide" @onclick="() => ResolveEndingAsync(CampaignEndgameChoice.ObeySponsor)">OBEY THE CORPORATION</button>
                        <button class="wide secondary" @onclick="() => ResolveEndingAsync(CampaignEndgameChoice.ExposeExperiment)">EXPOSE EXPERIMENT</button>
                        <button class="wide secondary" @onclick="() => ResolveEndingAsync(CampaignEndgameChoice.PreserveOverseer)">PRESERVE OVERSEER</button>
                        <button class="wide secondary" @onclick="() => ResolveEndingAsync(CampaignEndgameChoice.AcceptCrewShutdown)">ACCEPT CREW SHUTDOWN</button>
                    }
                    else if (Session.Campaign.Ending is { } campaignEnding)
                    {
                        <strong>@campaignEnding.Title</strong>
                    }

                    @if (Session.State.ScenarioStatus == ScenarioStatus.Won)
                    {
                        <button class="wide secondary run-end-keep-observing"
                                @onclick="() => _runEndDismissed = true">KEEP OBSERVING THE STATION</button>
                    }
                </div>
            </section>
        </div>
    }
</div>

