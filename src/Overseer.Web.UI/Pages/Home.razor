    private async Task ResetGame()
    {
        StopClock();
        await Session.ResetAsync();
        _runEndDismissed = false;
        await BrowserInterop.TryInvokeVoidAsync(JS, "localStorage.removeItem", CampaignStorageKey);
        _selection = new(StationSelectionKind.Room, "control");
