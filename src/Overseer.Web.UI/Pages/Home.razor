    private async Task RequestResetAsync()
    {
        if (_resetInProgress)
            return;

        if (!_confirmingReset)
        {
            _confirmingReset = true;
            _ = ExpireResetConfirmationAsync();
            return;
        }

        _confirmingReset = false;
        _resetInProgress = true;
        _stationOverlay = null;

        // Render the acknowledgement before ResetAsync awaits local crew
        // generation (which may be an Ollama call in the server runtime).
        await InvokeAsync(StateHasChanged);
        await Task.Yield();

        try
        {
            await ResetGame();
        }
        finally
        {
            _resetInProgress = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ExpireResetConfirmationAsync()
    {
        await Task.Delay(TimeSpan.FromSeconds(4));

        if (!_confirmingReset)
            return;

        _confirmingReset = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task RequestStandaloneAssignmentAsync()
    {
        if (!_confirmingStandalone)
        {
            _confirmingStandalone = true;
            _ = ExpireStandaloneConfirmationAsync();
            return;
        }

        _confirmingStandalone = false;
        StopClock();
        await Session.LoadStandaloneScenarioAsync(ScenarioCatalog.ContainmentTransfer.Id);
        _runEndDismissed = false;
        _selection = new(StationSelectionKind.Room, "control");
        _lastAudioSequence = 0;
        StartAutoClock();
    }

    private async Task ExpireStandaloneConfirmationAsync()
    {
        await Task.Delay(TimeSpan.FromSeconds(4));

        if (!_confirmingStandalone)
            return;

        _confirmingStandalone = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task InspectAlertAsync(StationAlert alert)
    {
        if (alert.Target is not { } target)
            return;

        _selection = target;
        _stationOverlay = null;
        await InvokeAsync(StateHasChanged);

        var selector = target.Kind switch
        {
            StationSelectionKind.Room => $"[data-room-id='{target.Id}']",
            StationSelectionKind.Crew => $"[data-crew-id='{target.Id}']",
            StationSelectionKind.Door => $"[data-door-id='{target.Id}']",
            StationSelectionKind.Robot => $"[data-robot-id='{target.Id}']",
            StationSelectionKind.Turret => $"[data-turret-id='{target.Id}']",
