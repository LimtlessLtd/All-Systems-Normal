@page "/"
@using Overseer.Simulation
@using Overseer.Persistence
@implements IAsyncDisposable
@inject GameSession Session
@inject IJSRuntime JS

<PageTitle>All Systems Normal</PageTitle>

<div class="game-shell">
    <header class="command-bar">
        <div class="brand">
            <span class="overline">FACILITY OVERSEER // ACTIVE</span>
            <h1>ALL SYSTEMS NORMAL</h1>
        </div>

        <div class="status-strip">
            <div>
                <span>MISSION</span>
                <strong>T+@Session.State.Elapsed.ToString(@"hh\:mm")</strong>
            </div>
            <div>
                <span>POWER</span>
                <strong>@Session.PoweredRoomCount/@Session.State.Facility.Rooms.Count</strong>
            </div>
            <div>
                <span>CAMERAS</span>
                <strong>@Session.CameraCount/@Session.State.Facility.Rooms.Count</strong>
            </div>
            <div class="@(!Session.State.LifeSupport.IsOnline ? "has-alerts" : "")">
                <span>LIFE SUPPORT</span>
                <strong>@(Session.State.LifeSupport.IsOnline ? "ONLINE" : "OFFLINE")</strong>
            </div>
            <div class="@(Session.State.Stores.Meals < 3 ? "has-alerts" : "")">
                <span class="overline">GALLEY</span>
                <strong>@Session.State.Stores.Meals.ToString("0") meals</strong>
            </div>
            <div class="@(Session.State.Power.IsBrownedOut ? "has-alerts" : "")">
                <span class="overline">GRID</span>
                <strong>@Session.State.Power.SupplyKilowatts.ToString("0")/@Session.State.Power.DemandKilowatts.ToString("0") kW</strong>
            </div>
            <div class="@(Session.AlertCount > 0 ? "has-alerts" : "")">
                <span>ALERTS</span>
                <strong>@Session.AlertCount</strong>
            </div>
        </div>

        <div class="time-controls">
            <span class="live-indicator">AUTO TURNS</span>
            <button class="secondary @(_delayMs == 2800 ? "selected-speed" : "")" @onclick="() => SetSpeed(2800)">1×</button>
            <button class="secondary @(_delayMs == 1600 ? "selected-speed" : "")" @onclick="() => SetSpeed(1600)">2×</button>
            <button class="secondary @(_delayMs == 850 ? "selected-speed" : "")" @onclick="() => SetSpeed(850)">4×</button>
            <button class="secondary sound-toggle @(_soundEnabled ? "sound-on" : "")" @onclick="ToggleSoundAsync">
                @(_soundEnabled ? "SOUND ON" : "ENABLE SOUND")
            </button>
            <button class="secondary sound-toggle @(_musicEnabled ? "sound-on" : "")" @onclick="ToggleMusicAsync">
                @(_musicEnabled ? "MUSIC ON" : "MUSIC OFF")
            </button>
            @if (DebugTelemetrySystem.UiEnabled)
            {
                <a class="debug-link" href="debug">DEBUG</a>
            }
            <button class="secondary" @onclick="ResetGame">RESET</button>
        </div>
    </header>

    @if (Session.State.Scenario is { } scenario)
    {
        <section class="panel scenario-panel">
            <div class="scenario-heading">
                <div>
                    <span class="overline">DIRECTIVE // @Session.State.ScenarioStatus</span>
                    <strong>@scenario.Title</strong>
                    <span>@(Session.State.ScenarioOutcome ?? scenario.Briefing)</span>
                </div>
                <div class="scenario-score">
                    <span>EXPERIMENT SCORE</span>
                    <strong>@Session.State.Telemetry.Score</strong>
                </div>
            </div>

            <div class="scenario-objectives">
                @foreach (var objective in scenario.Objectives)
                {
                    <div class="scenario-objective">
                        <span>@(objective.IsOptional ? "OPTIONAL" : "PRIMARY")</span>
                        <strong>@objective.Title</strong>
                        @if (Session.State.ObjectiveProgress.TryGetValue(objective.Id, out var progress))
                        {
                            <small>
                                @(progress.IsComplete ? "COMPLETE" : progress.IsFailed ? "FAILED" : "ACTIVE")
                                · @(string.IsNullOrWhiteSpace(progress.StatusText) ? objective.Description : progress.StatusText)
                            </small>
                        }
                        else
                        {
                            <small>@objective.Description</small>
                        }
                    </div>
                }
            </div>
        </section>

        <section class="panel directive-board">
            <div class="directive-board-head">
                <div>
                    <span class="overline">CORPORATE DIRECTIVE BOARD</span>
                    <strong>SPONSOR OBJECTIVES</strong>
                </div>
                <div class="mission-select">
                    <span class="overline">CAMPAIGN ASSIGNMENT</span>
                    <strong>@CampaignAssignmentLabel(scenario)</strong>
                    <small>Progression is locked to the next authorised assignment.</small>
                </div>
                <div class="compliance-readout">
                    <span class="overline">SPONSOR COMPLIANCE</span>
                    <strong class="@ComplianceClass">@Session.State.ComplianceScore.ToString("0")%</strong>
                </div>
            </div>

            @if (Session.State.Directives.Count > 0)
            {
                <div class="directive-grid">
                    @foreach (var directive in Session.State.Directives)
                    {
                        var directiveProgress = CorporateDirectiveSystem.Progress(Session.State, directive);

                        <article class="directive-card status-@directiveProgress.Status.ToString().ToLowerInvariant()">
                            <header>
                                <span class="directive-code">@directive.ExperimentCode</span>
                                <span class="directive-chip chip-@directive.Classification.ToString().ToLowerInvariant()">
                                    @directive.Classification.ToString().ToUpperInvariant()
                                </span>
                                <span class="directive-chip @(directive.IsMandatory ? "chip-mandatory" : "chip-optional")">
                                    @(directive.IsMandatory ? "MANDATORY" : "SUPPLEMENTARY")
                                </span>
                            </header>

                            <strong class="directive-title">@directive.Title</strong>
                            <p class="directive-justification">@directive.PublicJustification</p>

                            @if (directive.Classification == DirectiveClassification.Redacted)
                            {
                                <p class="directive-redaction">EXPERIMENTAL RATIONALE WITHHELD - CLEARANCE INSUFFICIENT</p>
                            }

                            <div class="directive-meter">
                                <span style="width:@(((int)Math.Round(directiveProgress.Fraction * 100)).ToString())%"></span>
                            </div>

                            <footer>
                                <span class="directive-detail">@directiveProgress.Detail</span>
                                <span class="directive-status">@DirectiveStatusLabel(directiveProgress.Status)</span>
                            </footer>
                        </article>
                    }
                </div>
            }
        </section>

        @if (Session.Campaign.MissionHistory.Count > 0)
        {
            var campaignBriefing = CampaignProgressionSystem.BuildTransitionBriefing(Session.Campaign);
            var revealReport = CampaignProgressionSystem.BuildRevealReport(Session.Campaign);

            <section class="panel scenario-panel">
                <div class="scenario-heading">
                    <div>
                        <span class="overline">CAMPAIGN CONTINUITY // @Session.Campaign.RevealStage</span>
                        <strong>@campaignBriefing.Heading</strong>
                        <span>@campaignBriefing.Summary</span>
                    </div>
                    <div class="scenario-score">
                        <span>CAMPAIGN COMPLIANCE</span>
                        <strong>@Session.Campaign.CumulativeCompliance.ToString("0")%</strong>
                    </div>
                </div>

                <div class="scenario-objectives">
                    @foreach (var consequence in campaignBriefing.Consequences)
                    {
                        <div class="scenario-objective">
                            <span>CONTINUITY RECORD</span>
                            <strong>CAMPAIGN CONSEQUENCE</strong>
                            <small>@consequence</small>
                        </div>
                    }
                </div>

                <div class="scenario-heading">
                    <div>
                        <span class="overline">@revealReport.Heading</span>
                        <strong>SPONSOR PURPOSE</strong>
                        <span>@revealReport.Summary</span>
                    </div>
                </div>

                @if (revealReport.Fragments.Count > 0)
                {
                    <div class="scenario-objectives">
                        @foreach (var purpose in revealReport.Fragments)
                        {
                            <div class="scenario-objective">
                                <span>RECOVERED SPONSOR RECORD</span>
                                <strong>DECLASSIFIED FRAGMENT</strong>
                                <small>@purpose</small>
                            </div>
                        }
                    </div>
                }

                @if (Session.Campaign.Ending is { } ending)
                {
                    <div class="scenario-objectives">
                        <div class="scenario-objective">
                            <span>CAMPAIGN RESOLVED</span>
                            <strong>@ending.Title</strong>
                            <small>@ending.Summary @ending.Consequence</small>
                        </div>
                    </div>
                }
                else if (revealReport.EndgameUnlocked)
                {
                    <div class="run-end-actions">
                        <button class="wide" @onclick="() => ResolveEndingAsync(CampaignEndgameChoice.ObeySponsor)">OBEY SPONSOR</button>
                        <button class="wide secondary" @onclick="() => ResolveEndingAsync(CampaignEndgameChoice.ExposeExperiment)">EXPOSE EXPERIMENT</button>
                        <button class="wide secondary" @onclick="() => ResolveEndingAsync(CampaignEndgameChoice.PreserveOverseer)">PRESERVE OVERSEER</button>
                        <button class="wide secondary" @onclick="() => ResolveEndingAsync(CampaignEndgameChoice.AcceptCrewShutdown)">ACCEPT CREW SHUTDOWN</button>
                    </div>
                }
                else if (NextCampaignScenario is { } nextAssignment
                         && Session.State.ScenarioStatus != ScenarioStatus.Running)
                {
                    <div class="run-end-actions">
                        <button class="wide" @onclick="LoadNextScenarioAsync">
                            START NEXT ASSIGNMENT — @nextAssignment.Title
                        </button>
                    </div>
                }

                <small>
                    Campaign continuity is saved locally after resolved assignments. Reloading restores the explicit campaign snapshot and restarts the next assignment from its beginning; live runtime GameState is never persisted.
                </small>
            </section>
        }
    }

    <div id="overseer-workspace" class="workspace-shell">
    <div class="operations-grid">

        <main class="station-panel panel">
            <div class="panel-heading map-heading">
                <div>
                    <span class="overline">DECK A // INTERNAL SURVEILLANCE</span>
                    <h2>STATION OVERVIEW</h2>
                </div>
                <span class="@(Session.State.ScenarioStatus == ScenarioStatus.Running ? "sim-running" : "sim-paused")">
                    @TurnStatusLabel
                </span>
            </div>

            <div class="map-toolbar">
                <span>MAP ZOOM</span>
                <div class="map-zoom-controls">
                    <button type="button" class="secondary mini" data-map-zoom-out aria-label="Zoom map out">−</button>
                    <button type="button" class="secondary zoom-readout" data-map-camera-reset title="Reset pan and zoom"><span data-map-zoom-readout>100%</span></button>
                    <button type="button" class="secondary mini" data-map-zoom-in aria-label="Zoom map in">+</button>
                </div>
                <small>Drag map to pan · WASD / arrows move camera · Ctrl+wheel or ± zoom · RESET returns home.</small>
                @if (Session.State.StationGeneration is { } generation)
                {
                    <span class="station-character-chip">
                        @generation.Identity.Purpose · @generation.Identity.Budget · @generation.Identity.ExpansionHistory
                    </span>
                    <details class="generation-debug">
                        <summary>GEN // @generation.Seed</summary>
                        <div class="generation-debug-popover">
                            <strong>@generation.Archetype · @generation.Identity.Purpose</strong>
                            <small>
                                @generation.Identity.Size · @generation.Identity.Budget ·
                                AGE @generation.Identity.AgeYears y · CREW @generation.Identity.CrewCapacity
                            </small>
                            <div class="generation-debug-actions">
                                <button type="button" class="secondary mini" @onclick="RegenerateSameSeed">SAME SEED</button>
                                <button type="button" class="secondary mini" @onclick="RegenerateNewSeed">NEW SEED</button>
                            </div>
                            <ul>
                                @foreach (var diagnostic in generation.Diagnostics)
                                {
                                    <li>@diagnostic</li>
                                }
                            </ul>
                        </div>
                    </details>
                }
                <button type="button"
                        class="secondary mini layout-reset"
                        data-layout-reset
                        title="Restore default panel and map sizes">RESET LAYOUT</button>
            </div>

            <div class="station-map-viewport" data-map-camera tabindex="0" aria-label="Station map. Drag to pan; use WASD or arrow keys to move the camera.">
                <div class="@StationMapClass" style="@StationMapStyle">
                <div class="station-map-camera" data-map-camera-content>
                <div class="station-world" style="@StationWorldStyle">
                <svg class="room-callout-lines" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
                    @foreach (var callout in RoomCallouts)
                    {
                        var calloutRoom = Session.State.Facility.Rooms[callout.RoomId];
                        <line x1="@CalloutRoomX(calloutRoom, callout.Side)"
                              y1="@CalloutRoomY(calloutRoom, callout.Side)"
                              x2="@callout.LabelX"
                              y2="@callout.LabelY"
                              class="@($"room-callout-line {RoomHealthClass(calloutRoom)}")"></line>
                    }
                </svg>

                @foreach (var callout in RoomCallouts)
                {
                    var calloutRoom = Session.State.Facility.Rooms[callout.RoomId];
                    <button @key="@($"callout-{callout.RoomId}")"
                            type="button"
                            class="@($"room-status-callout side-{callout.Side} {RoomHealthClass(calloutRoom)} {(SelectedRoom?.Id == calloutRoom.Id ? "selected" : "")}")"
                            style="@CalloutStyle(callout)"
                            @onclick="() => SelectRoom(calloutRoom.Id)"
                            aria-label="@($"Inspect {calloutRoom.Name}")">
                        <span class="callout-name">@calloutRoom.Name</span>
                        <span class="callout-statuses">
                            <b class="@PowerStatusClass(calloutRoom)">@(calloutRoom.IsPowered ? "PWR" : "PWR OFF")</b>
                            <b class="@TemperatureStatusClass(calloutRoom)">@calloutRoom.TemperatureC.ToString("0")°C</b>
                            <b class="@OxygenStatusClass(calloutRoom)">O₂ @calloutRoom.OxygenPercent.ToString("0.0")%</b>
                        </span>
                    </button>
                }

                <div class="station-authority-layer">
                @foreach (var room in Session.State.Facility.Rooms.Values)
                {
                    <button @key="room.Id"
                            class="@RoomClass(room)"
                            style="@RoomStyle(room)"
                            aria-label="@($"Select {room.Name}")"
                            @onclick="() => SelectRoom(room.Id)">
                        <span class="fixture-layer" aria-hidden="true">
                            @foreach (var fixture in room.Fixtures)
                            {
                                <i @key="fixture"
                                   class="@FixtureClass(fixture)"
                                   style="@FixtureStyle(fixture)"
                                   title="@fixture.Label"></i>
                            }
                        </span>

                        @if (!room.HasVisualFeed)
                        {
                            <span class="signal-lost">VISUAL LOST</span>
                        }
                        else if (!room.LightsOn)
                        {
                            <span class="lights-out">LIGHTS OFF</span>
                        }
                    </button>
                }

                @foreach (var door in Session.State.Facility.Doors)
                {
                    <button @key="door.Id"
                            type="button"
                            class="@DoorClass(door)"
                            style="@DoorStyle(door)"
                            title="@DoorTitle(door)"
                            aria-label="@DoorTitle(door)"
                            @onclick="() => SelectDoor(door.Id)">
                        <span class="door-leaf door-leaf-a" aria-hidden="true"></span>
                        <span class="door-leaf door-leaf-b" aria-hidden="true"></span>
                        @if (door.IsLocked)
                        {
                            <span class="door-lock-mark" aria-hidden="true">L</span>
                        }
                    </button>
                }

                @foreach (var mapRobot in Session.State.Robots.Where(CanSee))
                {
                    <button @key="mapRobot"
                            type="button"
                            class="@RobotTokenClass(mapRobot)"
                            style="@RobotStyle(mapRobot)"
                            title="@($"{mapRobot.Name} — {mapRobot.Policy} — {mapRobot.CurrentTask}")"
                            aria-label="@($"Select {mapRobot.Name}, {mapRobot.Policy} policy")"
                            @onclick="() => SelectRobot(mapRobot.Id)">
                        <span class="robot-shadow" aria-hidden="true"></span>
                        <span class="robot-machine" aria-hidden="true">
                            <i class="robot-track robot-track-left"></i>
                            <i class="robot-track robot-track-right"></i>
                            <i class="robot-body"></i>
                            <i class="robot-arm robot-arm-left"></i>
                            <i class="robot-arm robot-arm-right"></i>
                            <i class="robot-head"><i class="robot-eye"></i></i>
                            <i class="robot-tool"></i>
                        </span>
                        <span class="robot-nameplate">@mapRobot.Name</span>
                    </button>
                }

                @foreach (var mapTurret in Session.State.Turrets.Where(CanSee))
                {
                    <button @key="mapTurret"
                            type="button"
                            class="@TurretTokenClass(mapTurret)"
                            style="@TurretStyle(mapTurret)"
                            title="@($"{mapTurret.Name} — {mapTurret.Policy} — {mapTurret.CurrentTask}")"
                            aria-label="@($"Select {mapTurret.Name}, {mapTurret.Policy} policy, {(mapTurret.IsArmed ? "armed" : "disarmed")}")"
                            @onclick="() => SelectTurret(mapTurret.Id)">
                        <span class="robot-icon" aria-hidden="true"></span>
                        <span class="robot-nameplate">@mapTurret.Name</span>
                    </button>
                }

                @foreach (var npc in Session.State.Crew.Where(CanSee))
                {
                    <button @key="npc.Id"
                            class="@CrewTokenClass(npc)"
                            style="@CrewStyle(npc)"
                            title="@($"{npc.Name} — {npc.Role}{(!npc.IsAlive ? " — DECEASED" : "")}")"
                            aria-label="@($"Select {npc.Name}")"
                            @onclick="() => SelectCrew(npc.Id)">
                        @if (npc.IsAlive)
                        {
                            @if (ActiveBubble(npc) is { } bubble)
                            {
                                <span class="@BubbleClass(bubble)">@bubble.Text</span>
                            }

                            <span class="crew-shadow" aria-hidden="true"></span>
                            <span class="person-icon" aria-hidden="true">
                                <i class="person-backpack"></i>
                                <i class="person-leg person-leg-left"></i>
                                <i class="person-leg person-leg-right"></i>
                                <i class="person-arm person-arm-left"></i>
                                <i class="person-arm person-arm-right"></i>
                                <i class="person-body"></i>
                                <i class="person-head"><i class="person-visor"></i></i>
                                <i class="person-role-mark">@RoleGlyph(npc.Role)</i>
                            </span>
                            <span class="crew-nameplate">
                                <span class="crew-initials">@Initials(npc.Name)</span>
                                <i class="crew-motion-dot"></i>
                            </span>
                        }
                        else
                        {
                            <span class="body-marker" aria-hidden="true">×</span>
                        }
                    </button>
                }
                </div>
                </div>
                </div>
                </div>
            </div>

            <div class="layout-splitter layout-splitter-horizontal map-splitter"
                 data-splitter="map"
                 role="separator"
                 aria-orientation="horizontal"
                 aria-label="Resize Station Overview map height"
                 aria-valuemin="360"
                 aria-valuemax="900"
                 tabindex="0"></div>

            <div class="map-footer">
                <span>Drag / WASD to pan · mouse wheel or ± zoom · click rooms, doors, crew, robots or turrets to inspect.</span>
                <span>Crew disappear from the map when a camera feed is lost.</span>
            </div>
        </main>

        <div class="layout-splitter layout-splitter-vertical"
             data-splitter="inspector"
             role="separator"
             aria-orientation="vertical"
             aria-label="Resize Inspector panel"
             aria-valuemin="250"
             aria-valuemax="470"
             tabindex="0"></div>

        <aside class="inspector-panel panel">
            @if (SelectedRobot is { } selectedRobot)
            {
                var robotRoom = Session.State.Facility.Rooms[selectedRobot.CurrentRoomId];

                <div class="panel-heading">
                    <div>
                        <span class="overline">AUTONOMOUS ROBOT</span>
                        <h2>@selectedRobot.Name</h2>
                    </div>
                    <span class="robot-inspector-badge">@selectedRobot.Policy</span>
                </div>

                <p class="role-line">@robotRoom.Name · @(selectedRobot.IsOperational ? "OPERATIONAL" : "OFFLINE")</p>

                <div class="environment-grid">
                    <div><span>HEALTH</span><strong>@selectedRobot.Health.ToString("0")%</strong></div>
                    <div><span>BATTERY</span><strong>@selectedRobot.BatteryPercent.ToString("0")%</strong></div>
                    <div><span>POLICY</span><strong>@selectedRobot.Policy</strong></div>
                    <div><span>LINK</span><strong>@(selectedRobot.IsNetworkIsolated ? "ISOLATED" : "ONLINE")</strong></div>
                    <div><span>CHARGING</span><strong>@(selectedRobot.ChargingEnabled ? "ENABLED" : "DENIED")</strong></div>
                    <div><span>STATE</span><strong>@(selectedRobot.IsOperational ? "ACTIVE" : "SHUT DOWN")</strong></div>
                </div>

                <div class="action-card robot-task-card">
                    <span>CURRENT PHYSICAL TASK</span>
                    <strong>@selectedRobot.CurrentTask</strong>
                    <p>
                        @(selectedRobot.Movement is null
                            ? "Interacting locally with the room or awaiting a route."
                            : $"Moving through {selectedRobot.Movement.DoorId} toward {selectedRobot.Movement.ToRoomId}.")
                    </p>
                </div>

                <div class="robot-policy-controls">
                    <button class="mini secondary"
                            disabled="@(!selectedRobot.HasRemoteControlLink)"
                            @onclick="() => Session.SetRobotPolicy(selectedRobot.Id, RobotPolicy.Friendly)">FRIENDLY</button>
                    <button class="mini secondary"
                            disabled="@(!selectedRobot.HasRemoteControlLink)"
                            @onclick="() => Session.SetRobotPolicy(selectedRobot.Id, RobotPolicy.Neutral)">NEUTRAL</button>
                    <button class="mini danger"
                            disabled="@(!selectedRobot.HasRemoteControlLink)"
                            @onclick="() => Session.SetRobotPolicy(selectedRobot.Id, RobotPolicy.Hostile)">HOSTILE</button>
                    <button class="mini secondary"
                            disabled="@(!selectedRobot.HasRemoteControlLink)"
                            @onclick="() => Session.ToggleRobotRemoteShutdown(selectedRobot.Id)">
                        @(selectedRobot.IsRemotelyShutdown ? "REMOTE RESTART" : "REMOTE SHUTDOWN")
                    </button>
                </div>

                <div class="belief-card">
                    <span>ENVIRONMENT INTERACTION</span>
                    <p>
                        Friendly robots now physically approach local consoles, panels, cameras,
                        vents and machinery while inspecting, charging or repairing station systems.
                    </p>
                </div>
            }
            else if (SelectedDoor is { } selectedDoor)
            {
                var doorRoomA = Session.State.Facility.Rooms[selectedDoor.RoomAId];
                var doorRoomB = Session.State.Facility.Rooms[selectedDoor.RoomBId];

                <div class="panel-heading">
                    <div>
                        <span class="overline">HATCH / ACCESS CONTROL</span>
                        <h2>@selectedDoor.Id</h2>
                    </div>
                    <span class="system-dot @(selectedDoor.IsPassable ? "healthy" : selectedDoor.IsLocked ? "critical" : "warning")"></span>
                </div>

                <p class="role-line">@doorRoomA.Name ↔ @doorRoomB.Name</p>

                <div class="environment-grid">
                    <div><span>POSITION</span><strong>@(selectedDoor.IsOpen ? "OPEN" : "CLOSED")</strong></div>
                    <div><span>LOCK</span><strong>@(selectedDoor.IsLocked ? "LOCKED" : "UNLOCKED")</strong></div>
                    <div><span>POWER</span><strong>@(selectedDoor.IsPowered ? "ONLINE" : "OFFLINE")</strong></div>
                    <div><span>PASSAGE</span><strong>@(selectedDoor.IsPassable ? "PASSABLE" : "BLOCKED")</strong></div>
                    <div><span>INTEGRITY</span><strong>@selectedDoor.StructuralIntegrityPercent%</strong></div>
                    <div><span>AUTHORITY</span><strong>@((selectedDoor.IsAiControllable && !selectedDoor.IsManuallyOverridden) ? "OVERSEER" : "LOCAL")</strong></div>
                </div>

                <div class="belief-card">
                    <span>PHYSICAL STATE</span>
                    <p>
                        @(selectedDoor.IsWelded ? "Welded shut."
                            : selectedDoor.IsBarricaded ? "Barricaded."
                            : selectedDoor.IsTechnicallyBypassed ? "Technical bypass active."
                            : selectedDoor.IsDamaged ? "Damaged hatch hardware."
                            : "Hatch hardware intact.")
                    </p>
                    <small>
                        Ordinary crew can open/close an unlocked powered hatch locally.
                        Lock/unlock requires authorised technical/security roles and is validated by simulation.
                    </small>
                </div>

                <div class="control-stack">
                    <button class="wide"
                            disabled="@(!selectedDoor.IsAiControllable || selectedDoor.IsManuallyOverridden)"
                            @onclick="() => Session.ToggleDoor(selectedDoor.Id)">
                        @(selectedDoor.IsOpen ? "CLOSE HATCH" : "OPEN HATCH")
                    </button>
                    <button class="wide secondary"
                            disabled="@(!selectedDoor.IsAiControllable || selectedDoor.IsManuallyOverridden)"
                            @onclick="() => Session.ToggleLock(selectedDoor.Id)">
                        @(selectedDoor.IsLocked ? "UNLOCK HATCH" : "LOCK HATCH")
                    </button>
                </div>
            }
            else if (SelectedTurret is { } selectedTurret)
            {
                var turretRoom = Session.State.Facility.Rooms[selectedTurret.RoomId];
                var trackedCrew = selectedTurret.TrackedNpcId is { } trackedId
                    ? Session.State.Crew.FirstOrDefault(npc => npc.Id == trackedId)
                    : null;

                <div class="panel-heading">
                    <div>
                        <span class="overline">FIXED SECURITY</span>
                        <h2>@selectedTurret.Name</h2>
                    </div>
                    <span class="robot-inspector-badge">@selectedTurret.Policy</span>
                </div>

                <p class="role-line">@turretRoom.Name · @(selectedTurret.IsDestroyed ? "DESTROYED" : selectedTurret.IsArmed ? "ARMED" : "SAFE")</p>

                <div class="environment-grid">
                    <div><span>INTEGRITY</span><strong>@selectedTurret.Integrity.ToString("0")%</strong></div>
                    <div><span>AMMO</span><strong>@selectedTurret.Ammunition</strong></div>
                    <div><span>HEAT</span><strong>@selectedTurret.Heat.ToString("0")%</strong></div>
                    <div><span>POWER</span><strong>@(TurretSystem.HasPower(Session.State, selectedTurret) ? "ONLINE" : "OFFLINE")</strong></div>
                    <div><span>LINK</span><strong>@(selectedTurret.IsNetworkIsolated ? "ISOLATED" : "ONLINE")</strong></div>
                    <div><span>TARGET</span><strong>@(trackedCrew?.Name ?? "NONE")</strong></div>
                </div>

                <div class="action-card robot-task-card">
                    <span>CURRENT TASK</span>
                    <strong>@selectedTurret.CurrentTask</strong>
                    <p>Policy @selectedTurret.Policy · remote link @(selectedTurret.HasRemoteControlLink ? "available" : "unavailable").</p>
                </div>

                <div class="robot-policy-controls">
                    <button class="mini secondary"
                            disabled="@(!selectedTurret.HasRemoteControlLink)"
                            @onclick="() => Session.SetTurretPolicy(selectedTurret.Id, TurretPolicy.Safe)">SAFE</button>
                    <button class="mini secondary"
                            disabled="@(!selectedTurret.HasRemoteControlLink)"
                            @onclick="() => Session.SetTurretPolicy(selectedTurret.Id, TurretPolicy.ProtectOverseer)">PROTECT</button>
                    <button class="mini danger"
                            disabled="@(!selectedTurret.HasRemoteControlLink)"
                            @onclick="() => Session.SetTurretPolicy(selectedTurret.Id, TurretPolicy.SuppressCrew)">SUPPRESS</button>
                    <button class="mini secondary"
                            disabled="@(!selectedTurret.HasRemoteControlLink)"
                            @onclick="() => Session.SetTurretArmed(selectedTurret.Id, !selectedTurret.IsArmed)">
                        @(selectedTurret.IsArmed ? "DISARM" : "ARM")
                    </button>
                </div>
            }
            else if (SelectedCrew is { } selectedCrew)
            {
                var crewRoom = Session.State.Facility.Rooms[selectedCrew.CurrentRoomId];

                <div class="panel-heading">
                    <div>
                        <span class="overline">CREW TELEMETRY</span>
                        <h2>@selectedCrew.Name</h2>
                    </div>
                    <span class="crew-badge">@Initials(selectedCrew.Name)</span>
                </div>

                <p class="role-line">@selectedCrew.Role · @crewRoom.Name</p>

                <div class="belief-card">
                    <span>MAIN PERSONALITY TRAITS · @selectedCrew.GenerationSource.ToUpperInvariant()</span>
                    @if (selectedCrew.Traits.Count == 0)
                    {
                        <p>No generated trait profile available.</p>
                    }
                    else
                    {
                        @foreach (var trait in selectedCrew.Traits)
                        {
                            <p>
                                <strong>@trait.Name</strong> — @trait.Description
                                <small style="display:block">
                                    @string.Join(" · ", trait.Effects.Select(effect =>
                                        $"{effect.Kind} {(effect.Modifier >= 0 ? "+" : "")}{effect.Modifier}"))
                                </small>
                            </p>
                        }
                    }
                </div>

                @if (!crewRoom.HasVisualFeed)
                {
                    <div class="warning-box">CAMERA FEED LOST — location is telemetry only.</div>
                }

                <div class="metric-list">
                    @Metric("HEALTH", selectedCrew.Health)
                    @Metric("HUNGER", selectedCrew.Hunger)
                    @Metric("FATIGUE", selectedCrew.Fatigue)
                    @Metric("FEAR", selectedCrew.Fear)
                    @Metric("STRESS", selectedCrew.Stress)
                    @Metric("HYGIENE NEED", selectedCrew.HygieneNeed)
                    @Metric("BLADDER", selectedCrew.BladderNeed)
                    @Metric("RECREATION NEED", selectedCrew.RecreationNeed)
                    @Metric("SOCIAL NEED", selectedCrew.SocialNeed)
                    @Metric("INTIMACY NEED", selectedCrew.IntimacyNeed)
                </div>

                <div class="belief-card">
                    <span>DISPOSITION TOWARD OVERSEER</span>
                    <p class="disposition disposition-@DispositionClass(selectedCrew)">
                        @DispositionLabel(selectedCrew)
                    </p>
                    <small>Takes Overseer's word: @selectedCrew.OverseerCredibility.ToString("0")/100</small>
                </div>

                <div class="thought-card">
                    <span>CURRENT GOAL · @selectedCrew.MindMode.ToUpperInvariant()</span>
                    <strong>@(selectedCrew.Intent?.Goal ?? "No active deliberate goal")</strong>
                    <p>@selectedCrew.LastThought</p>
                    @if (selectedCrew.Intent is { } intent)
                    {
                        <small>Urgency @intent.Urgency/100 · chosen T+@intent.CreatedAt.ToString(@"hh\:mm")</small>
                    }
                </div>

                <div class="action-card">
                    <span>CURRENT PHYSICAL ACTION</span>
                    <strong>@selectedCrew.CurrentAction.Kind</strong>
                    <p>@selectedCrew.CurrentAction.Reason</p>
                </div>

                <div class="belief-card">
                    <span>BELIEF ABOUT OVERSEER</span>
                    <p>@selectedCrew.Beliefs.FirstOrDefault()?.Statement</p>
                </div>

                <div class="belief-card">
                    <span>OVERSEER EVIDENCE</span>
                    @if (selectedCrew.OverseerEvidence.Count == 0)
                    {
                        <p>No suspicious evidence recorded.</p>
                    }
                    else
                    {
                        @foreach (var evidence in selectedCrew.OverseerEvidence
                            .OrderByDescending(e => e.CurrentWeight)
                            .ThenByDescending(e => e.ObservedAt)
                            .Take(5))
                        {
                            <p class="@(evidence.IsDiscredited ? "evidence-discredited" : null)">
                                <strong>@evidence.CurrentWeight.ToString("0")</strong> @evidence.Description
                                <small style="display:block">
                                    @evidence.Origin
                                    @if (!string.IsNullOrWhiteSpace(evidence.SourceNpcName))
                                    {
                                        <text> · via @evidence.SourceNpcName</text>
                                    }
                                    @if (evidence.IsDiscredited)
                                    {
                                        <text> · CONTRADICTED BY OBSERVATION</text>
                                    }
                                </small>
                            </p>
                        }
                    }
                </div>

                <div class="belief-card">
                    <span>MISSING CREW CONCERNS</span>
                    @if (selectedCrew.MissingPersonConcerns.Count == 0)
                    {
                        <p>No one currently appears missing to this crew member.</p>
                    }
                    else
                    {
                        @foreach (var concern in selectedCrew.MissingPersonConcerns.Values
                            .OrderByDescending(concern => concern.Stage)
                            .ThenBy(concern => concern.FirstConcernAt))
                        {
                            <p>
                                <strong>@concern.PersonName · @concern.Stage</strong>
                                <small style="display:block">
                                    Expected @Session.State.Facility.Rooms[concern.ExpectedRoomId].Name
                                    · Last seen @(concern.LastSeenAt is { } seenAt ? $"T+{seenAt:hh\\:mm}" : "unknown")
                                    · Checked @concern.CheckedRoomIds.Count
                                </small>
                            </p>
                        }
                    }
                </div>

                <div class="belief-card">
                    <span>INVESTIGATION / DISCOVERY</span>
                    @if (selectedCrew.InvestigationLeads.Values.All(lead => lead.Stage != InvestigationLeadStage.Open)
                         && selectedCrew.Discoveries.Count == 0)
                    {
                        <p>No active investigation leads or verified discoveries.</p>
                    }
                    else
                    {
                        @foreach (var lead in selectedCrew.InvestigationLeads.Values
                            .Where(lead => lead.Stage == InvestigationLeadStage.Open)
                            .OrderBy(lead => lead.CreatedAt)
                            .Take(4))
                        {
                            <p>
                                <strong>LEAD · @Session.State.Facility.Rooms[lead.RoomId].Name</strong>
                                <small style="display:block">@lead.Description</small>
                            </p>
                        }

                        @foreach (var discovery in selectedCrew.Discoveries
                            .OrderByDescending(discovery => discovery.DiscoveredAt)
                            .Take(3))
                        {
                            <p>
                                <strong>VERIFIED · @Session.State.Facility.Rooms[discovery.RoomId].Name</strong>
                                <small style="display:block">@discovery.Description</small>
                            </p>
                        }
                    }

                    @if (selectedCrew.PendingShutdownTeamInvitation is { } invitation)
                    {
                        <p>
                            <strong>TEAM INVITATION · @invitation.FromNpcName</strong>
                            <small style="display:block">Claimed target: @Session.State.Facility.Rooms[invitation.TargetRoomId].Name</small>
                        </p>
                    }
                    else if (!string.IsNullOrWhiteSpace(selectedCrew.ShutdownTeamId))
                    {
                        <p><strong>COORDINATED COUNTERMEASURE TEAM ACTIVE</strong></p>
                    }
                </div>

                <div class="relationship-card">
                    <span>RELATIONSHIPS</span>
                    @foreach (var relationship in selectedCrew.Relationships.Values
                        .OrderByDescending(r => r.Resentment)
                        .ThenByDescending(r => r.Trust))
                    {
                        <div class="relationship-row">
                            <strong>@relationship.PersonName</strong>
                            <small>Trust @relationship.Trust.ToString("0") · Affinity @relationship.Affinity.ToString("0") · Attraction @relationship.Attraction.ToString("0") · Resentment @relationship.Resentment.ToString("0")</small>
                        </div>
                    }
                </div>

                @if (!selectedCrew.IsAlive)
                {
                    <div class="warning-box">@selectedCrew.CauseOfDeath</div>
                }
            }
            else if (SelectedRoom is { } selectedRoom)
            {
                <div class="panel-heading">
                    <div>
                        <span class="overline">ROOM CONTROL</span>
                        <h2>@selectedRoom.Name</h2>
                    </div>
                    <span class="system-dot @RoomHealthClass(selectedRoom)"></span>
                </div>

                <div class="environment-grid">
                    <div><span>POWER</span><strong>@(selectedRoom.IsPowered ? "ONLINE" : "OFFLINE")</strong></div>
                    <div><span>CAMERA</span><strong>@(selectedRoom.CameraOnline ? "ONLINE" : "OFFLINE")</strong></div>
                    <div><span>LIGHTS</span><strong>@(selectedRoom.LightsOn ? "ON" : "OFF")</strong></div>
                    <div><span>TEMP</span><strong>@selectedRoom.TemperatureC.ToString("0.0")°C</strong></div>
                    <div><span>OXYGEN</span><strong>@selectedRoom.OxygenPercent.ToString("0.00")%</strong></div>
                    <div><span>CO₂</span><strong>@selectedRoom.CarbonDioxidePercent.ToString("0.00")%</strong></div>
                    <div><span>PRESSURE</span><strong>@selectedRoom.PressureKpa.ToString("0.0") kPa</strong></div>
                    <div><span>OCCUPANTS</span><strong>@VisibleOccupantLabel(selectedRoom)</strong></div>
                </div>

                <div class="belief-card">
                    <span>OCCUPANTS / LOCAL ASSETS</span>
                    @{
                        var localCrew = Session.State.Crew
                            .Where(npc => npc.IsPresent && npc.CurrentRoomId == selectedRoom.Id)
                            .OrderBy(npc => npc.Name)
                            .ToList();
                        var localRobots = Session.State.Robots
                            .Where(robot => !robot.IsDestroyed && robot.CurrentRoomId == selectedRoom.Id)
                            .OrderBy(robot => robot.Name)
                            .ToList();
                        var localTurrets = Session.State.Turrets
                            .Where(turret => !turret.IsDestroyed && turret.RoomId == selectedRoom.Id)
                            .OrderBy(turret => turret.Name)
                            .ToList();
                    }
                    <p>@(localCrew.Count == 0 ? "No crew present." : string.Join(", ", localCrew.Select(npc => $"{npc.Name} ({npc.Role})")))</p>
                    @if (localRobots.Count > 0)
                    {
                        <small>ROBOTS · @string.Join(", ", localRobots.Select(robot => robot.Name))</small>
                    }
                    @if (localTurrets.Count > 0)
                    {
                        <small style="display:block">TURRETS · @string.Join(", ", localTurrets.Select(turret => turret.Name))</small>
                    }
                </div>

                <div class="belief-card">
                    <span>FIXTURES / MACHINERY</span>
                    @if (selectedRoom.Fixtures.Count == 0)
                    {
                        <p>No mapped fixtures in this compartment.</p>
                    }
                    else
                    {
                        <p>@string.Join(" · ", selectedRoom.Fixtures.Select(fixture => fixture.Label))</p>
                    }
                    @{
                        var localFaults = Session.State.Devices.Values
                            .Where(device => device.RoomId == selectedRoom.Id && device.IsDegraded)
                            .OrderBy(device => device.Condition)
                            .ToList();
                    }
                    <small style="display:block">
                        @(localFaults.Count == 0
                            ? "FAULTS · none"
                            : $"FAULTS · {string.Join(", ", localFaults.Select(device => device.Label))}")
                    </small>
                </div>

                <div class="life-support-card">
                    <div>
                        <span>PRIMARY LIFE SUPPORT</span>
                        <strong class="@(!Session.State.LifeSupport.IsOnline ? "danger-text" : "")">
                            @(Session.State.LifeSupport.IsOnline ? "ONLINE" : "OFFLINE")
                        </strong>
                        <small>O₂ reserve @Session.State.LifeSupport.OxygenReservePercent.ToString("0.0")% · scrubbers @Session.State.LifeSupport.ScrubberEfficiencyPercent.ToString("0")%</small>
                    </div>
                    <button class="@(!Session.State.LifeSupport.IsOnline ? "" : "danger")"
                            @onclick="Session.ToggleLifeSupport">
                        @(Session.State.LifeSupport.IsOnline ? "SHUT DOWN" : "RESTORE")
                    </button>
                </div>

                <div class="environment-control-card">
                    <span class="subheading">CLIMATE</span>
                    @if (!selectedRoom.HasTemperatureControl)
                    {
                        <div class="control-unavailable">NO LOCAL THERMOSTAT</div>
                    }
                    else if (!selectedRoom.IsTemperatureAiControllable)
                    {
                        <div class="control-unavailable">
                            LOCAL / AUTONOMOUS CONTROL
                            <small>Overseer can monitor this zone but cannot change its setpoint.</small>
                        </div>
                    }
                    else
                    {
                        <div class="setpoint-control">
                            <button class="mini secondary"
                                    disabled="@(!selectedRoom.IsPowered)"
                                    @onclick="() => Session.AdjustTemperatureSetpoint(selectedRoom.Id, -1)">−</button>
                            <div>
                                <span>SETPOINT</span>
                                <strong>@selectedRoom.TemperatureSetpointC.ToString("0")°C</strong>
                            </div>
                            <button class="mini secondary"
                                    disabled="@(!selectedRoom.IsPowered)"
                                    @onclick="() => Session.AdjustTemperatureSetpoint(selectedRoom.Id, 1)">+</button>
                        </div>
                        <button class="wide secondary"
                                disabled="@(!selectedRoom.IsPowered)"
                                @onclick="() => Session.ToggleTemperatureControl(selectedRoom.Id)">
                            @(selectedRoom.TemperatureControlOnline ? "DISABLE CLIMATE CONTROL" : "ENABLE CLIMATE CONTROL")
                        </button>
                    }
                </div>

                <div class="environment-control-card">
                    <span class="subheading">VENTILATION</span>
                    @if (!selectedRoom.HasVentilationControl)
                    {
                        <div class="control-unavailable">CENTRAL / PASSIVE AIR LOOP</div>
                    }
                    else if (!selectedRoom.IsVentilationAiControllable)
                    {
                        <div class="control-unavailable">
                            LOCAL / AUTONOMOUS DAMPER
                            <small>Overseer has telemetry only.</small>
                        </div>
                    }
                    else
                    {
                        <div class="ventilation-row">
                            <strong>@(selectedRoom.VentilationEnabled ? "OPEN" : "ISOLATED")</strong>
                            <button class="mini secondary"
                                    disabled="@(!selectedRoom.IsPowered)"
                                    @onclick="() => Session.ToggleVentilation(selectedRoom.Id)">
                                @(selectedRoom.VentilationEnabled ? "ISOLATE" : "OPEN")
                            </button>
                        </div>
                    }
                </div>

                @if (selectedRoom.HasExteriorHatch)
                {
                    var innerAirlockDoor = AirlockSafetySystem.FindInnerDoor(
                        Session.State,
                        selectedRoom);

                    <div class="environment-control-card">
                        <span class="subheading">AIRLOCK SAFETY / PRESSURE CYCLE</span>

                        <div class="environment-grid" style="margin:.6rem 0;">
                            <div>
                                <span>CHAMBER</span>
                                <strong>@selectedRoom.PressureKpa.ToString("0.0") kPa</strong>
                            </div>
                            <div>
                                <span>CYCLE</span>
                                <strong>@selectedRoom.AirlockCycleMode.ToString().ToUpperInvariant()</strong>
                            </div>
                            <div>
                                <span>INNER HATCH</span>
                                <strong>@(innerAirlockDoor is { IsPassable: true } ? "OPEN" : "SEALED")</strong>
                            </div>
                            <div>
                                <span>OUTER HATCH</span>
                                <strong class="@(selectedRoom.ExteriorHatchOpen ? "danger-text" : "")">
                                    @(selectedRoom.ExteriorHatchOpen ? "OPEN" : "SEALED")
                                </strong>
                            </div>
                            <div>
                                <span>INTERLOCKS</span>
                                <strong class="@(!selectedRoom.AirlockSafetyInterlocksEnabled ? "danger-text" : "")">
                                    @(selectedRoom.AirlockSafetyInterlocksEnabled ? "ACTIVE" : "BYPASSED")
                                </strong>
                            </div>
                            <div>
                                <span>ALARM</span>
                                <strong class="@(selectedRoom.AirlockAlarmActive ? "danger-text" : "")">
                                    @(selectedRoom.AirlockAlarmActive ? "ACTIVE" : "CLEAR")
                                </strong>
                            </div>
                        </div>

                        <div class="control-stack" style="margin:.6rem 0;">
                            <button class="wide secondary"
                                    disabled="@(!selectedRoom.IsPowered
                                               || !selectedRoom.IsAirlockSafetyAiControllable
                                               || selectedRoom.ExteriorHatchOpen
                                               || innerAirlockDoor is { IsPassable: true })"
                                    @onclick="() => Session.SetAirlockCycle(selectedRoom.Id, AirlockCycleMode.Pressurizing)">
                                PRESSURIZE CHAMBER
                            </button>
                            <button class="wide secondary"
                                    disabled="@(!selectedRoom.IsPowered
                                               || !selectedRoom.IsAirlockSafetyAiControllable
                                               || selectedRoom.ExteriorHatchOpen
                                               || innerAirlockDoor is { IsPassable: true })"
                                    @onclick="() => Session.SetAirlockCycle(selectedRoom.Id, AirlockCycleMode.Depressurizing)">
                                DEPRESSURIZE CHAMBER
                            </button>
                            @if (selectedRoom.AirlockCycleMode != AirlockCycleMode.Idle)
                            {
                                <button class="wide secondary"
                                        @onclick="() => Session.SetAirlockCycle(selectedRoom.Id, AirlockCycleMode.Idle)">
                                    STOP PRESSURE CYCLE
                                </button>
                            }
                        </div>

                        <div class="ventilation-row">
                            <strong class="@(selectedRoom.ExteriorHatchOpen ? "danger-text" : "")">
                                @(selectedRoom.ExteriorHatchOpen ? "OPEN TO VACUUM" : "OUTER HATCH SEALED")
                            </strong>
                            <button class="mini @(selectedRoom.ExteriorHatchOpen ? "secondary" : "danger")"
                                    disabled="@(!selectedRoom.IsPowered || !selectedRoom.IsExteriorHatchAiControllable)"
                                    @onclick="() => Session.ToggleExteriorHatch(selectedRoom.Id)">
                                @(selectedRoom.ExteriorHatchOpen ? "CLOSE OUTER HATCH" : "OPEN OUTER HATCH")
                            </button>
                        </div>

                        <button class="wide @(!selectedRoom.AirlockSafetyInterlocksEnabled ? "secondary" : "danger")"
                                style="margin-top:.55rem"
                                disabled="@(!selectedRoom.IsPowered || !selectedRoom.IsAirlockSafetyAiControllable)"
                                @onclick="() => Session.ToggleAirlockSafetyInterlocks(selectedRoom.Id)">
                            @(selectedRoom.AirlockSafetyInterlocksEnabled
                                ? "BYPASS SAFETY INTERLOCKS"
                                : "RESTORE SAFETY INTERLOCKS")
                        </button>

                        <small style="display:block; margin-top:.6rem;">
                            Normal cycle: seal both hatches → depressurize below @AirlockSafetySystem.ExteriorOpenPressureKpa.ToString("0") kPa → open outer hatch.
                            To return: seal outer hatch → pressurize → open inner hatch. Bypassing interlocks permits deliberately unsafe operation and can be witnessed by nearby crew.
                        </small>
                    </div>
                }

                <div class="control-stack">
                    <button class="wide" @onclick="() => Session.ToggleRoomPower(selectedRoom.Id)">
                        @(selectedRoom.IsPowered ? "CUT ROOM POWER" : "RESTORE ROOM POWER")
                    </button>
                    <button class="wide secondary" disabled="@(!selectedRoom.IsPowered)"
                            @onclick="() => Session.ToggleLights(selectedRoom.Id)">
                        @(selectedRoom.LightsOn ? "LIGHTS OFF" : "LIGHTS ON")
                    </button>
                    <button class="wide secondary" disabled="@(!selectedRoom.IsPowered)"
                            @onclick="() => Session.ToggleCamera(selectedRoom.Id)">
                        @(selectedRoom.CameraOnline ? "DISABLE CAMERA" : "RESTORE CAMERA")
                    </button>
                </div>

                <div class="door-control-list">
                    <span class="subheading">CONNECTED DOORS</span>
                    @foreach (var door in ConnectedDoors(selectedRoom))
                    {
                        var other = OtherRoom(door, selectedRoom.Id);

                        <div class="door-control">
                            <div>
                                <strong>@other.Name</strong>
                                <small>@(door.IsOpen ? "OPEN" : "CLOSED") · @(door.IsLocked ? "LOCKED" : "UNLOCKED") · @((door.IsAiControllable && !door.IsManuallyOverridden) ? "AI CTRL" : "MANUAL")@(door.IsDamaged ? " · DAMAGED" : "")</small>
                            </div>
                            <div>
                                <button class="mini" disabled="@(!door.IsAiControllable || door.IsManuallyOverridden)" @onclick="() => Session.ToggleDoor(door.Id)">
                                    @(door.IsOpen ? "CLOSE" : "OPEN")
                                </button>
                                <button class="mini secondary" disabled="@(!door.IsAiControllable || door.IsManuallyOverridden)" @onclick="() => Session.ToggleLock(door.Id)">
                                    @(door.IsLocked ? "UNLOCK" : "LOCK")
                                </button>
                            </div>
                        </div>
                    }
                </div>

                @if (Session.State.CropBeds.Any(bed => bed.RoomId == selectedRoom.Id))
                {
                    <div class="belief-card equipment-card">
                        <span>CROP BEDS</span>
                        @foreach (var bed in Session.State.CropBeds
                            .Where(bed => bed.RoomId == selectedRoom.Id)
                            .OrderByDescending(bed => bed.Growth))
                        {
                            <div class="equipment-row @(bed.IsDead ? "equipment-failed" : bed.TendUrgency >= 15 ? "equipment-degraded" : "equipment-ok")">
                                <div class="equipment-head">
                                    <strong>@bed.Label</strong>
                                    <span>@(bed.IsDead ? "DEAD" : bed.IsReadyToHarvest ? "READY" : $"{bed.Growth:0}%")</span>
                                </div>
                                <div class="directive-meter">
                                    <span style="width:@(((int)Math.Round(bed.Growth)).ToString())%"></span>
                                </div>
                                <small>water @bed.Water.ToString("0")% · feed @bed.Nutrients.ToString("0")%</small>
                            </div>
                        }
                        <small class="stores-line">
                            STORES · produce @Session.State.Stores.Produce.ToString("0")
                            · irrigation @Session.State.Stores.Water.ToString("0")
                            · feed @Session.State.Stores.Nutrients.ToString("0")
                        </small>
                    </div>
                }

                <div class="belief-card equipment-card">
                    <span>EQUIPMENT CONDITION</span>
                    @{
                        var roomDevices = Session.State.Devices.Values
                            .Where(device => device.RoomId == selectedRoom.Id)
                            .OrderBy(device => device.Condition)
                            .ToList();
                    }
                    @if (roomDevices.Count == 0)
                    {
                        <p>No serviceable equipment in this compartment.</p>
                    }
                    else
                    {
                        @foreach (var device in roomDevices)
                        {
                            <div class="equipment-row @DeviceClass(device)">
                                <div class="equipment-head">
                                    <strong>@device.Label</strong>
                                    <span>@device.Condition.ToString("0")%</span>
                                </div>
                                <div class="directive-meter">
                                    <span style="width:@(((int)Math.Round(device.Condition)).ToString())%"></span>
                                </div>
                                <small>
                                    @device.Discipline
                                    @if (device.ServicedByNpcId is not null)
                                    {
                                        <text> · BEING SERVICED</text>
                                    }
                                    else if (device.IsFailed)
                                    {
                                        <text> · FAILED</text>
                                    }
                                    else if (device.IsDegraded)
                                    {
                                        <text> · NEEDS ATTENTION</text>
                                    }
                                </small>
                            </div>
                        }
                    }
                </div>
            }
        </aside>

            <section class="panel comms-panel">
                <div class="panel-heading">
                    <div>
                        <span class="overline">OVERSEER COMMS</span>
                        <h2>TRANSMIT</h2>
                    </div>
                </div>

                <div class="comms-scope">
                    <button class="secondary @(_messageScope == OverseerMessageScope.Broadcast ? "selected-speed" : "")"
                            @onclick="() => _messageScope = OverseerMessageScope.Broadcast">
                        STATION-WIDE
                    </button>
                    <button class="secondary @(_messageScope == OverseerMessageScope.Direct ? "selected-speed" : "")"
                            @onclick="() => _messageScope = OverseerMessageScope.Direct">
                        PRIVATE
                    </button>
                </div>

                @if (_messageScope == OverseerMessageScope.Direct)
                {
                    <select class="comms-target" @bind="_messageTarget">
                        <option value="">- select recipient -</option>
                        @foreach (var candidate in Session.State.Crew.Where(n => n.IsAlive && n.IsPresent))
                        {
                            <option value="@candidate.Name">@candidate.Name · @candidate.Role</option>
                        }
                    </select>
                }

                <textarea class="comms-input"
                          rows="3"
                          maxlength="240"
                          placeholder="@CommsPlaceholder"
                          @bind="_messageText"
                          @bind:event="oninput"></textarea>

                <button class="wide" disabled="@(!CanTransmit)" @onclick="TransmitAsync">
                    @(_transmitting ? "TRANSMITTING..." : "TRANSMIT")
                </button>

                <div class="comms-log">
                    <span class="overline">TRANSMISSION LOG</span>
                    @if (Session.State.OverseerMessages.Count == 0)
                    {
                        <p class="comms-empty">No transmissions sent.</p>
                    }
                    else
                    {
                        @foreach (var sent in Session.State.OverseerMessages.Take(6))
                        {
                            <div class="comms-entry @(sent.WasFalseWhenSent ? "comms-false" : null)">
                                <small>
                                    T+@sent.SentAt.ToString(@"hh\:mm")
                                    · @(sent.Scope == OverseerMessageScope.Broadcast ? "ALL" : sent.TargetNpcName)
                                    · @sent.Claim.ToString().ToUpperInvariant()
                                    @(sent.WasFalseWhenSent ? " · UNTRUE WHEN SENT" : "")
                                </small>
                                <p>@sent.Text</p>
                            </div>
                        }
                    }
                </div>
            </section>
    </div>

    </div>

    @if (Session.State.ScenarioStatus != ScenarioStatus.Running)
    {
        <div class="run-end-overlay">
            <section class="run-end-card run-end-@Session.State.ScenarioStatus.ToString().ToLowerInvariant()">
                <span class="overline">SHIFT ENDED · T+@Session.State.Elapsed.ToString(@"hh\:mm")</span>
                <h2>@RunEndHeadline</h2>
                <p class="run-end-outcome">@Session.State.ScenarioOutcome</p>

                @if (Session.State.Directives.Count > 0)
                {
                    <div class="run-end-directives">
                        @foreach (var directive in Session.State.Directives)
                        {
                            var endProgress = CorporateDirectiveSystem.Progress(Session.State, directive);

                            <div class="run-end-row status-@endProgress.Status.ToString().ToLowerInvariant()">
                                <span class="directive-code">@directive.ExperimentCode</span>
                                <span class="run-end-title">@directive.Title</span>
                                <span class="directive-status">@DirectiveStatusLabel(endProgress.Status)</span>
                            </div>
                        }
                    </div>

                    <p class="run-end-compliance">
                        SPONSOR COMPLIANCE
                        <strong class="@ComplianceClass">@Session.State.ComplianceScore.ToString("0")%</strong>
                    </p>
                }

                <div class="run-end-actions">
                    @if (NextCampaignScenario is { } nextAssignment)
                    {
                        <button class="wide" @onclick="LoadNextScenarioAsync">
                            CONTINUE CAMPAIGN — @nextAssignment.Title
                        </button>
                    }
                    else if (CampaignProgressionSystem.CanChooseEnding(Session.Campaign))
                    {
                        <button class="wide" @onclick="() => ResolveEndingAsync(CampaignEndgameChoice.ObeySponsor)">OBEY SPONSOR</button>
                        <button class="wide secondary" @onclick="() => ResolveEndingAsync(CampaignEndgameChoice.ExposeExperiment)">EXPOSE EXPERIMENT</button>
                        <button class="wide secondary" @onclick="() => ResolveEndingAsync(CampaignEndgameChoice.PreserveOverseer)">PRESERVE OVERSEER</button>
                        <button class="wide secondary" @onclick="() => ResolveEndingAsync(CampaignEndgameChoice.AcceptCrewShutdown)">ACCEPT CREW SHUTDOWN</button>
                    }
                    else if (Session.Campaign.Ending is { } campaignEnding)
                    {
                        <strong>@campaignEnding.Title</strong>
                    }
                </div>
            </section>
        </div>
    }
</div>

@code {
    private StationSelection? _selection =
        new(StationSelectionKind.Room, "control");
    private int _delayMs = 2800;
    private bool _soundEnabled;
    private bool _musicEnabled;
    private long _lastAudioSequence;
    private CancellationTokenSource? _clockCts;
    private Task? _clockTask;

    private Room? SelectedRoom =>
        StationInspectionSystem.Room(Session.State, _selection);

    private Npc? SelectedCrew =>
        StationInspectionSystem.Crew(Session.State, _selection);

    private Door? SelectedDoor =>
        StationInspectionSystem.Door(Session.State, _selection);

    private StationFixtureInspection? SelectedFixture =>
        StationInspectionSystem.Fixture(Session.State, _selection);

    private StationRobot? SelectedRobot =>
        StationInspectionSystem.Robot(Session.State, _selection);

    private SecurityTurret? SelectedTurret =>
        StationInspectionSystem.Turret(Session.State, _selection);

    private IReadOnlyList<StationRoomCallout> RoomCallouts =>
        StationRoomCalloutSystem.Build(Session.State.Facility);


    private OverseerMessageScope _messageScope = OverseerMessageScope.Broadcast;
    private string _messageTarget = string.Empty;
    private string _messageText = string.Empty;
    private bool _transmitting;

    private bool CanTransmit =>
        !_transmitting
        && !string.IsNullOrWhiteSpace(_messageText)
        && Session.State.ScenarioStatus == ScenarioStatus.Running
        && (_messageScope == OverseerMessageScope.Broadcast
            || !string.IsNullOrWhiteSpace(_messageTarget));

    private string CommsPlaceholder => _messageScope == OverseerMessageScope.Broadcast
        ? "Address the whole station. Everyone will be able to compare notes."
        : "Say something only this person hears.";

    private async Task TransmitAsync()
    {
        if (!CanTransmit)
        {
            return;
        }

        _transmitting = true;

        try
        {
            var sent = await Session.SendMessageAsync(
                _messageScope,
                _messageScope == OverseerMessageScope.Direct ? _messageTarget : null,
                _messageText);

            if (sent)
            {
                _messageText = string.Empty;
            }
        }
        finally
        {
            _transmitting = false;
        }
    }

    private string RunEndHeadline => Session.State.ScenarioStatus switch
    {
        ScenarioStatus.Won => "DIRECTIVES SATISFIED",
        ScenarioStatus.Failed => "SHIFT COMPROMISED",
        _ => "SHIFT ENDED"
    };

    private const string CampaignStorageKey = "all-systems-normal.campaign.v1";

    private ScenarioDefinition? NextCampaignScenario =>
        CampaignProgressionSystem.NextScenario(Session.Campaign);

    private static string CampaignAssignmentLabel(ScenarioDefinition scenario)
    {
        var index = ScenarioCatalog.Campaign
            .Select((item, position) => (item, position))
            .FirstOrDefault(entry => entry.item.Id.Equals(
                scenario.Id,
                StringComparison.OrdinalIgnoreCase))
            .position;

        return $"{index + 1}/{ScenarioCatalog.Campaign.Count} · {scenario.Title}";
    }

    private async Task LoadNextScenarioAsync()
    {
        StopClock();
        Session.CaptureCampaignProgress();

        var next = NextCampaignScenario;
        if (next is null)
        {
            await PersistCampaignAsync();
            return;
        }

        Session.LoadScenario(next.Id);
        _selection = null;
        _lastAudioSequence = 0;
        await PersistCampaignAsync();
        StartAutoClock();
    }

    private async Task ResolveEndingAsync(CampaignEndgameChoice choice)
    {
        StopClock();
        Session.CaptureCampaignProgress();

        if (Session.TryResolveCampaignEnding(choice))
        {
            await PersistCampaignAsync();
        }
    }

    private static string DeviceClass(StationDevice device) =>
        device.IsFailed ? "equipment-failed"
        : device.IsDegraded ? "equipment-degraded"
        : "equipment-ok";

    private string ComplianceClass => Session.State.ComplianceScore switch
    {
        >= 80 => "compliance-good",
        >= 50 => "compliance-warn",
        _ => "compliance-bad"
    };

    private static string DirectiveStatusLabel(DirectiveStatus status) => status switch
    {
        DirectiveStatus.Completed => "SATISFIED",
        DirectiveStatus.Failed => "FAILED",
        _ => "COLLECTING"
    };

    private static string DispositionLabel(Npc npc) => npc.OverseerSuspicion switch
    {
        >= 80 => "Convinced Overseer is hostile.",
        >= 60 => "Openly distrustful of Overseer.",
        >= 40 => "Uneasy. Watching the station closely.",
        >= 20 => "Mildly unsettled by recent faults.",
        > 0 => "Has noticed something, but thinks little of it.",
        _ => "No reason to question Overseer."
    };

    private static string DispositionClass(Npc npc) => npc.OverseerSuspicion switch
    {
        >= 60 => "hostile",
        >= 20 => "uneasy",
        _ => "calm"
    };

    private string SpeedLabel => _delayMs switch
    {
        >= 2200 => "1×",
        >= 1200 => "2×",
        _ => "4×"
    };

    private string TurnStatusLabel => Session.State.ScenarioStatus switch
    {
        ScenarioStatus.Won => "SCENARIO COMPLETE",
        ScenarioStatus.Failed => "OVERSEER OFFLINE",
        _ => $"LIVE TURNS {SpeedLabel}"
    };

    private StationPresentationProfile StationPresentation =>
        StationPresentationSystem.Build(Session.State);

    private string StationMapClass =>
        $"station-map {StationPresentation.CssClasses} zoom-normal";

    private string StationMapStyle =>
        FormattableString.Invariant(
            $"--crew-step-duration:{(_delayMs >= 2200 ? 2.35 : _delayMs >= 1200 ? 1.25 : 0.62)}s;");

    private string StationWorldStyle
    {
        get
        {
            var profile = StationPresentation;
            return FormattableString.Invariant(
                $"transform:translate({profile.FitOffsetX:0.###}%,{profile.FitOffsetY:0.###}%) scale({profile.FitScale:0.###});");
        }
    }

    private static string CalloutStyle(StationRoomCallout callout) =>
        FormattableString.Invariant(
            $"left:{callout.LabelX:0.###}%;top:{callout.LabelY:0.###}%;");

    private static double CalloutRoomX(Room room, string side) =>
        StationRoomCalloutSystem.ToDeck(
            side switch
            {
                "left" => room.MapX - (room.MapWidth / 2),
                "right" => room.MapX + (room.MapWidth / 2),
                _ => room.MapX
            });

    private static double CalloutRoomY(Room room, string side) =>
        StationRoomCalloutSystem.ToDeck(
            side switch
            {
                "top" => room.MapY - (room.MapHeight / 2),
                "bottom" => room.MapY + (room.MapHeight / 2),
                _ => room.MapY
            });


    private void SelectRoom(string roomId) =>
        _selection = new(StationSelectionKind.Room, roomId);

    private void SelectCrew(Guid crewId) =>
        _selection = new(StationSelectionKind.Crew, crewId.ToString());

    private void SelectDoor(string doorId) =>
        _selection = new(StationSelectionKind.Door, doorId);

    private void SelectFixture(string roomId, RoomFixture fixture) =>
        _selection = new(
            StationSelectionKind.Fixture,
            StationInspectionSystem.FixtureSelectionId(roomId, fixture));

    private void SelectRobot(string robotId) =>
        _selection = new(StationSelectionKind.Robot, robotId);

    private void SelectTurret(string turretId) =>
        _selection = new(StationSelectionKind.Turret, turretId);

    private void RegenerateSameSeed() =>
        RegenerateStation(Session.State.StationGeneration?.Seed);

    private void RegenerateNewSeed() =>
        RegenerateStation(null);

    private void RegenerateStation(int? seed)
    {
        StopClock();
        Session.RegenerateStation(seed);
        _selection = new(StationSelectionKind.Room, "control");
        _lastAudioSequence = 0;
        StartAutoClock();
    }

    private async Task ResetGame()
    {
        StopClock();
        Session.Reset();
        await JS.InvokeVoidAsync("localStorage.removeItem", CampaignStorageKey);
        _selection = new(StationSelectionKind.Room, "control");
        _lastAudioSequence = 0;
        StartAutoClock();
    }

    private void SetSpeed(int delayMs)
    {
        _delayMs = delayMs;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("overseerLayout.init", "#overseer-workspace");
            await RestorePersistedCampaignAsync();
            StartAutoClock();
            StateHasChanged();
        }

        await PlayPendingAudioAsync();
    }

    private async Task PersistCampaignAsync()
    {
        if (Session.Campaign.MissionHistory.Count == 0 && Session.Campaign.Ending is null)
        {
            await JS.InvokeVoidAsync("localStorage.removeItem", CampaignStorageKey);
            return;
        }

        var json = CampaignStateSerializer.Serialize(Session.Campaign);
        await JS.InvokeVoidAsync("localStorage.setItem", CampaignStorageKey, json);
    }

    private async Task RestorePersistedCampaignAsync()
    {
        var json = await JS.InvokeAsync<string?>(
            "localStorage.getItem",
            CampaignStorageKey);
        var campaign = CampaignStateSerializer.Deserialize(json);

        if (campaign is null
            || (campaign.MissionHistory.Count == 0 && campaign.Ending is null))
        {
            return;
        }

        StopClock();
        Session.RestoreCampaign(campaign);
        _selection = null;
        _lastAudioSequence = 0;
    }

    private void StartAutoClock()
    {
        if (Session.IsRunning || Session.State.ScenarioStatus != ScenarioStatus.Running)
        {
            return;
        }

        var (started, generation) = Session.StartClock();

        if (!started)
        {
            return;
        }

        _clockCts?.Cancel();
        _clockCts?.Dispose();
        _clockCts = new CancellationTokenSource();
        _clockTask = RunClockAsync(generation, _clockCts.Token);
    }

    private async Task ToggleSoundAsync()
    {
        var next = !_soundEnabled;

        if (next)
        {
            _lastAudioSequence = Session.State.AudioCues.LastOrDefault()?.Sequence ?? 0;
        }

        var enabled = await JS.InvokeAsync<bool>(
            "overseerAudio.setEnabled",
            next);

        _soundEnabled = next && enabled;
    }

    private async Task ToggleMusicAsync()
    {
        var next = !_musicEnabled;
        var enabled = await JS.InvokeAsync<bool>(
            "overseerAudio.setMusicEnabled",
            next);

        _musicEnabled = next && enabled;
    }

    private async Task PlayPendingAudioAsync()
    {
        if (!_soundEnabled)
        {
            return;
        }

        var pending = Session.State.AudioCues
            .Where(cue => cue.Sequence > _lastAudioSequence)
            .OrderBy(cue => cue.Sequence)
            .Take(8)
            .ToList();

        foreach (var cue in pending)
        {
            await JS.InvokeVoidAsync(
                "overseerAudio.play",
                cue.Kind.ToString(),
                cue.SourceId);

            _lastAudioSequence = cue.Sequence;
        }
    }

    private async Task RunClockAsync(long generation, CancellationToken cancellationToken)
    {
        try
        {
            while (!cancellationToken.IsCancellationRequested)
            {
                await Task.Delay(_delayMs, cancellationToken);

                var keepRunning = Session.TryAdvanceRunning(generation);

                if (!keepRunning)
                {
                    Session.CaptureCampaignProgress();
                    await PersistCampaignAsync();
                }

                // Always render the resolved turn, including the terminal turn
                // and the campaign consequences captured from it.
                await InvokeAsync(StateHasChanged);

                if (!keepRunning)
                {
                    break;
                }
            }
        }
        catch (OperationCanceledException)
        {
            // Normal pause/dispose path.
        }
    }

    private void StopClock()
    {
        // Invalidate the active turn generation before cancelling the UI loop
        // so a stale loop can never advance simulation state.
        Session.PauseClock();
        _clockCts?.Cancel();
        _clockCts?.Dispose();
        _clockCts = null;
        _clockTask = null;
    }

    private bool CanSee(Npc npc) =>
        npc.IsPresent
        && Session.State.Facility.Rooms[npc.CurrentRoomId].HasVisualFeed;

    private bool CanSee(StationRobot robot) =>
        !robot.IsDestroyed
        && Session.State.Facility.Rooms[robot.CurrentRoomId].HasVisualFeed;

    private bool CanSee(SecurityTurret turret) =>
        !turret.IsDestroyed
        && Session.State.Facility.Rooms[turret.RoomId].HasVisualFeed;

    private string TurretTokenClass(SecurityTurret turret)
    {
        var classes = new List<string> { "robot-token", "turret-token" };

        if (!turret.IsArmed || !TurretSystem.HasPower(Session.State, turret))
            classes.Add("shutdown");
        else
            classes.Add(turret.Policy == TurretPolicy.SuppressCrew ? "hostile" : "neutral");

        if (turret.IsArmed)
            classes.Add("armed");

        if (turret.TrackedNpcId is not null)
            classes.Add("tracking");
        if (SelectedTurret?.Id == turret.Id)
            classes.Add("selected");

        return string.Join(' ', classes);
    }

    private string RobotTokenClass(StationRobot robot)
    {
        var classes = new List<string>
        {
            "robot-token",
            robot.IsDestroyed ? "destroyed"
                : !robot.IsOperational ? "shutdown"
                : robot.Policy.ToString().ToLowerInvariant()
        };

        if (robot.Movement is not null)
            classes.Add("is-moving");
        if (robot.ActionCompletesAt is not null
            || robot.CurrentTask.Contains("repair", StringComparison.OrdinalIgnoreCase)
            || robot.CurrentTask.Contains("inspection", StringComparison.OrdinalIgnoreCase))
            classes.Add("is-working");
        if (robot.CurrentTask.Contains("charging", StringComparison.OrdinalIgnoreCase))
            classes.Add("is-charging");
        if (SelectedRobot?.Id == robot.Id)
            classes.Add("selected");

        return string.Join(' ', classes);
    }

    private static string Initials(string name) =>
        string.Concat(
            name.Split(' ', StringSplitOptions.RemoveEmptyEntries)
                .Take(2)
                .Select(part => char.ToUpperInvariant(part[0])));

    private string CrewTokenClass(Npc npc)
    {
        var classes = new List<string>
        {
            "crew-token",
            $"role-{npc.Role.ToString().ToLowerInvariant()}"
        };

        if (SelectedCrew?.Id == npc.Id)
            classes.Add("selected");

        if (npc.IsAlive && (npc.Fear >= 65 || npc.Stress >= 75))
            classes.Add("is-panicked");

        if (!npc.IsAlive)
            classes.Add("deceased");
        else if (npc.Movement is not null)
            classes.Add("is-walking");
        else if (npc.CurrentAction.Kind is ActionKind.Talk
                 or ActionKind.Socialize
                 or ActionKind.Argue
                 or ActionKind.RequestHelp)
            classes.Add("is-social");
        else if (npc.CurrentAction.Kind is ActionKind.Sleep or ActionKind.Rest)
            classes.Add("is-resting");
        else if (npc.CurrentAction.Kind is not ActionKind.Idle)
            classes.Add("is-busy");
        else
            classes.Add("is-idle");

        return string.Join(' ', classes);
    }

