@page "/"
@implements IAsyncDisposable
@inject GameSession Session

<PageTitle>All Systems Normal</PageTitle>

<div class="game-shell">
    <header class="command-bar">
        <div class="brand">
            <span class="overline">FACILITY OVERSEER // ACTIVE</span>
            <h1>ALL SYSTEMS NORMAL</h1>
        </div>

        <div class="status-strip">
            <div>
                <span>MISSION</span>
                <strong>T+@Session.State.Elapsed.ToString(@"hh\:mm")</strong>
            </div>
            <div>
                <span>POWER</span>
                <strong>@Session.PoweredRoomCount/@Session.State.Facility.Rooms.Count</strong>
            </div>
            <div>
                <span>CAMERAS</span>
                <strong>@Session.CameraCount/@Session.State.Facility.Rooms.Count</strong>
            </div>
            <div class="@(Session.AlertCount > 0 ? "has-alerts" : "")">
                <span>ALERTS</span>
                <strong>@Session.AlertCount</strong>
            </div>
        </div>

        <div class="time-controls">
            <button class="@(Session.IsRunning ? "danger" : "")" @onclick="ToggleRunAsync">
                @(Session.IsRunning ? "PAUSE" : "RUN")
            </button>
            <button class="secondary" @onclick="() => SetSpeed(1200)">1×</button>
            <button class="secondary" @onclick="() => SetSpeed(450)">4×</button>
            <button class="secondary" @onclick="() => SetSpeed(160)">12×</button>
            <button class="secondary" @onclick="() => StepMinutes(1)">+1m</button>
            <button class="secondary" @onclick="ResetGame">RESET</button>
        </div>
    </header>

    <div class="operations-grid">
        <aside class="systems-panel panel">
            <div class="panel-heading">
                <div>
                    <span class="overline">FACILITY</span>
                    <h2>SYSTEMS</h2>
                </div>
                <span class="live-indicator">LIVE</span>
            </div>

            <div class="room-list">
                @foreach (var room in Session.State.Facility.Rooms.Values.OrderBy(room => room.Name))
                {
                    <button @key="room.Id"
                            class="@($"room-list-item {(SelectedRoom?.Id == room.Id ? "selected" : "")}")"
                            @onclick="() => SelectRoom(room.Id)">
                        <span class="system-dot @RoomHealthClass(room)"></span>
                        <span>
                            <strong>@room.Name</strong>
                            <small>
                                @(room.IsPowered ? "PWR" : "NO PWR")
                                · @(room.CameraOnline ? "CAM" : "CAM OFF")
                            </small>
                        </span>
                    </button>
                }
            </div>

            <div class="legend">
                <span><i class="legend-dot crew"></i> visible crew</span>
                <span><i class="legend-dot open"></i> open door</span>
                <span><i class="legend-dot locked"></i> locked door</span>
            </div>
        </aside>

        <main class="station-panel panel">
            <div class="panel-heading map-heading">
                <div>
                    <span class="overline">DECK A // INTERNAL SURVEILLANCE</span>
                    <h2>STATION OVERVIEW</h2>
                </div>
                <span class="@(Session.IsRunning ? "sim-running" : "sim-paused")">
                    @(Session.IsRunning ? $"RUNNING {SpeedLabel}" : "PAUSED")
                </span>
            </div>

            <div class="station-map">
                <svg class="connection-layer" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
                    @foreach (var door in Session.State.Facility.Doors)
                    {
                        var a = Session.State.Facility.Rooms[door.RoomAId];
                        var b = Session.State.Facility.Rooms[door.RoomBId];

                        <line @key="door.Id"
                              x1="@a.MapX" y1="@a.MapY" x2="@b.MapX" y2="@b.MapY"
                              class="@($"connection {(door.IsOpen ? "open" : "closed")} {(door.IsLocked ? "locked" : "")}")" />
                    }
                </svg>

                @foreach (var room in Session.State.Facility.Rooms.Values)
                {
                    <button @key="room.Id"
                            class="@RoomClass(room)"
                            style="@RoomStyle(room)"
                            aria-label="@($"Select {room.Name}")"
                            @onclick="() => SelectRoom(room.Id)">
                        <span class="room-name">@room.Name</span>
                        <span class="room-data">
                            <b>@(room.IsPowered ? "PWR" : "OFF")</b>
                            <b>@room.TemperatureC.ToString("0")°</b>
                            <b>O₂ @room.OxygenPercent.ToString("0.0")</b>
                        </span>

                        <span class="fixture-layer" aria-hidden="true">
                            @foreach (var fixture in room.Fixtures)
                            {
                                <i @key="fixture"
                                   class="@FixtureClass(fixture)"
                                   style="@FixtureStyle(fixture)"
                                   title="@fixture.Label"></i>
                            }
                        </span>

                        @if (!room.HasVisualFeed)
                        {
                            <span class="signal-lost">VISUAL LOST</span>
                        }
                        else if (!room.LightsOn)
                        {
                            <span class="lights-out">LIGHTS OFF</span>
                        }
                    </button>
                }

                @foreach (var door in Session.State.Facility.Doors)
                {
                    <button @key="door.Id"
                            class="@DoorClass(door)"
                            style="@DoorStyle(door)"
                            title="@DoorTitle(door)"
                            aria-label="@DoorTitle(door)"
                            @onclick="() => Session.ToggleDoor(door.Id)">
                        @(door.IsLocked ? "L" : door.IsOpen ? "O" : "C")
                    </button>
                }

                @foreach (var npc in Session.State.Crew.Where(CanSee))
                {
                    <button @key="npc.Id"
                            class="@($"crew-token role-{npc.Role.ToString().ToLowerInvariant()} {(SelectedCrew?.Id == npc.Id ? "selected" : "")} {(!npc.IsAlive ? "deceased" : "")}")"
                            style="@CrewStyle(npc)"
                            title="@($"{npc.Name} — {npc.Role}{(!npc.IsAlive ? " — DECEASED" : "")}")"
                            aria-label="@($"Select {npc.Name}")"
                            @onclick="() => SelectCrew(npc.Id)">
                        @if (npc.IsAlive)
                        {
                            <span class="person-icon" aria-hidden="true"><i class="person-head"></i><i class="person-body"></i></span>
                            <span class="crew-initials">@Initials(npc.Name)</span>
                        }
                        else
                        {
                            <span class="body-marker" aria-hidden="true">×</span>
                        }
                    </button>
                }
            </div>

            <div class="map-footer">
                <span>Click a room or crew member to inspect it.</span>
                <span>Crew disappear from the map when a camera feed is lost.</span>
            </div>
        </main>

        <aside class="inspector-panel panel">
            @if (SelectedCrew is { } selectedCrew)
            {
                var crewRoom = Session.State.Facility.Rooms[selectedCrew.CurrentRoomId];

                <div class="panel-heading">
                    <div>
                        <span class="overline">CREW TELEMETRY</span>
                        <h2>@selectedCrew.Name</h2>
                    </div>
                    <span class="crew-badge">@Initials(selectedCrew.Name)</span>
                </div>

                <p class="role-line">@selectedCrew.Role · @crewRoom.Name</p>

                @if (!crewRoom.HasVisualFeed)
                {
                    <div class="warning-box">CAMERA FEED LOST — location is telemetry only.</div>
                }

                <div class="metric-list">
                    @Metric("HEALTH", selectedCrew.Health)
                    @Metric("HUNGER", selectedCrew.Hunger)
                    @Metric("FATIGUE", selectedCrew.Fatigue)
                    @Metric("FEAR", selectedCrew.Fear)
                    @Metric("STRESS", selectedCrew.Stress)
                </div>

                <div class="thought-card">
                    <span>CURRENT GOAL · @selectedCrew.MindMode.ToUpperInvariant()</span>
                    <strong>@(selectedCrew.Intent?.Goal ?? "No active deliberate goal")</strong>
                    <p>@selectedCrew.LastThought</p>
                    @if (selectedCrew.Intent is { } intent)
                    {
                        <small>Urgency @intent.Urgency/100 · chosen T+@intent.CreatedAt.ToString(@"hh\:mm")</small>
                    }
                </div>

                <div class="action-card">
                    <span>CURRENT PHYSICAL ACTION</span>
                    <strong>@selectedCrew.CurrentAction.Kind</strong>
                    <p>@selectedCrew.CurrentAction.Reason</p>
                </div>

                <div class="belief-card">
                    <span>BELIEF ABOUT OVERSEER</span>
                    <p>@selectedCrew.Beliefs.FirstOrDefault()?.Statement</p>
                </div>

                <div class="relationship-card">
                    <span>RELATIONSHIPS</span>
                    @foreach (var relationship in selectedCrew.Relationships.Values
                        .OrderByDescending(r => r.Resentment)
                        .ThenByDescending(r => r.Trust))
                    {
                        <div class="relationship-row">
                            <strong>@relationship.PersonName</strong>
                            <small>Trust @relationship.Trust.ToString("0") · Affinity @relationship.Affinity.ToString("0") · Resentment @relationship.Resentment.ToString("0")</small>
                        </div>
                    }
                </div>

                @if (!selectedCrew.IsAlive)
                {
                    <div class="warning-box">@selectedCrew.CauseOfDeath</div>
                }
            }
            else if (SelectedRoom is { } selectedRoom)
            {
                <div class="panel-heading">
                    <div>
                        <span class="overline">ROOM CONTROL</span>
                        <h2>@selectedRoom.Name</h2>
                    </div>
                    <span class="system-dot @RoomHealthClass(selectedRoom)"></span>
                </div>

                <div class="environment-grid">
                    <div><span>POWER</span><strong>@(selectedRoom.IsPowered ? "ONLINE" : "OFFLINE")</strong></div>
                    <div><span>CAMERA</span><strong>@(selectedRoom.CameraOnline ? "ONLINE" : "OFFLINE")</strong></div>
                    <div><span>LIGHTS</span><strong>@(selectedRoom.LightsOn ? "ON" : "OFF")</strong></div>
                    <div><span>TEMP</span><strong>@selectedRoom.TemperatureC.ToString("0.0")°C</strong></div>
                    <div><span>OXYGEN</span><strong>@selectedRoom.OxygenPercent.ToString("0.0")%</strong></div>
                    <div><span>OCCUPANTS</span><strong>@VisibleOccupantLabel(selectedRoom)</strong></div>
                </div>

                <div class="control-stack">
                    <button class="wide" @onclick="() => Session.ToggleRoomPower(selectedRoom.Id)">
                        @(selectedRoom.IsPowered ? "CUT ROOM POWER" : "RESTORE ROOM POWER")
                    </button>
                    <button class="wide secondary" disabled="@(!selectedRoom.IsPowered)"
                            @onclick="() => Session.ToggleLights(selectedRoom.Id)">
                        @(selectedRoom.LightsOn ? "LIGHTS OFF" : "LIGHTS ON")
                    </button>
                    <button class="wide secondary" disabled="@(!selectedRoom.IsPowered)"
                            @onclick="() => Session.ToggleCamera(selectedRoom.Id)">
                        @(selectedRoom.CameraOnline ? "DISABLE CAMERA" : "RESTORE CAMERA")
                    </button>
                </div>

                <div class="door-control-list">
                    <span class="subheading">CONNECTED DOORS</span>
                    @foreach (var door in ConnectedDoors(selectedRoom))
                    {
                        var other = OtherRoom(door, selectedRoom.Id);

                        <div class="door-control">
                            <div>
                                <strong>@other.Name</strong>
                                <small>@(door.IsOpen ? "OPEN" : "CLOSED") · @(door.IsLocked ? "LOCKED" : "UNLOCKED")</small>
                            </div>
                            <div>
                                <button class="mini" @onclick="() => Session.ToggleDoor(door.Id)">
                                    @(door.IsOpen ? "CLOSE" : "OPEN")
                                </button>
                                <button class="mini secondary" @onclick="() => Session.ToggleLock(door.Id)">
                                    @(door.IsLocked ? "UNLOCK" : "LOCK")
                                </button>
                            </div>
                        </div>
                    }
                </div>
            }
        </aside>
    </div>

    <section class="event-panel panel">
        <div class="panel-heading">
            <div>
                <span class="overline">FACILITY MEMORY</span>
                <h2>EVENT STREAM</h2>
            </div>
            <span>@Session.State.EventLog.Count RECORDS</span>
        </div>

        <div class="event-log">
            @foreach (var entry in Session.State.EventLog.Take(12))
            {
                <p>@entry</p>
            }
        </div>
    </section>
</div>

@code {
    private string? _selectedRoomId = "control";
    private Guid? _selectedCrewId;
    private int _delayMs = 1200;
    private CancellationTokenSource? _clockCts;
    private Task? _clockTask;

    private Room? SelectedRoom =>
        _selectedRoomId is not null
            && Session.State.Facility.Rooms.TryGetValue(_selectedRoomId, out var room)
                ? room
                : null;

    private Npc? SelectedCrew =>
        _selectedCrewId is { } crewId
            ? Session.State.Crew.FirstOrDefault(npc => npc.Id == crewId)
            : null;

    private string SpeedLabel => _delayMs switch
    {
        >= 1000 => "1×",
        >= 300 => "4×",
        _ => "12×"
    };

    private void SelectRoom(string roomId)
    {
        _selectedRoomId = roomId;
        _selectedCrewId = null;
    }

    private void SelectCrew(Guid crewId)
    {
        _selectedCrewId = crewId;
        _selectedRoomId = null;
    }

    private void StepMinutes(int minutes)
    {
        Session.AdvanceMinutes(minutes);
    }

    private void ResetGame()
    {
        StopClock();
        Session.Reset();
        _selectedRoomId = "control";
        _selectedCrewId = null;
    }

    private void SetSpeed(int delayMs)
    {
        _delayMs = delayMs;
    }

    private Task ToggleRunAsync()
    {
        if (Session.IsRunning)
        {
            StopClock();
            return Task.CompletedTask;
        }

        var (started, generation) = Session.StartClock();

        if (!started)
        {
            return Task.CompletedTask;
        }

        _clockCts?.Cancel();
        _clockCts?.Dispose();
        _clockCts = new CancellationTokenSource();
        _clockTask = RunClockAsync(generation, _clockCts.Token);
        return Task.CompletedTask;
    }

    private async Task RunClockAsync(long generation, CancellationToken cancellationToken)
    {
        try
        {
            while (!cancellationToken.IsCancellationRequested)
            {
                await Task.Delay(_delayMs, cancellationToken);

                if (!Session.TryAdvanceRunning(generation))
                {
                    break;
                }

                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // Normal pause/dispose path.
        }
    }

    private void StopClock()
    {
        // Pause first. This invalidates every prior clock generation, so even a
        // stale UI loop cannot advance simulation time after PAUSE.
        Session.PauseClock();
        _clockCts?.Cancel();
        _clockCts?.Dispose();
        _clockCts = null;
        _clockTask = null;
    }

    private bool CanSee(Npc npc) =>
        Session.State.Facility.Rooms[npc.CurrentRoomId].HasVisualFeed;

    private static string Initials(string name) =>
        string.Concat(
            name.Split(' ', StringSplitOptions.RemoveEmptyEntries)
                .Take(2)
                .Select(part => char.ToUpperInvariant(part[0])));

    private static string FixtureClass(RoomFixture fixture) =>
        $"fixture fixture-{fixture.Type.ToString().ToLowerInvariant()}";

    private static string FixtureStyle(RoomFixture fixture) =>
        FormattableString.Invariant(
            $"left:{fixture.X}%;top:{fixture.Y}%;width:{fixture.Width}%;height:{fixture.Height}%;");

    private static RenderFragment Metric(string label, double value) => builder =>
    {
        var safeValue = Math.Clamp(value, 0, 100);
        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", "metric");
        builder.OpenElement(2, "div");
        builder.OpenElement(3, "span");
        builder.AddContent(4, label);
        builder.CloseElement();
        builder.OpenElement(5, "strong");
        builder.AddContent(6, safeValue.ToString("0"));
        builder.CloseElement();
        builder.CloseElement();
        builder.OpenElement(7, "progress");
        builder.AddAttribute(8, "max", "100");
        builder.AddAttribute(9, "value", safeValue);
        builder.CloseElement();
        builder.CloseElement();
    };

    private static string RoomHealthClass(Room room) =>
        !room.IsPowered ? "critical"
        : !room.CameraOnline ? "warning"
        : "healthy";

    private string RoomClass(Room room)
    {
        var classes = new List<string> { "room-node" };

        if (SelectedRoom?.Id == room.Id)
            classes.Add("selected");

        if (!room.IsPowered)
            classes.Add("no-power");
        else if (!room.CameraOnline)
            classes.Add("camera-off");

        if (!room.LightsOn)
            classes.Add("lights-off");

        return string.Join(' ', classes);
    }

    private static string RoomStyle(Room room) =>
        FormattableString.Invariant(
            $"left:{room.MapX}%;top:{room.MapY}%;width:{room.MapWidth}%;height:{room.MapHeight}%;");

    private string CrewStyle(Npc npc)
    {
        var room = Session.State.Facility.Rooms[npc.CurrentRoomId];
        var occupants = Session.State.Crew
            .Where(other => other.CurrentRoomId == npc.CurrentRoomId)
            .OrderBy(other => other.Name)
            .ToList();

        var index = occupants.FindIndex(other => other.Id == npc.Id);
        var offsets = new (double X, double Y)[]
        {
            (-2.4, -1.6),
            (2.4, -1.6),
            (-2.4, 1.8),
            (2.4, 1.8),
            (0, 0)
        };
        var offset = offsets[Math.Max(0, index) % offsets.Length];

        return FormattableString.Invariant(
            $"left:{room.MapX + offset.X}%;top:{room.MapY + offset.Y}%;");
    }

    private string DoorStyle(Door door)
    {
        var a = Session.State.Facility.Rooms[door.RoomAId];
        var b = Session.State.Facility.Rooms[door.RoomBId];

        return FormattableString.Invariant(
            $"left:{(a.MapX + b.MapX) / 2}%;top:{(a.MapY + b.MapY) / 2}%;");
    }

    private static string DoorClass(Door door) =>
        $"map-door {(door.IsLocked ? "locked" : door.IsOpen ? "open" : "closed")}";

    private string DoorTitle(Door door)
    {
        var a = Session.State.Facility.Rooms[door.RoomAId];
        var b = Session.State.Facility.Rooms[door.RoomBId];
        var state = door.IsLocked ? "locked" : door.IsOpen ? "open" : "closed";
        return $"{a.Name} ↔ {b.Name}: {state}. Click to toggle open/closed.";
    }

    private IEnumerable<Door> ConnectedDoors(Room room) =>
        Session.State.Facility.Doors.Where(door =>
            door.RoomAId == room.Id || door.RoomBId == room.Id);

    private Room OtherRoom(Door door, string roomId) =>
        Session.State.Facility.Rooms[
            door.RoomAId == roomId ? door.RoomBId : door.RoomAId];

    private string VisibleOccupantLabel(Room room)
    {
        if (!room.HasVisualFeed)
            return "UNKNOWN";

        return Session.State.Crew.Count(npc => npc.CurrentRoomId == room.Id).ToString();
    }

    public async ValueTask DisposeAsync()
    {
        var task = _clockTask;
        StopClock();

        if (task is not null)
        {
            try
            {
                await task;
            }
            catch (OperationCanceledException)
            {
            }
        }
    }
}
