    private static RenderFragment Metric(string label, double value) => builder =>
    {
        var safeValue = Math.Clamp(value, 0, 100);
        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", "metric");
        builder.OpenElement(2, "div");
        builder.OpenElement(3, "span");
        builder.AddContent(4, label);
        builder.CloseElement();
        builder.OpenElement(5, "strong");
        builder.AddContent(6, safeValue.ToString("0"));
        builder.CloseElement();
        builder.CloseElement();
        builder.OpenElement(7, "progress");
        builder.AddAttribute(8, "max", "100");
        builder.AddAttribute(9, "value", safeValue);
        builder.CloseElement();
        builder.CloseElement();
    };

    private static string RoomHealthClass(Room room) =>
        !room.IsPowered
        || room.OxygenPercent < 17
        || room.CarbonDioxidePercent > 3
        || room.PressureKpa < 80
        || room.TemperatureC is < 5 or > 38
            ? "critical"
        : !room.CameraOnline
          || room.OxygenPercent < 19.5
          || room.CarbonDioxidePercent > 1
          || room.PressureKpa < 90
          || room.TemperatureC is < 16 or > 28
            ? "warning"
        : "healthy";

    private static string PowerStatusClass(Room room) =>
        room.IsPowered ? "good" : "bad";

    private static string TemperatureStatusClass(Room room) =>
        room.TemperatureC is < 8 or > 35
            ? "bad"
            : room.TemperatureC is < 16 or > 28
                ? "warn"
                : "good";

    private static string OxygenStatusClass(Room room) =>
        room.OxygenPercent < 17
            ? "bad"
            : room.OxygenPercent < 19.5
                ? "warn"
                : "good";

    private string RoomClass(Room room)
    {
        var classes = new List<string>
        {
            "room-node",
            $"room-type-{room.Type.ToString().ToLowerInvariant()}",
            StationPresentationSystem.RoomScaleClass(room)
        };

        if (room.HasExteriorHatch)
            classes.Add("exterior-module");

        if (room.Type == RoomType.Corridor)
        {
            if (room.Id.Equals("corridor", StringComparison.OrdinalIgnoreCase))
            {
                classes.Add("main-corridor");
            }
            else
            {
                classes.Add("hallway");
                var vertical = IsConnectorHallway(room)
                    ? IsVerticalHallway(room)
                    : room.MapHeight > room.MapWidth;
                classes.Add(vertical ? "hallway-vertical" : "hallway-horizontal");
            }
        }

        if (SelectedRoom?.Id == room.Id)
            classes.Add("selected");

        if (room.HasExteriorHatch && room.ExteriorHatchOpen)
            classes.Add("vacuum-open");

        if (!room.IsPowered)
            classes.Add("no-power");
        else if (!room.CameraOnline)
            classes.Add("camera-off");

        if (!room.LightsOn)
            classes.Add("lights-off");

        return string.Join(' ', classes);
    }

    private static string RoomStyle(Room room) =>
        FormattableString.Invariant(
            $"left:{room.MapX}%;top:{room.MapY}%;width:{room.MapWidth}%;height:{room.MapHeight}%;");

    private string CrewStyle(Npc npc)
    {
        var room = Session.State.Facility.Rooms[npc.CurrentRoomId];
        var mapX = room.MapX
            + (((npc.PositionX - 50) / 100) * room.MapWidth);
        var mapY = room.MapY
            + (((npc.PositionY - 50) / 100) * room.MapHeight);

        var facing = CrewFacingAngle(npc);

        return FormattableString.Invariant(
            $"left:{mapX}%;top:{mapY}%;--crew-facing:{facing:0.##}deg;");
    }

    private string RobotStyle(StationRobot robot)
    {
        var room = Session.State.Facility.Rooms[robot.CurrentRoomId];
        var mapX = room.MapX
            + (((robot.PositionX - 50) / 100) * room.MapWidth);
        var mapY = room.MapY
            + (((robot.PositionY - 50) / 100) * room.MapHeight);
        var facing = RobotFacingAngle(robot);

        return FormattableString.Invariant(
            $"left:{mapX}%;top:{mapY}%;--robot-facing:{facing:0.##}deg;");
    }

    private static double RobotFacingAngle(StationRobot robot)
    {
        if (robot.Movement is not { } movement)
            return 0;

        var dx = movement.ExitX - robot.PositionX;
        var dy = movement.ExitY - robot.PositionY;

        if (Math.Abs(dx) < .01 && Math.Abs(dy) < .01)
        {
            dx = movement.EntryX - movement.ExitX;
            dy = movement.EntryY - movement.ExitY;
        }

        return (Math.Atan2(dy, dx) * 180 / Math.PI) + 90;
    }

    private string TurretStyle(SecurityTurret turret)
    {
        var room = Session.State.Facility.Rooms[turret.RoomId];
        var mapX = room.MapX
            + (((turret.PositionX - 50) / 100) * room.MapWidth);
        var mapY = room.MapY
            + (((turret.PositionY - 50) / 100) * room.MapHeight);
        var facing = 0d;

        if (turret.TrackedNpcId is { } targetId
            && Session.State.Crew.FirstOrDefault(npc => npc.Id == targetId) is { } target
            && target.CurrentRoomId.Equals(turret.RoomId, StringComparison.OrdinalIgnoreCase))
        {
            var dx = target.PositionX - turret.PositionX;
            var dy = target.PositionY - turret.PositionY;
            facing = (Math.Atan2(dy, dx) * 180 / Math.PI) + 90;
        }

        return FormattableString.Invariant(
            $"left:{mapX}%;top:{mapY}%;--turret-facing:{facing:0.##}deg;");
    }

    private string DoorStyle(Door door)
    {
        var a = Session.State.Facility.Rooms[door.RoomAId];
        var b = Session.State.Facility.Rooms[door.RoomBId];
        var portal = StationGeometry.FindSharedPortal(a, b);

        return FormattableString.Invariant(
            $"left:{portal.X}%;top:{portal.Y}%;");
    }

    private string DoorClass(Door door)
    {
        var a = Session.State.Facility.Rooms[door.RoomAId];
        var b = Session.State.Facility.Rooms[door.RoomBId];
        var portal = StationGeometry.FindSharedPortal(a, b);
        var orientation = portal.Wall == StationWall.Vertical
            ? "door-vertical"
            : "door-horizontal";
        var state = door.IsLocked ? "locked" : door.IsOpen ? "open" : "closed";

        var physical = door.IsWelded ? "welded"
            : door.IsBarricaded ? "barricaded"
            : door.IsDamaged ? "damaged"
            : door.IsTechnicallyBypassed ? "bypassed"
            : "intact";

        var selected = SelectedDoor?.Id.Equals(door.Id, StringComparison.OrdinalIgnoreCase) == true
            ? " selected"
            : "";
        return $"map-door {orientation} {state} {physical}{selected}";
    }

    private string DoorTitle(Door door)
    {
        var a = Session.State.Facility.Rooms[door.RoomAId];
        var b = Session.State.Facility.Rooms[door.RoomBId];
        var state = door.IsLocked ? "locked" : door.IsOpen ? "open" : "closed";
        var physical = door.IsWelded ? "welded shut"
            : door.IsBarricaded ? "barricaded"
            : door.IsDamaged ? $"damaged ({door.StructuralIntegrityPercent}% integrity)"
            : door.IsTechnicallyBypassed ? "technical bypass active"
            : "intact";
        return $"{a.Name} ↔ {b.Name}: {state}, {physical}. Click to inspect.";
    }

    private IEnumerable<Door> ConnectedDoors(Room room) =>
        Session.State.Facility.Doors.Where(door =>
            door.RoomAId == room.Id || door.RoomBId == room.Id);

    private Room OtherRoom(Door door, string roomId) =>
        Session.State.Facility.Rooms[
            door.RoomAId == roomId ? door.RoomBId : door.RoomAId];

    private static bool IsConnectorHallway(Room room) =>
        room.Type == RoomType.Corridor
        && room.Id.StartsWith("hall-", StringComparison.OrdinalIgnoreCase);

    private bool IsVerticalHallway(Room hallway)
    {
        var door = ConnectedDoors(hallway).FirstOrDefault();

        if (door is null)
        {
            return hallway.MapHeight >= hallway.MapWidth;
        }

        var neighbour = OtherRoom(door, hallway.Id);
        var portal = StationGeometry.FindSharedPortal(hallway, neighbour);

        // A vertical passage terminates on a horizontal wall; a horizontal
        // passage terminates on a vertical wall. This remains correct even
        // when a very short connector is wider than it is long.
        return portal.Wall == StationWall.Horizontal;
    }


    private NpcBubble? ActiveBubble(Npc npc) =>
        npc.Bubble is { } bubble
        && bubble.CreatedAt <= Session.State.Elapsed
        && bubble.ExpiresAt > Session.State.Elapsed
            ? bubble
            : null;

    private static string BubbleClass(NpcBubble bubble) =>
        $"npc-bubble bubble-{bubble.Kind.ToString().ToLowerInvariant()}";

    private string VisibleOccupantLabel(Room room)
    {
        if (!room.HasVisualFeed)
            return "UNKNOWN";

        return Session.State.Crew.Count(npc =>
            npc.IsPresent && npc.CurrentRoomId == room.Id).ToString();
    }

    public async ValueTask DisposeAsync()
    {
        var task = _clockTask;
        StopClock();

        if (task is not null)
        {
            try
            {
                await task;
            }
            catch (OperationCanceledException)
            {
            }
        }
    }
}
